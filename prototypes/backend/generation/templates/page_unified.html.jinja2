<script>
(function() {
  var accentHex = '{{ tokens.get("accent.hex", "#0000a4") }}';
  var grid = document.querySelector('main > .grid');
  if (!grid) return;
  var secs = Array.from(grid.children);
  var byPos = { header: [], hero: [], main: [], sidebar: [], footer: [] };
  secs.forEach(function(el) {
    var pos = el.getAttribute('data-position') || 'main';
    if (byPos[pos]) byPos[pos].push(el); else byPos.main.push(el);
  });
  var hasNonMain = byPos.header.length || byPos.hero.length || byPos.sidebar.length || byPos.footer.length;
  if (!hasNonMain) return;

  var gap = 'gap-4';
  var wrap = document.createElement('div');
  wrap.className = 'flex flex-col gap-6';

  if (byPos.header.length) {
    var headerEl = document.createElement('div');
    headerEl.className = 'grid grid-cols-12 gap-4 pb-4 border-b border-gray-200';
    byPos.header.forEach(function(el) { headerEl.appendChild(el); });
    wrap.appendChild(headerEl);
  }

  if (byPos.hero.length) {
    var heroEl = document.createElement('div');
    heroEl.className = 'rounded-2xl overflow-hidden grid grid-cols-12 gap-4';
    heroEl.style.cssText = 'background:linear-gradient(135deg,#fffbe6 0%,#fff9c4 50%,#fef3c7 100%);padding:40px 48px;';
    byPos.hero.forEach(function(el) { heroEl.appendChild(el); });
    wrap.appendChild(heroEl);
  }

  var hasSidebar = byPos.sidebar.length > 0;
  var contentRow = document.createElement('div');
  contentRow.className = hasSidebar ? 'flex gap-6 items-start' : '';
  var mainGrid = document.createElement('div');
  mainGrid.className = (hasSidebar ? 'flex-1 min-w-0 ' : '') + 'grid grid-cols-12 gap-4';
  byPos.main.forEach(function(el) { mainGrid.appendChild(el); });

  if (hasSidebar) {
    // filter-panel goes LEFT (before main); summary-panel / other sidebars go RIGHT
    var leftSidebarItems = [], rightSidebarItems = [];
    byPos.sidebar.forEach(function(el) {
      var lay = el.getAttribute('data-layout') || '';
      if (lay === 'filter-panel') leftSidebarItems.push(el);
      else rightSidebarItems.push(el);
    });

    if (leftSidebarItems.length) {
      var leftEl = document.createElement('aside');
      leftEl.className = 'w-64 flex-shrink-0 flex flex-col gap-4';
      leftSidebarItems.forEach(function(el) { el.className = 'w-full'; leftEl.appendChild(el); });
      contentRow.appendChild(leftEl);
    }
    contentRow.appendChild(mainGrid);
    if (rightSidebarItems.length) {
      var rightEl = document.createElement('aside');
      rightEl.className = 'w-72 flex-shrink-0 flex flex-col gap-4';
      rightSidebarItems.forEach(function(el) { el.className = 'w-full'; rightEl.appendChild(el); });
      contentRow.appendChild(rightEl);
    }
  } else {
    contentRow.appendChild(mainGrid);
  }
  wrap.appendChild(contentRow);

  if (byPos.footer.length) {
    var footerEl = document.createElement('div');
    footerEl.className = 'mt-8 rounded-xl overflow-hidden';
    var footerInner = document.createElement('div');
    footerInner.className = 'grid grid-cols-12 gap-4 px-8 py-6 bg-white border-t-4';
    footerInner.style.borderColor = accentHex;
    byPos.footer.forEach(function(el) { footerInner.appendChild(el); });
    footerEl.appendChild(footerInner);
    wrap.appendChild(footerEl);
  }

  grid.parentNode.replaceChild(wrap, grid);
})();
</script>
<script>
(function() {
  var style = document.createElement('style');
  style.textContent = '[data-section-id]{cursor:pointer;transition:outline 0.15s}[data-section-id]:hover{outline:2px dashed #93c5fd;outline-offset:6px}[data-section-id].si-selected{outline:2px solid #3b82f6;outline-offset:6px}';
  document.head.appendChild(style);
  document.addEventListener('click', function(e) {
    var el = e.target.closest && e.target.closest('[data-section-id]');
    if (!el) return;
    e.preventDefault();
    e.stopPropagation();
    document.querySelectorAll('[data-section-id]').forEach(function(x){x.classList.remove('si-selected')});
    el.classList.add('si-selected');
    window.parent.postMessage({type:'section-selected',id:el.dataset.sectionId,name:el.dataset.sectionName},'*');
  }, true);
})();
</script>
