{% if preview_mode -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>{{ page.display_name }} — Preview</title>
</head>
<body class="{{ tokens.get('page.body.bg', 'bg-gray-100') }} min-h-screen font-sans {{ tokens.get('page.body.text', 'text-gray-800') }}">
<header class="{{ tokens.get('region.header.bg', 'bg-white') }} border-b border-gray-200 px-8 {{ tokens.get('page.header.height', 'py-4') }} shadow-sm">
  <div class="flex items-center gap-3">
    <h1 class="text-xl font-bold {{ tokens.get('page.body.text', 'text-gray-800') }}">{{ page.display_name }}</h1>
    {%- if page.type == 'activity' and page.activity_name %}
    <span class="text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-medium">Activity: {{ page.activity_name }}</span>
    {%- endif %}
  </div>
</header>
<main class="px-8 py-6 {{ tokens.get('page.container.max_width', 'max-w-6xl') }} mx-auto">
{%- else -%}
{% raw %}{%{% endraw %} extends "{{ application_name }}_base.html" {% raw %}%}{% endraw %}
{% raw %}{% block content %}{% endraw %}
{%- endif %}

{# ── Global lookup maps (defined once, used per section) ── #}
{% set _cm = {
  "blue":   {"btn":"bg-blue-600 hover:bg-blue-700","light":"bg-blue-50","text":"text-blue-600","border":"border-blue-200","label":"text-blue-700","ring":"focus:ring-blue-500","th":"bg-blue-600 text-white"},
  "green":  {"btn":"bg-green-600 hover:bg-green-700","light":"bg-green-50","text":"text-green-600","border":"border-green-200","label":"text-green-700","ring":"focus:ring-green-500","th":"bg-green-600 text-white"},
  "purple": {"btn":"bg-purple-600 hover:bg-purple-700","light":"bg-purple-50","text":"text-purple-600","border":"border-purple-200","label":"text-purple-700","ring":"focus:ring-purple-500","th":"bg-purple-600 text-white"},
  "orange": {"btn":"bg-orange-500 hover:bg-orange-600","light":"bg-orange-50","text":"text-orange-500","border":"border-orange-200","label":"text-orange-700","ring":"focus:ring-orange-400","th":"bg-orange-500 text-white"},
  "rose":   {"btn":"bg-rose-600 hover:bg-rose-700","light":"bg-rose-50","text":"text-rose-600","border":"border-rose-200","label":"text-rose-700","ring":"focus:ring-rose-500","th":"bg-rose-600 text-white"},
  "slate":  {"btn":"bg-slate-700 hover:bg-slate-800","light":"bg-slate-50","text":"text-slate-600","border":"border-slate-200","label":"text-slate-700","ring":"focus:ring-slate-500","th":"bg-slate-700 text-white"},
} %}
{% set _rm = {"none":"rounded-none","sm":"rounded-sm","md":"rounded-md","lg":"rounded-lg","xl":"rounded-xl","2xl":"rounded-2xl"} %}
{% set _dm = {
  "compact":  {"gap":"gap-2","p":"p-3","p_sm":"p-2","text":"text-xs","sec":"mb-8"},
  "normal":   {"gap":"gap-4","p":"p-4","p_sm":"p-3","text":"text-sm","sec":"mb-12"},
  "spacious": {"gap":"gap-6","p":"p-6","p_sm":"p-4","text":"text-base","sec":"mb-16"},
} %}
{% set _csm  = {"flat":"border border-gray-100","elevated":"shadow-md","outlined":"border-2 border-gray-200"} %}
{% set _shm  = {"none":"","sm":"shadow-sm","md":"shadow-md","lg":"shadow-lg","xl":"shadow-xl"} %}
{% set _bom  = {"none":"","light":"border border-gray-200","strong":"border-2 border-gray-400"} %}
{% set _bgm  = {"white":"bg-white","gray":"bg-gray-50","dark":"bg-gray-800"} %}
{% set _hdsm = {"default":"text-xl font-semibold text-gray-800","large":"text-2xl font-bold text-gray-900","small":"text-xs font-medium text-gray-500 uppercase tracking-widest"} %}
{% set _colm = {"1":"grid-cols-1","2":"grid-cols-1 sm:grid-cols-2","3":"grid-cols-1 sm:grid-cols-2 lg:grid-cols-3","4":"grid-cols-2 lg:grid-cols-4"} %}
{% set _im = {"sm":"w-1/3","md":"w-2/5","lg":"w-1/2"} %}
{% set _pm = {
  "vertical": "flex flex-col",
  "horizontal": "flex flex-row flex-wrap items-start",
  "vertical-reverse": "flex flex-col-reverse",
  "horizontal-reverse": "flex flex-row-reverse flex-wrap items-start",
} %}
{%- set _mock_rows = 3 %}
{%- set _mock_opacities = ["1", "0.8", "0.6"] %}

{% if page.type == 'activity' and not preview_mode %}
<h2 class="text-2xl font-bold mb-6 text-gray-800">{{ page.activity_name }}</h2>
{% endif %}

<div class="grid grid-cols-12 {{ _dm.get(page.gap, _dm['normal']).gap }}">
{%- for section_component in page.section_components %}
{# ── Resolve per-section style ── #}
{% set _s   = section_component.style %}
{% set c    = _cm.get(_s.get("color","blue"), _cm["blue"]) %}
{% set r    = _rm.get(_s.get("radius","xl"), "rounded-xl") %}
{% set d    = _dm.get(_s.get("density","normal"), _dm["normal"]) %}
{% set col  = _colm.get(_s.get("columns","3")|string, "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3") %}
{% set lay  = section_component.layout %}
{% set _bg_key  = _s.get("bg","white") %}
{% set _sec_bg  = c.light if _bg_key == "light" else _bgm.get(_bg_key,"bg-white") %}
{% set _sec_sh  = _shm.get(_s.get("shadow","none"),"") %}
{% set _bor_key = _s.get("border","none") %}
{% set _sec_bor = ("border-2 " ~ c.border) if _bor_key == "colored" else _bom.get(_bor_key,"") %}
{% set _hs_key  = _s.get("header_style","default") %}
{% set _hs_hide = _hs_key == "hidden" %}
{% set _hs      = _hdsm.get(_hs_key, ("text-xl font-bold " ~ c.text)) %}
{% set cs       = (_sec_bg ~ " " ~ _csm.get(_s.get("card_style","elevated"),"shadow-md") ~ " " ~ _sec_sh ~ " " ~ _sec_bor)|trim %}
{% set has_attrs = section_component.attributes|length > 0 %}
{% set has_methods = section_component.custom_methods|length > 0 %}
{% set eff_lay = "action_panel" if (not has_attrs and has_methods) else lay %}
{% set list_var_name = 'related_' + section_component.name + '_list' if section_component.related_to_section_id else section_component.primary_model + '_list' %}
{% set query_limit = section_component.query.get("limit") %}
{% set _base_mock = 3 %}
{% set section_mock_rows = query_limit if query_limit else _base_mock %}

{% set _spanm = {3: "col-span-12 sm:col-span-6 lg:col-span-3", 4: "col-span-12 sm:col-span-6 lg:col-span-4", 6: "col-span-12 sm:col-span-6", 12: "col-span-12"} %}

<div class="{{ _spanm.get(section_component.col_span, 'col-span-12') }}" data-section-id="{{ section_component.id }}" data-section-name="{{ section_component.display_name }}" data-position="{{ section_component.position or 'main' }}">

  {% if page.type != 'activity' and not _hs_hide %}
  <div class="flex items-center justify-between mb-3">
    <h2 class="{{ _hs }}">{{ section_component.display_name }}</h2>
  </div>
  {% endif %}

  {% if section_component.text %}
  <p class="text-gray-500 {{ d.text }} mb-4">{{ section_component.text }}</p>
  {% endif %}

{# ════════════════════════ PREVIEW MODE ════════════════════════ #}
{% if preview_mode %}

{# ════ PREVIEW: ACTION PANEL ════ #}
{% if eff_lay == "action_panel" %}
{% if section_component.custom_methods|length == 1 %}
  <form action="{% raw %}{%{% endraw %} url '{{ application_name }}:render_{{ application_name }}_{{ page }}' {% if page.type == 'activity' %}active_process_node_id{% endif %}{% raw %}%}{% endraw %}" method="get">
    {% if section_component.primary_model -%}
    <input type="hidden" name="instance_id_{{ section_component.primary_model }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
    <input type="hidden" name="custom_{{ section_component.primary_model }}_{{ section_component.custom_methods[0].call_name }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
    {% endif -%}
    {% for parameter in section_component.custom_methods[0].parameters %}
    <label class="block {{ d.text }} font-medium {{ c.label }} mb-1">{{ parameter.name }}</label>
    <input type="{% if parameter.type == 'int' %}number{% else %}text{% endif %}" name="{{ parameter.name }}" value="1" min="1" class="{{ c.border }} border bg-white {{ r }} px-3 py-2 text-sm {{ c.ring }} focus:outline-none focus:ring-2 mb-3">
    {% endfor %}
    <button type="submit" class="w-full {{ c.btn }} text-white {{ d.text }} font-semibold py-3 px-6 {{ r }} transition-opacity">
      {{ section_component.custom_methods[0] }}
    </button>
  </form>
{% else %}
  <div class="flex flex-wrap gap-2">
    {% for method in section_component.custom_methods %}
    <form action="{% raw %}{%{% endraw %} url '{{ application_name }}:render_{{ application_name }}_{{ page }}' {% if page.type == 'activity' %}active_process_node_id{% endif %}{% raw %}%}{% endraw %}" method="get">
      {% if section_component.primary_model -%}
      <input type="hidden" name="instance_id_{{ section_component.primary_model }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
      <input type="hidden" name="custom_{{ section_component.primary_model }}_{{ method.call_name }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
      {% endif -%}
      {% for parameter in method.parameters %}
      <label class="block {{ d.text }} font-medium {{ c.label }} mb-1">{{ parameter.name }}</label>
      <input type="{% if parameter.type == 'int' %}number{% else %}text{% endif %}" name="{{ parameter.name }}" value="1" min="1" class="{{ c.border }} border bg-white {{ r }} px-3 py-2 text-sm {{ c.ring }} focus:outline-none focus:ring-2 mb-3">
      {% endfor %}
      <button type="submit" class="{{ c.btn }} text-white {{ d.text }} font-medium py-2 px-4 {{ r }}">
        {{ method }}
      </button>
    </form>
    {% endfor %}
  </div>
{% endif %}

{# ════ PREVIEW: DETAIL ════ #}
{%- elif eff_lay == "detail" %}
{%- set img_pos = _s.get("image_position", "top") %}
{%- set img_w = _im.get(_s.get("image_size", "md"), "w-2/5") %}
  <div class="flex flex-col {{ d.gap }}">
    {%- for _mock_row in range(1) %}
    {%- if img_pos in ["left", "right"] %}
    <div class="{{ cs }} {{ r }} {{ d.p }} border border-gray-100 flex {{ 'flex-row' if img_pos == 'left' else 'flex-row-reverse' }} gap-6 items-start">
      {%- if section_component.attributes | selectattr('type', 'equalto', AttributeType.IMAGE) | list %}
      <div class="{{ img_w }} flex-shrink-0">
        <img src="https://images.unsplash.com/photo-1502685104226-ee32379fefbe?w=600&h=400&fit=crop" alt="Mock image" class="w-full h-56 object-cover {{ r }}" />
      </div>
      {%- endif %}
      <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 {{ d.gap }}">
        {%- for attribute in section_component.attributes %}
        {%- if attribute.type != AttributeType.IMAGE %}
        <div class="flex flex-col gap-1">
          <span class="text-xs font-medium text-gray-400 uppercase tracking-wide">{{ attribute }}</span>
          {%- if attribute.type == AttributeType.BOOLEAN %}<input type="checkbox" {% if _mock_row == 0 %}checked{% endif %} disabled class="h-4 w-4 rounded">
          {%- elif attribute.type == AttributeType.ENUM %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute.enum_literals[0] if attribute.enum_literals else "Option A" }}</span>
          {%- elif attribute.type == AttributeType.INTEGER %}<span class="{{ d.text }} font-medium text-gray-700">{{ _mock_row * 7 + 12 }}</span>
          {%- else %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute }} {{ _mock_row + 1 }}</span>
          {%- endif %}
        </div>
        {%- endif %}
        {%- endfor %}
        <div class="sm:col-span-2 flex gap-2 pt-3 border-t border-gray-100">
          {%- if section_component.has_update_operation %}<button class="{{ d.text }} {{ c.text }} py-1 px-3 {{ r }} hover:{{ c.light }} border {{ c.border }} transition-colors">Edit</button>{%- endif %}
          {%- if section_component.has_delete_operation %}<button class="{{ d.text }} text-red-500 py-1 px-3 {{ r }} hover:bg-red-50 border border-red-200 transition-colors">Delete</button>{%- endif %}
        </div>
      </div>
    </div>
    {%- else %}
    <div class="{{ cs }} {{ r }} {{ d.p }} border border-gray-100">
      <div class="grid grid-cols-1 sm:grid-cols-2 {{ d.gap }}">
        {%- for attribute in section_component.attributes %}
        <div class="flex flex-col gap-1{% if attribute.type == AttributeType.IMAGE %} sm:col-span-2{% endif %}">
          <span class="text-xs font-medium text-gray-400 uppercase tracking-wide">{{ attribute }}</span>
          {%- if attribute.type == AttributeType.BOOLEAN %}<input type="checkbox" {% if _mock_row == 0 %}checked{% endif %} disabled class="h-4 w-4 rounded">
          {%- elif attribute.type == AttributeType.ENUM %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute.enum_literals[0] if attribute.enum_literals else "Option A" }}</span>
          {%- elif attribute.type == AttributeType.INTEGER %}<span class="{{ d.text }} font-medium text-gray-700">{{ _mock_row * 7 + 12 }}</span>
          {%- elif attribute.type == AttributeType.IMAGE %}<img src="https://images.unsplash.com/photo-1502685104226-ee32379fefbe?w=600&h=400&fit=crop" alt="Mock image" class="w-full max-h-64 object-contain rounded mt-1" />
          {%- else %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute }} {{ _mock_row + 1 }}</span>
          {%- endif %}
        </div>
        {%- endfor %}
      </div>
      <div class="flex gap-2 mt-4 pt-3 border-t border-gray-100">
        {%- if section_component.has_update_operation %}<button class="{{ d.text }} {{ c.text }} py-1 px-3 {{ r }} hover:{{ c.light }} border {{ c.border }} transition-colors">Edit</button>{%- endif %}
        {%- if section_component.has_delete_operation %}<button class="{{ d.text }} text-red-500 py-1 px-3 {{ r }} hover:bg-red-50 border border-red-200 transition-colors">Delete</button>{%- endif %}
      </div>
    </div>
    {%- endif %}
    {%- endfor %}
  </div>

{# ════ PREVIEW: CARD ════ #}
{%- elif eff_lay == "card" %}
  <div class="grid {{ col }} {{ d.gap }}">
    {%- for _mock_row in range(section_mock_rows) %}
    <div class="{{ cs }} {{ r }} {{ d.p }} flex flex-col gap-3" style="opacity: {{ _mock_opacities[_mock_row] if _mock_row < 3 else '0.4' }}">
      {%- for attribute in section_component.attributes %}
      <div class="flex flex-col gap-0.5">
        <span class="text-xs font-medium text-gray-400 uppercase tracking-wide">{{ attribute }}</span>
        {%- if attribute.type == AttributeType.BOOLEAN %}<input type="checkbox" {% if _mock_row == 0 %}checked{% endif %} disabled class="h-4 w-4 rounded mt-0.5">
        {%- elif attribute.type == AttributeType.ENUM %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute.enum_literals[0] if attribute.enum_literals else "Option A" }}</span>
        {%- elif attribute.type == AttributeType.INTEGER %}<span class="{{ d.text }} font-medium text-gray-700">{{ _mock_row * 7 + 12 }}</span>
        {%- elif attribute.type == AttributeType.IMAGE %}<img src="https://images.unsplash.com/photo-1502685104226-ee32379fefbe?w=400&h=300&fit=crop" alt="Mock" class="w-full max-h-48 object-contain rounded mt-1">
        {%- else %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute }} {{ _mock_row + 1 }}</span>
        {%- endif %}
      </div>
      {%- endfor %}
      <div class="flex gap-2 mt-auto pt-3 border-t border-gray-100">
        {%- if section_component.view_detail_page %}<a href="#" class="{{ d.text }} font-medium {{ c.text }} py-1.5 px-3 {{ r }} hover:{{ c.light }} transition-colors">View</a>{%- endif %}
        {%- if section_component.has_update_operation %}<button class="{{ d.text }} font-medium {{ c.text }} py-1.5 px-3 {{ r }} hover:{{ c.light }} transition-colors">Edit</button>{%- endif %}
        {%- if section_component.has_delete_operation %}<button class="{{ d.text }} font-medium text-red-500 py-1.5 px-3 {{ r }} hover:bg-red-50 transition-colors">Delete</button>{%- endif %}
      </div>
    </div>
    {%- endfor %}
  </div>

{# ════ PREVIEW: LIST ════ #}
{%- elif eff_lay == "list" %}
  <div class="flex flex-col {{ d.gap }}">
    {%- for _mock_row in range(section_mock_rows) %}
    <div class="{{ cs }} {{ r }} {{ d.p }} flex items-center justify-between gap-4" style="opacity: {{ _mock_opacities[_mock_row] if _mock_row < 3 else '0.4' }}">
      <div class="flex flex-1 flex-wrap gap-x-6 gap-y-1">
        {%- for attribute in section_component.attributes %}
        <div class="flex flex-col gap-0.5">
          <span class="text-xs text-gray-400 uppercase tracking-wide">{{ attribute }}</span>
          {%- if attribute.type == AttributeType.BOOLEAN %}<input type="checkbox" {% if _mock_row == 0 %}checked{% endif %} disabled class="h-4 w-4 rounded mt-0.5">
          {%- elif attribute.type == AttributeType.ENUM %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute.enum_literals[0] if attribute.enum_literals else "Option A" }}</span>
          {%- elif attribute.type == AttributeType.INTEGER %}<span class="{{ d.text }} font-medium text-gray-700">{{ _mock_row * 7 + 12 }}</span>
          {%- elif attribute.type == AttributeType.IMAGE %}<img src="https://images.unsplash.com/photo-1502685104226-ee32379fefbe?w=100&h=100&fit=crop" alt="Mock" class="w-10 h-10 object-cover rounded mt-0.5">
          {%- else %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute }} {{ _mock_row + 1 }}</span>
          {%- endif %}
        </div>
        {%- endfor %}
      </div>
      <div class="flex gap-2 shrink-0">
        {%- if section_component.view_detail_page %}<a href="#" class="{{ d.text }} {{ c.text }} py-1 px-3 {{ r }} hover:{{ c.light }} border {{ c.border }} transition-colors">View</a>{%- endif %}
        {%- if section_component.has_update_operation %}<button class="{{ d.text }} {{ c.text }} py-1 px-3 {{ r }} hover:{{ c.light }} border {{ c.border }} transition-colors">Edit</button>{%- endif %}
        {%- if section_component.has_delete_operation %}<button class="{{ d.text }} text-red-500 py-1 px-3 {{ r }} hover:bg-red-50 border border-red-200 transition-colors">Delete</button>{%- endif %}
      </div>
    </div>
    {%- endfor %}
  </div>

{# ════ PREVIEW: TABLE ════ #}
{%- elif eff_lay == "table" %}
  <div class="overflow-x-auto {{ r }} border border-gray-200">
    <table class="min-w-full text-left">
      <thead>
        <tr>
          {% for attribute in section_component.attributes %}
          <th class="{{ c.th }} {{ d.text }} font-semibold px-4 py-3 uppercase tracking-wider">{{ attribute }}</th>
          {% endfor %}
          {% for parent_model in section_component.parent_models %}
          <th class="{{ c.th }} {{ d.text }} font-semibold px-4 py-3 uppercase tracking-wider">{{ parent_model }}</th>
          {% endfor %}
          {% if section_component.has_update_operation or section_component.has_delete_operation or section_component.view_detail_page %}
          <th class="{{ c.th }} {{ d.text }} font-semibold px-4 py-3"></th>
          {% endif %}
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        {%- for _mock_row in range(section_mock_rows) %}
        <tr class="hover:bg-gray-50 transition-colors" style="opacity: {{ _mock_opacities[_mock_row] if _mock_row < 3 else '0.4' }}">
          {%- for attribute in section_component.attributes %}
          <td class="px-4 py-3 {{ d.text }} text-gray-700">
            {%- if attribute.type == AttributeType.BOOLEAN %}<input type="checkbox" {% if _mock_row == 0 %}checked{% endif %} disabled class="h-4 w-4 rounded">
            {%- elif attribute.type == AttributeType.ENUM %}{{ attribute.enum_literals[0] if attribute.enum_literals else "Option A" }}
            {%- elif attribute.type == AttributeType.INTEGER %}{{ _mock_row * 7 + 12 }}
            {%- elif attribute.type == AttributeType.IMAGE %}<img src="https://images.unsplash.com/photo-1502685104226-ee32379fefbe?w=100&h=100&fit=crop" alt="Mock" class="w-8 h-8 object-cover rounded">
            {%- else %}{{ attribute }} {{ _mock_row + 1 }}
            {%- endif %}
          </td>
          {%- endfor %}
          {%- for parent_model in section_component.parent_models %}
          <td class="px-4 py-3 {{ d.text }} text-gray-500 italic">{{ parent_model }} ref</td>
          {%- endfor %}
          {% if section_component.has_update_operation or section_component.has_delete_operation or section_component.view_detail_page %}
          <td class="px-4 py-3">
            <div class="flex gap-2">
              {%- if section_component.view_detail_page %}<button class="{{ d.text }} {{ c.text }} py-1 px-3 rounded hover:{{ c.light }} border {{ c.border }} transition-colors">View</button>{%- endif %}
              {%- if section_component.has_update_operation %}<button class="{{ d.text }} {{ c.text }} py-1 px-3 rounded hover:{{ c.light }} border {{ c.border }} transition-colors">Edit</button>{%- endif %}
              {%- if section_component.has_delete_operation %}<button class="{{ d.text }} text-red-500 py-1 px-3 rounded hover:bg-red-50 border border-red-200 transition-colors">Delete</button>{%- endif %}
            </div>
          </td>
          {% endif %}
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </div>

{# ════ PREVIEW: GALLERY ════ #}
{%- elif eff_lay == "gallery" %}
{%- set img_attrs = section_component.attributes | selectattr('type', 'equalto', AttributeType.IMAGE) | list %}
{%- set text_attrs = section_component.attributes | rejectattr('type', 'equalto', AttributeType.IMAGE) | list %}
  <div class="grid {{ col }} {{ d.gap }}">
    {%- for _mock_row in range(section_mock_rows) %}
    <div class="{{ cs }} {{ r }} overflow-hidden group relative" style="opacity: {{ _mock_opacities[_mock_row] if _mock_row < 3 else '0.4' }}">
      <div class="aspect-square overflow-hidden">
        <img src="https://images.unsplash.com/photo-1502685104226-ee32379fefbe?w=400&h=400&fit=crop&sig={{ _mock_row }}" alt="Mock" class="w-full h-full object-cover transition-transform group-hover:scale-105" />
      </div>
      {%- if text_attrs %}
      <div class="{{ d.p_sm }} flex flex-col gap-0.5">
        {%- for attribute in text_attrs %}
        <span class="{{ d.text }} {% if loop.first %}font-medium text-gray-800{% else %}text-gray-400 text-xs{% endif %}">{{ attribute }} {{ _mock_row + 1 }}</span>
        {%- endfor %}
      </div>
      {%- endif %}
      <div class="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
        {%- if section_component.view_detail_page %}<a href="#" class="bg-white/90 {{ d.text }} {{ c.text }} py-1 px-2 {{ r }} border {{ c.border }} text-xs">View</a>{%- endif %}
        {%- if section_component.has_delete_operation %}<button class="bg-white/90 {{ d.text }} text-red-500 py-1 px-2 {{ r }} hover:bg-red-50 border border-red-200 text-xs">Delete</button>{%- endif %}
      </div>
    </div>
    {%- endfor %}
  </div>

{%- else %}
  <div class="{{ cs }} {{ r }} {{ d.p }} border border-dashed border-gray-300 text-gray-500 {{ d.text }}">
    Unsupported section layout: {{ lay }}
  </div>
{%- endif %}

  {%- if section_component.has_create_operation and eff_lay != "action_panel" %}
