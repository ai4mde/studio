      <button type="submit" class="w-full py-2.5 rounded-lg text-white font-semibold text-sm" style="background-color:{{ _accent_hex }};">
        {{ _s.get('cta_label') or ('Add ' + section_component.display_name if section_component.has_create_operation else ('Save ' + section_component.display_name if section_component.has_update_operation else 'Submit')) }}
