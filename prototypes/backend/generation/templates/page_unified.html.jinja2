{% if page.type == 'activity' and not preview_mode %}
<h2 class="text-2xl font-bold mb-6 text-gray-800">{{ page.activity_name if page.activity_name else _page_title }}</h2>
{% endif %}
{% if page.is_task_page is defined and page.is_task_page %}
<div class="mb-6">
  {% if preview_mode %}
  <p class="text-sm text-gray-700">Welcome, <strong>jan_devries</strong></p>
  {% else %}
  <p class="text-sm text-gray-700">Welcome, <strong>{% raw %}{{ user }}{% endraw %}</strong></p>
  {% endif %}
  <p class="text-sm text-gray-600">Use the navigation menu on the left to navigate through this application.</p>
</div>
{% endif %}

<div id="page-sections-grid" class="grid grid-cols-12 {{ _dm.get(page.gap, _dm['normal']).gap }}">
{%- for section_component in page.section_components %}
{%- set _loop_raw_lay = section_component.layout %}
{%- set _loop_lay = "nav-links" if _loop_raw_lay in ["nav", "navigation", "navbar", "side-nav", "top-nav"] else ("link-grid" if _loop_raw_lay == "footer-links" else ("brand-strip" if _loop_raw_lay == "footer-brand" else ("service-bar" if _loop_raw_lay == "service-strip" else _loop_raw_lay))) %}
{%- set _loop_position = section_component.position or 'main' %}
{%- set _loop_is_chrome = _loop_position in ('header', 'footer') or _loop_lay in _header_chrome or _loop_lay in _footer_chrome %}
{%- if false and _loop_is_chrome %}
{# Header/footer chrome is rendered in the chrome regions above/below; never duplicate it in the main grid. #}
{%- elif section_component.component_type == 'activity_action' %}
{%- set _aa_variant = section_component.style.get('variant', 'button') %}
{%- set _aa_align   = section_component.style.get('align', 'right') %}
{%- set _aa_size    = section_component.style.get('size', 'lg') %}
{%- set _aa_py      = 'py-4 px-8 text-base' if _aa_size == 'lg' else ('py-2 px-4 text-sm' if _aa_size == 'sm' else 'py-3 px-6 text-sm') %}
{%- set _aa_justify = 'justify-end' if _aa_align == 'right' else ('justify-center' if _aa_align == 'center' else ('justify-start' if _aa_align == 'left' else '')) %}
{%- set _aa_action = section_component.workflow_action or 'complete' %}
{%- set _aa_target_page = section_component.workflow_target_page %}
{%- set _aa_target_is_activity = namespace(value=false) %}
{%- for _target_page in all_pages %}
  {%- if _aa_target_page and _target_page.name == _aa_target_page and _target_page.type == 'activity' %}
    {%- set _aa_target_is_activity.value = true %}
  {%- endif %}
{%- endfor %}
<div class="{{ _spanm.get(section_component.col_span, 'col-span-12') }}" data-section-id="{{ section_component.id }}" data-section-name="{{ section_component.display_name }}" data-position="{{ section_component.position or 'main' }}" data-layout="activity_action" data-col-span="{{ section_component.col_span or 12 }}"{% if section_component.min_height %} style="min-height: {{ section_component.min_height }}px;"{% endif %}>
{%- if page.type == 'activity' and not preview_mode %}
  {%- if _aa_target_page and _aa_target_is_activity.value %}
    {%- set _aa_target_url = '/' ~ application_name ~ '/render_' ~ application_name ~ '_' ~ _aa_target_page %}
  {%- elif _aa_target_page %}
    {%- set _aa_target_url %}{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ _aa_target_page }}' {% raw %}%}{% endraw %}{%- endset %}
  {%- else %}
    {%- set _aa_target_url = '' %}
  {%- endif %}
  {%- if _aa_action == 'navigate' and _aa_target_url %}
  <div class="flex {{ _aa_justify }} mt-6">
    {%- if _aa_target_is_activity.value %}
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:redirect_to_process_page' active_process_node_id {% raw %}%}{% endraw %}" method="get">
      <input type="hidden" name="target_url" value="{{ _aa_target_url }}">
      <button type="submit" class="si-btn si-btn-primary inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white font-semibold {{ _aa_py }} rounded-xl shadow transition-colors">{{ section_component.label }}</button>
    </form>
    {%- else %}
    <a href="{{ _aa_target_url }}" class="si-btn si-btn-primary inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white font-semibold {{ _aa_py }} rounded-xl shadow transition-colors">{{ section_component.label }}</a>
    {%- endif %}
  </div>
  {%- else %}
  {%- if _aa_variant == 'fab' %}
  <div class="fixed bottom-6 right-6 z-50">
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
      {%- if _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url and _aa_target_is_activity.value %}<input type="hidden" name="next_url" value="{{ _aa_target_url }}">{%- elif _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url %}<input type="hidden" name="next" value="{{ _aa_target_url }}">{%- endif %}
      <button type="submit" class="si-btn si-btn-primary bg-green-600 hover:bg-green-700 text-white font-semibold {{ _aa_py }} rounded-full shadow-lg transition-colors">{{ section_component.label }}</button>
    </form>
  </div>
  {%- elif _aa_variant == 'link' %}
  <div class="flex {{ _aa_justify }} mt-4">
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
      {%- if _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url and _aa_target_is_activity.value %}<input type="hidden" name="next_url" value="{{ _aa_target_url }}">{%- elif _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url %}<input type="hidden" name="next" value="{{ _aa_target_url }}">{%- endif %}
      <button type="submit" class="si-link text-blue-600 hover:underline font-medium {{ _aa_py }}">{{ section_component.label }} 茅藛?/button>
    </form>
  </div>
  {%- elif _aa_variant == 'wizard_next' %}
  <div class="flex items-center justify-between border-t border-gray-200 pt-4 mt-4">
    <a href="javascript:history.back()" class="text-sm text-gray-500 hover:text-gray-700">茅藛?Back</a>
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
      {%- if _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url and _aa_target_is_activity.value %}<input type="hidden" name="next_url" value="{{ _aa_target_url }}">{%- elif _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url %}<input type="hidden" name="next" value="{{ _aa_target_url }}">{%- endif %}
      <button type="submit" class="si-btn si-btn-primary bg-blue-600 hover:bg-blue-700 text-white font-semibold {{ _aa_py }} rounded-xl transition-colors">{{ section_component.label }} 茅藛?/button>
    </form>
  </div>
  {%- elif _aa_variant == 'auto' %}
  <div class="hidden">
    <form id="auto-complete-form" action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
      {%- if _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url and _aa_target_is_activity.value %}<input type="hidden" name="next_url" value="{{ _aa_target_url }}">{%- elif _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url %}<input type="hidden" name="next" value="{{ _aa_target_url }}">{%- endif %}
    </form>
  </div>
  <script>setTimeout(function(){ document.getElementById('auto-complete-form').submit(); }, 1500);</script>
  {%- else %}{# default: button #}
  <div class="flex {{ _aa_justify }} mt-6">
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
      {%- if _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url and _aa_target_is_activity.value %}<input type="hidden" name="next_url" value="{{ _aa_target_url }}">{%- elif _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url %}<input type="hidden" name="next" value="{{ _aa_target_url }}">{%- endif %}
      <button type="submit" class="si-btn si-btn-primary bg-green-600 hover:bg-green-700 text-white font-semibold {{ _aa_py }} rounded-xl shadow transition-colors">{{ section_component.label }}</button>
    </form>
  </div>
  {%- endif %}
  {%- endif %}
{%- else %}{# preview_mode #}
  <div class="flex {{ _aa_justify }} mt-6">
    <button type="button" class="si-btn si-btn-primary bg-green-600 text-white font-semibold {{ _aa_py }} rounded-xl shadow opacity-75 cursor-default">{{ section_component.label }}</button>
  </div>
{%- endif %}
</div>
{%- elif section_component.component_type == 'activity_start' %}
{#-- activity_start: show processes the user can start --#}
{%- set _as_cols = (section_component.style.get('columns', '3') | int) %}
{%- set _as_card = section_component.style.get('card_style', 'elevated') %}
{%- set _as_button_label = section_component.style.get('cta_label') or section_component.label or 'Start' %}
{%- set _as_col_class = 'grid-cols-1' if _as_cols == 1 else ('grid-cols-2' if _as_cols == 2 else ('grid-cols-3' if _as_cols == 3 else 'grid-cols-4')) %}
{%- set _as_card_cls = 'bg-white rounded-xl shadow-md p-5' if _as_card == 'elevated' else ('bg-white rounded-xl border border-gray-200 p-5' if _as_card == 'outlined' else 'bg-gray-50 rounded-xl p-5') %}
<div class="{{ _spanm.get(section_component.col_span, 'col-span-12') }}" data-section-id="{{ section_component.id }}" data-section-name="{{ section_component.display_name }}" data-position="{{ section_component.position or 'main' }}" data-layout="activity_start" data-col-span="{{ section_component.col_span or 12 }}"{% if section_component.min_height %} style="min-height: {{ section_component.min_height }}px;"{% endif %}>
  <h3 class="text-lg font-semibold text-gray-800 mb-4">{{ section_component.label or section_component.display_name }}</h3>
{%- if preview_mode %}
  {%- set _as_pages = all_pages | selectattr('type', 'equalto', 'activity') | list %}
  {%- if _as_pages %}
  {%- set _first_activity = _as_pages[0] %}
  {%- set _process_label = section_component.style.get('process_label') or ((_brand_name | replace('_', ' ') | title) ~ ' Workflow') %}
  <div class="grid {{ _as_col_class }} gap-4">
    <div class="{{ _as_card_cls }}">
      <div class="font-medium text-gray-800 mb-3">{{ _process_label }}</div>
      <button type="button" onclick="window.parent.postMessage({type:'navigate-page',page:'{{ _first_activity.name }}'},'*')" class="si-btn si-btn-primary inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2 px-4 rounded-lg shadow transition-colors">{{ _as_button_label }}</button>
    </div>
  </div>
  {%- else %}
  <p class="text-gray-400 text-sm italic">No activity pages defined.</p>
  {%- endif %}
{%- else %}
  {% raw %}{% if available_processes %}{% endraw %}
  <div class="grid {{ _as_col_class }} gap-4">
    {% raw %}{% for process in available_processes %}{% endraw %}
    <div class="{{ _as_card_cls }}">
      <div class="font-medium text-gray-800 mb-3">{% raw %}{{ process.name }}{% endraw %}</div>
      <form method="post" action="{% raw %}{%{% endraw %} url 'workflow_engine:start_process' process.id {% raw %}%}{% endraw %}">
        {% raw %}{% csrf_token %}{% endraw %}
        <button type="submit" class="si-btn si-btn-primary inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2 px-4 rounded-lg shadow transition-colors">{{ _as_button_label }}</button>
      </form>
    </div>
    {% raw %}{% endfor %}{% endraw %}
  </div>
  {% raw %}{% else %}{% endraw %}
  <p class="text-gray-400 text-sm italic">No processes available.</p>
  {% raw %}{% endif %}{% endraw %}
{%- endif %}
</div>
{%- elif section_component.component_type == 'activity_tasks' %}
{#-- activity_tasks: show active tasks to complete --#}
{%- set _at_cols = (section_component.style.get('columns', '3') | int) %}
{%- set _at_card = section_component.style.get('card_style', 'elevated') %}
{%- set _at_col_class = 'grid-cols-1' if _at_cols == 1 else ('grid-cols-2' if _at_cols == 2 else ('grid-cols-3' if _at_cols == 3 else 'grid-cols-4')) %}
{%- set _at_card_cls = 'bg-white rounded-xl shadow-md p-5' if _at_card == 'elevated' else ('bg-white rounded-xl border border-gray-200 p-5' if _at_card == 'outlined' else 'bg-gray-50 rounded-xl p-5') %}
<div class="{{ _spanm.get(section_component.col_span, 'col-span-12') }}" data-section-id="{{ section_component.id }}" data-section-name="{{ section_component.display_name }}" data-position="{{ section_component.position or 'main' }}" data-layout="activity_tasks" data-col-span="{{ section_component.col_span or 12 }}"{% if section_component.min_height %} style="min-height: {{ section_component.min_height }}px;"{% endif %}>
  <h3 class="text-lg font-semibold text-gray-800 mb-4">{{ section_component.label or section_component.display_name }}</h3>
{%- if preview_mode %}
  {%- set _at_pages = all_pages | selectattr('type', 'equalto', 'activity') | list %}
  {%- if _at_pages %}
  {%- set _first_task = _at_pages[0] %}
  {%- set _process_label = section_component.style.get('process_label') or ((_brand_name | replace('_', ' ') | title) ~ ' Workflow') %}
  <div class="grid {{ _at_col_class }} gap-4">
    <div class="{{ _at_card_cls }}">
      <div class="font-medium text-gray-800">{{ _process_label }}</div>
      <div class="text-sm text-gray-500 mb-3">{{ _first_task.display_name }}</div>
      <button type="button" onclick="window.parent.postMessage({type:'navigate-page',page:'{{ _first_task.name }}'},'*')" class="si-btn si-btn-primary inline-flex items-center justify-center bg-green-600 hover:bg-green-700 text-white text-sm font-semibold py-2 px-4 rounded-lg shadow transition-colors">Go to Task</button>
    </div>
  </div>
  {%- else %}
  <p class="text-gray-400 text-sm italic">No tasks in progress.</p>
  {%- endif %}
{%- else %}
  {% raw %}{% if active_process_nodes %}{% endraw %}
  <div class="grid {{ _at_col_class }} gap-4">
    {% raw %}{% for active_process_node in active_process_nodes %}{% endraw %}
    <div class="{{ _at_card_cls }}">
