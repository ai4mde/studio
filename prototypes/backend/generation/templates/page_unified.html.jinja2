  {%- elif action_type == 'filter' -%}
    <button type="button" data-filter-field="{{ field_name }}" data-filter-value="{{ label }}" class="inline-flex">{{ value_html }}</button>
  {%- elif action_type == 'expand' -%}
    <details class="inline-block"><summary class="cursor-pointer list-none">{{ value_html }}</summary><span class="{{ d.text }} text-gray-500">{{ label }}</span></details>
  {%- else -%}
    {{ value_html }}
  {%- endif -%}
{%- endmacro %}

{%- macro _field_value_bound(attribute, object_name, c, d, r, application_name, page, section_component, allow_link=False) -%}
  {%- set render_as = attribute.render_as if attribute.render_as is defined else ('link' if attribute.is_link else 'text') -%}
  {%- set action = attribute.action if attribute.action is defined else {} -%}
  {%- set action_type = action.get('type', 'none') -%}
  {%- set tooltip = action.get('tooltip', '') if action_type == 'tooltip' else '' -%}
  {%- set raw_target_page = action.get('targetPage') or section_component.item_click_target_page -%}
  {%- set target_page = raw_target_page if raw_target_page and raw_target_page|string in _all_page_names and raw_target_page|string not in _activity_page_names else None -%}
  {%- set operation_name = action.get('operation') or action.get('operationId') or attribute -%}
  {%- set operation_class = action.get('class') or section_component.primary_model -%}
  {%- set field_name = action.get('field') or attribute -%}
  {%- if attribute.readonly is defined and attribute.readonly and '.' in attribute.name -%}
    {%- set _parts = attribute.name.split('.') -%}
    {%- set _related_object = _parts[0]|lower -%}
    {%- set _related_field = _parts[1] -%}
    {%- set row_value -%}{% raw %}{{{% endraw %} {{ object_name }}.{{ _related_object }}.{{ _related_field }}{% raw %}|default:''{% endraw %} {% raw %}}}{% endraw %}{%- endset -%}
  {%- else -%}
  {%- set row_value -%}{% raw %}{{{% endraw %} {{ object_name }}.{{ attribute }} {% raw %}}}{% endraw %}{%- endset -%}
  {%- endif -%}
  {%- set row_id -%}{% raw %}{{{% endraw %} {{ object_name }}.id {% raw %}}}{% endraw %}{%- endset -%}
  {%- set value_html -%}
  {%- if render_as == 'badge' -%}
    <span class="si-badge {{ c.light }} {{ c.text }}" title="{{ tooltip }}">{{ row_value }}</span>
  {%- elif render_as == 'button' -%}
    <span class="inline-flex {{ d.text }} font-medium {{ c.text }} py-1 px-3 {{ r }} border {{ c.border }} hover:{{ c.light }} transition-colors" title="{{ tooltip }}">{{ row_value }}</span>
  {%- elif render_as == 'link' or attribute.is_link -%}
    <span class="{{ d.text }} font-medium {{ c.text }} hover:underline" title="{{ tooltip }}">{{ row_value }}</span>
  {%- else -%}
    <span class="{{ d.text }} font-medium text-gray-800" title="{{ tooltip }}">{{ row_value }}</span>
  {%- endif -%}
  {%- endset -%}
  {%- if action_type == 'navigate' or ((render_as == 'link' or attribute.is_link) and allow_link) -%}
    {%- if target_page %}
    <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ target_page }}' {% raw %}%}{% endraw %}?instance_id_{{ section_component.primary_model }}={{ row_id }}" class="si-field-value inline-flex">{{ value_html }}</a>
    {%- else -%}
    <span class="si-field-value">{{ value_html }}</span>
    {%- endif -%}
  {%- elif action_type == 'operation' -%}
    <form action="{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ page }}' {% if page.type == 'activity' %}active_process_node_id{% endif %}{% raw %}%}{% endraw %}" method="get" class="inline-flex">
      <input type="hidden" name="instance_id_{{ operation_class }}" value="{{ row_id }}">
      <input type="hidden" name="custom_{{ operation_class }}_{{ operation_name }}" value="{{ row_id }}">
      <button type="submit" class="si-field-value inline-flex">{{ value_html }}</button>
    </form>
  {%- elif action_type == 'copy' -%}
    <button type="button" onclick="navigator.clipboard && navigator.clipboard.writeText(this.dataset.copyValue)" data-copy-value="{{ row_value }}" class="si-field-value inline-flex">{{ value_html }}</button>
  {%- elif action_type == 'filter' -%}
    <a href="?{{ field_name }}={{ row_value|urlencode }}" data-filter-field="{{ field_name }}" class="si-field-value inline-flex">{{ value_html }}</a>
  {%- elif action_type == 'expand' -%}
    <details class="si-field-value inline-block"><summary class="cursor-pointer list-none">{{ value_html }}</summary><span class="{{ d.text }} text-gray-500">{{ row_value }}</span></details>
  {%- else -%}
    <span class="si-field-value">{{ value_html }}</span>
  {%- endif -%}
{%- endmacro %}

