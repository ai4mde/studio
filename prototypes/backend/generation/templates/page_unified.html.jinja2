{%- if _component == 'LineItemList' %}{%- set _lstyle = 'cart-item' %}{%- endif %}
{%- if _component == 'RelatedObjectList' %}{%- set _lstyle = 'related' %}{%- endif %}
{%- if _component == 'DataTable' and eff_lay == 'gallery' %}{%- set _glay = 'table' %}{%- endif %}
{%- if _component in ('ObjectForm', 'AddressForm', 'PaymentMethodForm', 'ReviewForm') %}{%- set _glay = 'form' %}{%- endif %}
{# 鈹€鈹€ MOCK DATA 鈹€鈹€ #}
{%- set _mock_old_pl    = ["49,99","119,00","199,00","59,99","319,00"] %}
{%- set _mock_cats      = [] %}

<div class="{{ _spanm.get(section_component.col_span, 'col-span-12') }}" data-section-id="{{ section_component.id }}" data-section-name="{{ section_component.display_name }}" data-position="{{ section_component.position or 'main' }}" data-layout="{{ lay }}" data-col-span="{{ section_component.col_span or 12 }}" data-sidebar-side="{{ _s.get('sidebar_side', _s.get('side', '')) }}" data-sidebar-width="{{ _s.get('sidebar_width', '') }}" data-nav-height="{{ _s.get('nav_height', _s.get('density', 'normal')) }}"{% if section_component.min_height %} style="min-height: {{ section_component.min_height }}px;"{% endif %}>
  {%- set _field_cfgs = _fl.get('field_styles') or {} %}
  {%- if _field_cfgs %}
  <style>
  {%- set _field_width = {'3':'25%', '4':'33.333%', '6':'50%', '8':'66.666%', '12':'100%'} %}
  {%- set _field_text = {'xs':'0.75rem', 'sm':'0.875rem', 'md':'1rem', 'lg':'1.125rem', 'xl':'1.25rem'} %}
  {%- set _field_height = {'sm':'96px', 'md':'160px', 'lg':'240px', 'xl':'320px'} %}
  {%- for fname, fcfg in _field_cfgs.items() %}
  [data-section-id="{{ section_component.id }}"] [data-field-name="{{ fname|e }}"] {
    {%- if fcfg.get('order') is not none %} order: {{ fcfg.get('order') }};{% endif %}
    {%- if fcfg.get('align') in ['left', 'center', 'right'] %} text-align: {{ fcfg.get('align') }};{% endif %}
    {%- if fcfg.get('col_span') %}
      flex-basis: {{ _field_width.get(fcfg.get('col_span')|string, 'auto') }};
      width: {{ _field_width.get(fcfg.get('col_span')|string, 'auto') }};
      {%- if (fcfg.get('col_span')|string) in ['8', '12'] %} grid-column: 1 / -1;{% endif %}
    {%- endif %}
  }
  {%- if fcfg.get('visible') == 'hidden' %}
  [data-section-id="{{ section_component.id }}"] [data-field-name="{{ fname|e }}"] { display: none !important; }
  {%- endif %}
  {%- if fcfg.get('text_size') %}
  [data-section-id="{{ section_component.id }}"] [data-field-name="{{ fname|e }}"],
  [data-section-id="{{ section_component.id }}"] [data-field-name="{{ fname|e }}"] .si-field-value {
    font-size: {{ _field_text.get(fcfg.get('text_size')|string, 'inherit') }} !important;
  }
  [data-section-id="{{ section_component.id }}"] [data-field-name="{{ fname|e }}"] :where(span, a, button, input, select, textarea, label, p, div) {
    font-size: inherit !important;
  }
  {%- endif %}
  {%- if fcfg.get('height') %}
  [data-section-id="{{ section_component.id }}"] [data-field-name="{{ fname|e }}"] .si-field-media,
  [data-section-id="{{ section_component.id }}"] [data-field-name="{{ fname|e }}"] img,
  [data-section-id="{{ section_component.id }}"] [data-field-name="{{ fname|e }}"] video,
  [data-section-id="{{ section_component.id }}"] [data-field-name="{{ fname|e }}"] .si-img,
  [data-section-id="{{ section_component.id }}"] [data-field-name="{{ fname|e }}"] .si-video {
    height: {{ _field_height.get(fcfg.get('height')|string, 'auto') }};
    aspect-ratio: auto;
  }
  {%- endif %}
  {%- if fcfg.get('label') == 'hidden' %}
  [data-section-id="{{ section_component.id }}"] [data-field-name="{{ fname|e }}"] .si-field-label { display: none !important; }
  {%- endif %}
  {%- endfor %}
  </style>
  {%- endif %}

  {% if page.type != 'activity' and not _hs_hide and _glay not in ('form', 'filter') and not _is_chrome_layout %}
  <div class="flex items-center justify-between mb-3">
    <h2 class="{{ _hs }}">{{ section_component.display_name }}</h2>
  </div>
  {% endif %}

  {% if section_component.text and not _is_chrome_layout %}
  <p class="text-gray-500 {{ d.text }} mb-4">{{ section_component.text }}</p>
  {% endif %}

{# 鈹€鈹€ PREVIEW MODE 鈹€鈹€ #}
{% if preview_mode %}

{# 鈹€鈹€ PREVIEW: ACTION PANEL 鈹€鈹€ #}
{% if eff_lay == "action_panel" %}
{% if section_methods|length == 1 %}
  <form action="{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ page }}' {% if page.type == 'activity' %}active_process_node_id{% endif %}{% raw %}%}{% endraw %}" method="get">
    {% if section_component.primary_model -%}
    <input type="hidden" name="instance_id_{{ section_component.primary_model }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
    <input type="hidden" name="custom_{{ section_component.primary_model }}_{{ section_methods[0].call_name }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
    {% endif -%}
    {% for parameter in section_methods[0].parameters %}
    <label class="block {{ d.text }} font-medium {{ c.label }} mb-1">{{ parameter.name }}</label>
    <input type="{% if parameter.type == 'int' %}number{% else %}text{% endif %}" name="{{ parameter.name }}" value="1" min="1" class="{{ c.border }} border bg-white {{ r }} px-3 py-2 text-sm {{ c.ring }} focus:outline-none focus:ring-2 mb-3">
    {% endfor %}
    <button type="submit" class="w-full {{ c.solid }} text-white {{ d.text }} font-semibold py-3 px-6 {{ r }} transition-opacity">
      {{ section_component.custom_methods[0] }}
    </button>
  </form>
{% else %}
  <div class="flex flex-wrap gap-2">
    {% for method in section_methods %}
    <form action="{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ page }}' {% if page.type == 'activity' %}active_process_node_id{% endif %}{% raw %}%}{% endraw %}" method="get">
      {% if section_component.primary_model -%}
      <input type="hidden" name="instance_id_{{ section_component.primary_model }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
      <input type="hidden" name="custom_{{ section_component.primary_model }}_{{ method.call_name }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
      {% endif -%}
      {% for parameter in method.parameters %}
      <label class="block {{ d.text }} font-medium {{ c.label }} mb-1">{{ parameter.name }}</label>
      <input type="{% if parameter.type == 'int' %}number{% else %}text{% endif %}" name="{{ parameter.name }}" value="1" min="1" class="{{ c.border }} border bg-white {{ r }} px-3 py-2 text-sm {{ c.ring }} focus:outline-none focus:ring-2 mb-3">
      {% endfor %}
      <button type="submit" class="{{ c.solid }} text-white {{ d.text }} font-medium py-2 px-4 {{ r }}">
        {{ method }}
      </button>
    </form>
    {% endfor %}
  </div>
{% endif %}

{# 鈹€鈹€ PREVIEW: DETAIL 鈹€鈹€ #}
{%- elif eff_lay == "detail" %}
{%- set img_pos = _s.get("image_position", "top") %}
{%- set img_w = _im.get(_s.get("image_size", "md"), "w-2/5") %}
  <div class="flex flex-col {{ d.gap }}">
    {%- for _mock_row in range(1) %}
    {%- if img_pos in ["left", "right"] %}
    <div class="{{ cs }} {{ r }} {{ d.p }} border border-gray-100 flex {{ 'flex-row' if img_pos == 'left' else 'flex-row-reverse' }} gap-6 items-start">
      {%- if _media_attr %}
      <div class="{{ img_w }} flex-shrink-0">
        {%- if _video_attr %}
        <div class="w-full h-56 {{ r }} bg-black flex items-center justify-center text-white/70">&#9658;</div>
        {%- else %}
        <img src="{{ _mock_imgs[_mock_row % (_mock_imgs|length)] }}" class="w-full h-56 object-cover {{ r }}" />
        {%- endif %}
      </div>
      {%- endif %}
      <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 {{ d.gap }}">
        {%- for attribute in _detail_attrs %}
        {%- if not (_media_attr and attribute|string == _media_attr|string) and attribute.type not in [AttributeType.IMAGE, AttributeType.VIDEO] %}
        <div class="si-field flex flex-col gap-1" data-field-name="{{ attribute }}">
          <span class="si-field-label text-xs font-medium text-gray-400 uppercase tracking-wide">{{ attribute }}</span>
          {%- if attribute.type == AttributeType.BOOLEAN %}<input type="checkbox" {% if _mock_row == 0 %}checked{% endif %} disabled class="h-4 w-4 rounded">
          {%- elif attribute.type == AttributeType.ENUM %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute.enum_literals[0] if attribute.enum_literals else attribute }}</span>
          {%- elif attribute.type == AttributeType.INTEGER %}<span class="{{ d.text }} font-medium text-gray-700">{{ _mock_row * 7 + 12 }}</span>
          {%- else -%}
            {{ _field_value(attribute, _mock_row, c, d, r, section_component.item_click_target_page) }}
          {%- endif %}
        </div>
        {%- endif %}
        {%- endfor %}
        <div class="sm:col-span-2 flex gap-2 pt-3 border-t border-gray-100">
          {%- if section_component.has_update_operation %}<button class="{{ d.text }} {{ c.text }} py-1 px-3 {{ r }} hover:{{ c.light }} border {{ c.border }} transition-colors">Edit</button>{%- endif %}
          {%- if section_component.has_delete_operation %}<button class="{{ d.text }} text-red-500 py-1 px-3 {{ r }} hover:bg-red-50 border border-red-200 transition-colors">Delete</button>{%- endif %}
        </div>
      </div>
    </div>
    {%- else %}
    <div class="{{ cs }} {{ r }} {{ d.p }} border border-gray-100">
      <div class="grid grid-cols-1 sm:grid-cols-2 {{ d.gap }}">
        {%- for attribute in _detail_attrs %}
        <div class="si-field flex flex-col gap-1{% if attribute.type in [AttributeType.IMAGE, AttributeType.VIDEO] %} sm:col-span-2{% endif %}" data-field-name="{{ attribute }}">
          <span class="si-field-label text-xs font-medium text-gray-400 uppercase tracking-wide">{{ attribute }}</span>
          {%- if attribute.type == AttributeType.BOOLEAN %}<input type="checkbox" {% if _mock_row == 0 %}checked{% endif %} disabled class="h-4 w-4 rounded">
          {%- elif attribute.type == AttributeType.ENUM %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute.enum_literals[0] if attribute.enum_literals else attribute }}</span>
          {%- elif attribute.type == AttributeType.INTEGER %}<span class="{{ d.text }} font-medium text-gray-700">{{ _mock_row * 7 + 12 }}</span>
          {%- elif _image_attr and attribute|string == _image_attr|string %}<img src="{{ _mock_imgs[_mock_row % (_mock_imgs|length)] }}" class="si-field-media si-img rounded mt-1" />
          {%- elif _video_attr and attribute|string == _video_attr|string %}<div class="si-field-media w-full h-48 rounded mt-1 bg-black flex items-center justify-center text-white/70">&#9658;</div>
          {%- elif attribute.type == AttributeType.IMAGE %}<img src="{{ _mock_imgs[_mock_row % (_mock_imgs|length)] }}" class="si-field-media si-img rounded mt-1" />
          {%- elif attribute.type == AttributeType.VIDEO %}<div class="si-field-media w-full h-48 rounded mt-1 bg-black flex items-center justify-center text-white/70">&#9658;</div>
          {%- else -%}
            {{ _field_value(attribute, _mock_row, c, d, r, section_component.item_click_target_page) }}
          {%- endif %}
        </div>
        {%- endfor %}
      </div>
      <div class="flex gap-2 mt-4 pt-3 border-t border-gray-100">
        {%- if section_component.has_update_operation %}<button class="{{ d.text }} {{ c.text }} py-1 px-3 {{ r }} hover:{{ c.light }} border {{ c.border }} transition-colors">Edit</button>{%- endif %}
        {%- if section_component.has_delete_operation %}<button class="{{ d.text }} text-red-500 py-1 px-3 {{ r }} hover:bg-red-50 border border-red-200 transition-colors">Delete</button>{%- endif %}
      </div>
    </div>
    {%- endif %}
    {%- endfor %}
  </div>

{# 鈹€鈹€ PREVIEW: CARD 鈹€鈹€ #}
{%- elif _glay == "card" %}
{%- if _disp == "carousel" %}
  {# Scrollable card strip #}
  <div class="flex gap-3 overflow-x-auto pb-2" style="scrollbar-width:thin;">
    {%- if _cstyle == "category" %}
    {%- for i in range(section_mock_rows if _actor_owned_preview or section_mock_rows > 3 else 8) %}
    {{ _category_tile((_mock_imgs[i % (_mock_imgs|length)] if _image_attr else ''), (_tattrs[i]|string if i < _tattrs|length else section_component.display_name), '#', opacity_style='opacity:' + (_mock_opacities[i] if i < 3 else '0.75')) }}
    {%- endfor %}
    {%- else %}
    {%- for _mock_row in range(section_mock_rows if _actor_owned_preview or section_mock_rows > 3 else 6) %}
    {{ _mini_card((_mock_imgs[_mock_row % (_mock_imgs|length)] if _image_attr else ''), (_title_attr|string + ' ' + (_mock_row + 1)|string) if _title_attr else (section_component.display_name + ' ' + (_mock_row + 1)|string), (_primary_attr|string if _primary_attr else ''), _accent_hex, opacity_style='opacity:' + (_mock_opacities[_mock_row] if _mock_row < 3 else '0.75'), item_actions_html=item_action_buttons(section_component, 'w-full text-center text-xs ' ~ btn_cls(_s.get('color','blue')), section_component.primary_model)) }}
    {%- endfor %}
    {%- endif %}
    <div class="flex-shrink-0 flex items-center"><button class="w-8 h-8 bg-white border border-gray-300 rounded-full shadow flex items-center justify-center text-gray-600 hover:bg-gray-50">茅藛?/button></div>
  </div>
{%- elif _disp == "banner" %}
  {# Hero banner #}
  <div class="rounded-xl overflow-hidden relative bg-white border border-gray-100 shadow-sm" style="min-height:{{ section_component.min_height or _banner_h }};">
    <div class="flex flex-col sm:flex-row items-stretch">
      <div class="flex-1 px-8 py-7">
        <h2 class="text-3xl font-black text-gray-900 leading-tight">{{ section_component.display_name }}</h2>
        {%- if section_component.text %}<p class="text-base text-gray-600 mt-1 max-w-xs">{{ section_component.text }}</p>{%- endif %}
      </div>
      <div class="sm:w-1/2 bg-gray-50" style="min-height:{{ _banner_img_h }};aspect-ratio:{{ _image_ratio_css }};">
        {%- if _static_image_url %}
        <img src="{{ _static_image_url }}" alt="{{ _s.get('image_alt') or section_component.display_name }}" class="w-full h-full object-cover" />
        {%- elif _image_attr %}
        <img src="{{ _mock_imgs[0] }}" alt="{{ section_component.display_name }}" class="w-full h-full object-cover" />
        {%- else %}
        <div class="w-full h-full flex items-center justify-center text-sm text-gray-400">{{ section_component.display_name }}</div>
        {%- endif %}
      </div>
    </div>
  </div>
{%- elif _cstyle == "category" %}
  {# Category tile grid #}
  <div class="grid {{ col }} {{ d.gap }}">
    {%- for i in range(section_mock_rows if _actor_owned_preview or section_mock_rows > 3 else 8) %}
    {{ _category_tile((_mock_imgs[i % (_mock_imgs|length)] if _image_attr else ''), (_title_attr|string if _title_attr else section_component.display_name), '#', opacity_style='opacity:' + (_mock_opacities[i] if i < 3 else '0.75')) }}
    {%- endfor %}
  </div>
{%- elif _cstyle == "product" %}
  {# Product card grid #}
  <div class="grid {{ col }} {{ d.gap }}">
    {%- for _mock_row in range(section_mock_rows) %}
    {{ _mini_card((_mock_imgs[_mock_row % (_mock_imgs|length)] if _image_attr else ''), (_title_attr|string + ' ' + (_mock_row + 1)|string) if _title_attr else (section_component.display_name + ' ' + (_mock_row + 1)|string), (_primary_attr|string if _primary_attr else ''), _accent_hex, opacity_style='opacity:' + (_mock_opacities[_mock_row] if _mock_row < 3 else '0.75'), item_actions_html=item_action_buttons(section_component, 'w-full text-center text-xs ' ~ btn_cls(_s.get('color','blue')), section_component.primary_model)) }}
    {%- endfor %}
  </div>
{%- elif _cstyle == "person" %}
  {# Person card grid: avatar-led profile cards, visually distinct from generic cards #}
  <div class="grid {{ col }} {{ d.gap }}"{% if section_component.has_select_operation %} data-selectable="{{ section_component.id }}"{% endif %}>
    {%- for _mock_row in range(section_mock_rows) %}
    <div class="{{ cs }} si-card si-card-hover {{ r }} p-5 relative overflow-hidden flex flex-col items-center text-center gap-3{% if section_component.has_select_operation %} si-sel-item{% endif %}" data-item-idx="{{ _mock_row }}"{% if section_component.has_select_operation %} data-selectable-sid="{{ section_component.id }}"{% endif %} style="opacity: {{ _mock_opacities[_mock_row] if _mock_row < 3 else '0.4' }};">
      {%- if section_component.has_select_operation %}<span class="si-sel-cb"></span>{%- endif %}
      <div class="absolute inset-x-0 top-0 h-16 opacity-15" style="background: linear-gradient(135deg, {{ _accent_hex }}, transparent);"></div>
      <div class="relative w-20 h-20 rounded-full overflow-hidden border-4 border-white shadow-md bg-gray-100 flex items-center justify-center">
        {%- if _image_attr %}
        <img src="{{ _mock_imgs[_mock_row % (_mock_imgs|length)] }}" class="w-full h-full object-cover" alt="{{ section_component.display_name }}" />
        {%- else %}
        <span class="text-xl font-black" style="color: {{ _accent_hex }};">{{ ((_title_attr|string)[0] if _title_attr else section_component.display_name[0])|upper }}</span>
        {%- endif %}
      </div>
      <div class="relative min-w-0 w-full">
        <div class="si-field" data-field-name="{{ _title_attr }}">
          <div class="si-field-value font-bold text-gray-900 truncate">
            {%- if _title_attr %}{{ _title_attr }} {{ _mock_row + 1 }}{%- else %}{{ section_component.display_name }} {{ _mock_row + 1 }}{%- endif %}
          </div>
        </div>
        {%- if _slot.subtitle or _primary_attr %}
        {%- set _person_role = _slot.subtitle or _primary_attr %}
        <div class="si-field mt-1" data-field-name="{{ _person_role }}">
          <span class="si-field-value text-sm text-gray-500">{{ _person_role }}</span>
        </div>
        {%- endif %}
      </div>
      {%- if _secondary_attrs %}
      <div class="flex flex-wrap justify-center gap-1.5 pt-1">
        {%- for attribute in _secondary_attrs[:3] %}
        <span class="si-field text-xs px-2 py-1 rounded-full bg-gray-50 text-gray-600 border border-gray-100" data-field-name="{{ attribute }}">{{ attribute }}</span>
        {%- endfor %}
      </div>
      {%- endif %}
      <div class="flex gap-2 mt-auto pt-3 border-t border-gray-100 w-full justify-center">
        {%- if section_component.item_click_target_page %}<a href="#" class="{{ d.text }} {{ c.text }} font-medium hover:underline">View profile</a>{%- endif %}
        {{ select_mock_button(section_component, d.text ~ ' font-medium ' ~ c.text ~ ' hover:underline') }}
        {{ item_action_buttons(section_component, d.text ~ ' font-medium ' ~ c.text ~ ' hover:underline', section_component.primary_model) }}
        {%- if section_component.has_update_operation %}<button class="{{ d.text }} font-medium {{ c.text }} hover:underline">Edit</button>{%- endif %}
        {%- if section_component.has_delete_operation %}<button class="{{ d.text }} font-medium text-red-500 hover:underline">Delete</button>{%- endif %}
      </div>
    </div>
    {%- endfor %}
  </div>
{%- elif _cstyle == "compact" %}
  {# Compact card grid #}
  <div class="grid {{ col }} {{ d.gap }}">
    {%- for _mock_row in range(section_mock_rows) %}
    <div class="{{ cs }} {{ r }} p-3 flex items-center gap-3" style="opacity: {{ _mock_opacities[_mock_row] if _mock_row < 3 else '0.4' }}">
      {%- if _media_attr %}<div class="w-12 h-12 {{ 'bg-black text-white/70' if _video_attr else 'bg-gray-50' }} rounded flex-shrink-0 flex items-center justify-center overflow-hidden">{% if _video_attr %}&#9658;{% elif _image_attr %}<img src="{{ _mock_imgs[_mock_row % (_mock_imgs|length)] }}" class="w-full h-full object-cover" />{% endif %}</div>{%- endif %}
      <div class="flex-1 min-w-0">
        {%- for attribute in _card_attrs[:2] %}<div class="block">{{ _field_value(attribute, _mock_row, c, d, r, section_component.item_click_target_page) }}</div>{%- endfor %}
      </div>
      <div class="flex gap-1 shrink-0">
        {%- if section_component.item_click_target_page %}<a href="#" class="text-xs {{ c.text }} hover:underline">View</a>{%- endif %}
        {{ select_mock_button(section_component, 'text-xs ' ~ c.text ~ ' hover:underline') }}
        {{ item_action_buttons(section_component, 'text-xs ' ~ c.text ~ ' hover:underline', section_component.primary_model) }}
        {%- if section_component.has_update_operation %}<button class="text-xs {{ c.text }} hover:underline">Edit</button>{%- endif %}
        {%- if section_component.has_delete_operation %}<button class="text-xs text-red-400 hover:underline">Del</button>{%- endif %}
      </div>
    </div>
    {%- endfor %}
  </div>
{%- else %}
  {# Default card grid #}
  <div class="grid {{ col }} {{ d.gap }}"{% if section_component.has_select_operation %} data-selectable="{{ section_component.id }}"{% endif %}>
    {%- for _mock_row in range(section_mock_rows) %}
    <div class="{{ cs }} si-card si-card-hover {{ r }} {{ d.p }} flex flex-col gap-3{% if section_component.has_select_operation %} si-sel-item{% endif %}" data-item-idx="{{ _mock_row }}"{% if section_component.has_select_operation %} data-selectable-sid="{{ section_component.id }}"{% endif %} style="opacity: {{ _mock_opacities[_mock_row] if _mock_row < 3 else '0.4' }}">
      {%- if section_component.has_select_operation %}<span class="si-sel-cb"></span>{%- endif %}
      {%- for attribute in _card_attrs %}
      <div class="si-field flex flex-col gap-0.5" data-field-name="{{ attribute }}">
        <span class="si-field-label text-xs font-medium text-gray-400 uppercase tracking-wide">{{ attribute }}</span>
        {%- if attribute.type == AttributeType.BOOLEAN %}<input type="checkbox" {% if _mock_row == 0 %}checked{% endif %} disabled class="h-4 w-4 rounded mt-0.5">
        {%- elif attribute.type == AttributeType.ENUM %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute.enum_literals[0] if attribute.enum_literals else attribute }}</span>
        {%- elif attribute.type == AttributeType.INTEGER %}<span class="{{ d.text }} font-medium text-gray-700">{{ _mock_row * 7 + 12 }}</span>
        {%- elif _image_attr and attribute|string == _image_attr|string %}<img src="{{ _mock_imgs[_mock_row % (_mock_imgs|length)] }}" class="si-field-media si-img rounded mt-1" />
        {%- elif _video_attr and attribute|string == _video_attr|string %}<div class="si-field-media si-video rounded mt-1 flex items-center justify-center text-white/70">&#9658;</div>
        {%- elif attribute.type == AttributeType.IMAGE %}<img src="{{ _mock_imgs[_mock_row % (_mock_imgs|length)] }}" class="si-field-media si-img rounded mt-1" />
        {%- elif attribute.type == AttributeType.VIDEO %}<div class="si-field-media si-video rounded mt-1 flex items-center justify-center text-white/70">&#9658;</div>
        {%- else %}{{ _field_value(attribute, _mock_row, c, d, r, section_component.item_click_target_page) }}
        {%- endif %}
      </div>
      {%- endfor %}
      <div class="flex gap-2 mt-auto pt-3 border-t border-gray-100">
