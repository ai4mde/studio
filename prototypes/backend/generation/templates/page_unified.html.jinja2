<script>
(function() {
  var style = document.createElement('style');
  style.textContent = '[data-section-id]{cursor:pointer;transition:outline 0.15s}[data-section-id]:hover{outline:2px dashed #93c5fd;outline-offset:6px}[data-section-id].si-selected{outline:2px solid #3b82f6;outline-offset:6px}aside[data-region-side]{transition:outline 0.15s}aside[data-region-side]:hover{outline:2px dashed #f59e0b;outline-offset:6px}aside[data-region-side].si-region-selected{outline:2px solid #f59e0b;outline-offset:6px}';
  document.head.appendChild(style);
  document.addEventListener('click', function(e) {
    var link = e.target.closest && e.target.closest('a[href]');
    if (link) { e.preventDefault(); }
    var el = e.target.closest && e.target.closest('[data-section-id]');
    if (!el) {
      var region = e.target.closest && e.target.closest('aside[data-region-side]');
      if (!region) return;
      e.stopPropagation();
      document.querySelectorAll('[data-section-id]').forEach(function(x){x.classList.remove('si-selected')});
      document.querySelectorAll('aside[data-region-side]').forEach(function(x){x.classList.remove('si-region-selected')});
      region.classList.add('si-region-selected');
      window.parent.postMessage({type:'region-selected',region:'sidebar',side:region.dataset.regionSide || ''},'*');
      return;
    }
    e.stopPropagation();
    document.querySelectorAll('[data-section-id]').forEach(function(x){x.classList.remove('si-selected')});
    document.querySelectorAll('aside[data-region-side]').forEach(function(x){x.classList.remove('si-region-selected')});
    el.classList.add('si-selected');
    window.parent.postMessage({type:'section-selected',id:el.dataset.sectionId,name:el.dataset.sectionName},'*');
  }, true);
})();
</script>

<script>
(function() {
  var kw = {
    success: /\b(active|approved|success|paid|completed|confirmed|verified|enabled|done|shipped)\b/i,
    error:   /\b(rejected|failed|error|cancelled|canceled|declined|inactive|disabled|expired|denied)\b/i,
    warning: /\b(pending|processing|draft|review|waiting|hold|queued)\b/i,
  };
  document.querySelectorAll('.si-badge').forEach(function(el) {
    var t = el.textContent.trim();
    if (kw.success.test(t))      { el.className = 'si-badge si-badge-success'; }
    else if (kw.error.test(t))   { el.className = 'si-badge si-badge-error'; }
    else if (kw.warning.test(t)) { el.className = 'si-badge si-badge-warning'; }
    else                         { el.className = 'si-badge si-badge-neutral'; }
  });
})();
</script>

<script>
/* 茅藛鹿芒鈥毬┧喡姑⑩€毬?Multi-select (si-selectable sections) 茅藛鹿芒鈥毬┧喡姑⑩€毬?*/
(function() {
  var bars = {};
  document.querySelectorAll('[data-selectable]').forEach(function(grid) {
    var sid = grid.dataset.selectable;
    var bar = document.createElement('div');
    bar.className = 'si-sel-bar';
    bar.id = 'sel-bar-' + sid;
    bar.innerHTML = '<span class="sel-count">0 selected</span>'
      + '<button onclick="siSelClear(\'' + sid + '\')">Clear</button>'
      + '<button class="danger" onclick="siSelDelete(\'' + sid + '\')">Delete selected</button>';
    document.body.appendChild(bar);
    bars[sid] = bar;
  });

  window.siSelUpdate = function(sid) {
    var grid = document.querySelector('[data-selectable="' + sid + '"]');
    if (!grid) return;
    var selected = grid.querySelectorAll('.si-selected');
    var bar = bars[sid];
    if (!bar) return;
    bar.querySelector('.sel-count').textContent = selected.length + ' selected';
    bar.classList.toggle('active', selected.length > 0);
  };

  window.siSelClear = function(sid) {
    var grid = document.querySelector('[data-selectable="' + sid + '"]');
    if (grid) grid.querySelectorAll('.si-selected').forEach(function(el) { el.classList.remove('si-selected'); });
    siSelUpdate(sid);
  };

  function siGetCsrfToken() {
    var input = document.querySelector('input[name="csrfmiddlewaretoken"]');
    if (input && input.value) return input.value;
    var match = document.cookie.match(/(?:^|;\s*)csrftoken=([^;]+)/);
    return match ? decodeURIComponent(match[1]) : '';
  }

  window.siSelDelete = function(sid) {
    var grid = document.querySelector('[data-selectable="' + sid + '"]');
    if (!grid) return;
    var selected = Array.from(grid.querySelectorAll('.si-selected[data-item-idx]'));
    var ids = selected.map(function(el) { return el.dataset.itemIdx; });
    var urls = selected.map(function(el) { return el.dataset.deleteUrl; }).filter(Boolean);
    if (!urls.length) {
      window.parent.postMessage({ type: 'si-select-delete', sectionId: sid, indices: ids }, '*');
      selected.forEach(function(el) { el.classList.add('opacity-30'); el.classList.remove('si-selected'); });
      siSelUpdate(sid);
      return;
    }
    if (!window.confirm('Delete ' + urls.length + ' selected item' + (urls.length === 1 ? '' : 's') + '?')) return;
    var csrf = siGetCsrfToken();
    Promise.all(urls.map(function(url) {
      return fetch(url, {
        method: 'POST',
        credentials: 'same-origin',
        headers: csrf ? { 'X-CSRFToken': csrf } : {}
      });
    })).then(function(responses) {
      var failed = responses.filter(function(response) { return !response.ok; });
      if (failed.length) window.alert('Some selected items could not be deleted.');
      window.location.reload();
    }).catch(function() {
      window.alert('Could not delete selected items.');
    });
  };

  document.addEventListener('click', function(e) {
    var item = e.target.closest('.si-sel-item[data-selectable-sid]');
    if (!item) return;
    var sid = item.dataset.selectableSid;
    var grid = item.closest('[data-selectable]');
    if (e.shiftKey && grid) {
      var items = Array.from(grid.querySelectorAll('.si-sel-item'));
      var lastSel = grid.querySelector('.si-last-sel');
      var start = lastSel ? items.indexOf(lastSel) : 0;
      var end = items.indexOf(item);
      if (start > end) { var tmp = start; start = end; end = tmp; }
      items.slice(start, end + 1).forEach(function(el) { el.classList.add('si-selected'); });
    } else {
      item.classList.toggle('si-selected');
      if (item.classList.contains('si-selected') && grid) {
        grid.querySelectorAll('.si-last-sel').forEach(function(el) { el.classList.remove('si-last-sel'); });
        item.classList.add('si-last-sel');
      }
    }
    siSelUpdate(sid);
  }, true);
})();
</script>

<style>
/* 茅藛鹿芒鈥毬┧喡姑⑩€毬?Drag-and-drop sections 茅藛鹿芒鈥毬┧喡姑⑩€毬?*/
[data-section-id] { position: relative; }
/* Full-width drag bar at top of section (starts below the top-resize handle) */
.si-move-bar {
  position: absolute; top: 6px; right: 6px;
  width: 24px; height: 24px;
  cursor: grab; z-index: 40;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity 0.15s, background 0.1s;
  user-select: none;
  background: rgba(255,255,255,0.92);
  border: 1px solid rgba(100,116,139,0.25);
  border-radius: 6px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.10);
}
.si-move-bar::after {
  content: '';
  display: block;
  width: 12px; height: 10px;
  background-image: radial-gradient(circle, rgba(100,116,139,0.7) 1.5px, transparent 1.5px);
  background-size: 4px 4px;
  background-repeat: repeat;
}
.si-move-bar:hover { background: rgba(241,245,249,0.98); }
.si-move-bar:active { cursor: grabbing; }
[data-section-id]:hover .si-move-bar { opacity: 1; pointer-events: auto; }
[data-section-id].si-dragging { opacity: 0.4; outline: 2px dashed #93c5fd; outline-offset: 4px; }
[data-section-id].si-drag-over { outline: 2px solid var(--accent, #3b82f6); outline-offset: 4px; background: color-mix(in srgb, var(--accent, #3b82f6) 5%, transparent); }
.si-drop-layer {
  position: fixed; inset: 0; z-index: 35;
  pointer-events: none;
}
.si-drop-zone {
  position: fixed; pointer-events: auto;
  display: flex; align-items: center; justify-content: center;
  color: var(--accent, #2563eb);
  background: color-mix(in srgb, var(--accent, #2563eb) 8%, transparent);
  border: 1px dashed color-mix(in srgb, var(--accent, #2563eb) 55%, transparent);
  border-radius: 10px;
  font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
  opacity: .25; transition: opacity .12s, background .12s, transform .12s;
}
.si-drop-zone.active {
  opacity: .95;
  background: color-mix(in srgb, var(--accent, #2563eb) 16%, white);
  transform: scale(1.01);
}
.si-drop-zone-header { top: 8px; left: 16px; right: 16px; height: 52px; }
.si-drop-zone-hero { top: 68px; left: 16px; right: 16px; height: 58px; }
.si-drop-zone-left-sidebar { top: 136px; left: 16px; bottom: 84px; width: 132px; }
.si-drop-zone-right-sidebar { top: 136px; right: 16px; bottom: 84px; width: 132px; }
.si-drop-zone-main { top: 136px; left: 160px; right: 160px; bottom: 84px; }
.si-drop-zone-footer { left: 16px; right: 16px; bottom: 16px; height: 56px; }

/* 茅藛鹿芒鈥毬┧喡姑⑩€毬?Section resize (left + right handles) 茅藛鹿芒鈥毬┧喡姑⑩€毬?*/
.si-resize-handle, .si-lresize-handle {
  position: absolute; top: 0;
  width: 10px; height: 100%; min-height: 40px;
  cursor: col-resize; z-index: 30;
  opacity: 0; transition: opacity 0.15s;
}
.si-resize-handle  { right: 0; }
.si-lresize-handle { left: 0; }
[data-section-id]:hover .si-resize-handle,
[data-section-id]:hover .si-lresize-handle,
[data-section-id].si-resizing .si-resize-handle,
[data-section-id].si-resizing .si-lresize-handle { opacity: 1; }
.si-resize-handle::after {
  content: ''; position: absolute; right: 0; top: 50%; transform: translateY(-50%);
  width: 3px; height: 40px; background: var(--accent, #3b82f6);
  border-radius: 3px; box-shadow: 0 0 0 1px white;
}
.si-lresize-handle::after {
  content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 3px; height: 40px; background: var(--accent, #3b82f6);
  border-radius: 3px; box-shadow: 0 0 0 1px white;
}
.si-resize-snap-line {
  position: fixed; top: 0; bottom: 0; width: 2px;
  background: var(--accent, #3b82f6); opacity: 0.45;
  pointer-events: none; z-index: 9998;
}
.si-resize-tooltip {
  position: fixed; background: var(--accent, #3b82f6); color: white;
  font-size: 11px; font-weight: 600; padding: 2px 7px;
  border-radius: 4px; pointer-events: none; z-index: 9999;
  transform: translateX(-50%);
}

/* 茅藛鹿芒鈥毬┧喡姑⑩€毬?Section vertical resize (top + bottom handles) 茅藛鹿芒鈥毬┧喡姑⑩€毬?*/
.si-vresize-handle, .si-tresize-handle {
  position: absolute; left: 0; right: 0;
  height: 10px; cursor: row-resize; z-index: 30;
  opacity: 0; transition: opacity 0.15s;
}
.si-vresize-handle { bottom: 0; }
.si-tresize-handle { top: 0; }
[data-section-id]:hover .si-vresize-handle,
[data-section-id]:hover .si-tresize-handle,
[data-section-id].si-vresizing .si-vresize-handle,
[data-section-id].si-vresizing .si-tresize-handle { opacity: 1; }
.si-vresize-handle::after {
  content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 40px; height: 3px; background: var(--accent, #3b82f6);
  border-radius: 3px; box-shadow: 0 0 0 1px white;
}
.si-tresize-handle::after {
  content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: 40px; height: 3px; background: var(--accent, #3b82f6);
  border-radius: 3px; box-shadow: 0 0 0 1px white;
}
.si-vresize-hline {
  position: fixed; left: 0; right: 0; height: 2px;
  background: var(--accent, #3b82f6); opacity: 0.4;
  pointer-events: none; z-index: 9998;
}
.si-vresize-tip {
  position: fixed; background: var(--accent, #3b82f6); color: white;
  font-size: 11px; font-weight: 600; padding: 2px 7px;
  border-radius: 4px; pointer-events: none; z-index: 9999;
}
/* Lift hovered/active section above adjacent content so handles are always on top */
[data-section-id]:hover { z-index: 5; }
[data-section-id].si-resizing, [data-section-id].si-vresizing { z-index: 10; }
/* Left/right insert indicators during drag-over */
[data-section-id].si-drag-before { box-shadow: inset 4px 0 0 0 var(--accent, #3b82f6); }
[data-section-id].si-drag-after  { box-shadow: inset -4px 0 0 0 var(--accent, #3b82f6); }
/* Right-click context menu */
.si-ctx-menu {
  position: fixed; z-index: 99999;
  background: #fff; border: 1px solid #e2e8f0;
  border-radius: 8px; padding: 4px 0;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12), 0 2px 6px rgba(0,0,0,0.08);
  min-width: 140px; font-size: 13px;
}
.si-ctx-item {
  display: flex; align-items: center; gap: 8px;
  padding: 7px 14px; cursor: pointer; color: #1e293b;
  user-select: none; transition: background 0.1s;
}
.si-ctx-item:hover { background: #f1f5f9; }
.si-ctx-item svg { flex-shrink: 0; opacity: 0.7; }
.si-ctx-sep { height: 1px; background: #e2e8f0; margin: 4px 0; }
.si-ctx-item.danger { color: #dc2626; }
.si-ctx-item.danger:hover { background: #fef2f2; }
/* Drop row indicator 茅藛?shown above/below a row during cross-row drag */
[data-section-id].si-drag-row-before { box-shadow: inset 0 4px 0 0 var(--accent, #3b82f6); }
[data-section-id].si-drag-row-after  { box-shadow: inset 0 -4px 0 0 var(--accent, #3b82f6); }
</style>

<script>
/* 茅藛鹿芒鈥毬┧喡姑⑩€毬?Section right-click context menu 茅藛鹿芒鈥毬┧喡姑⑩€毬?*/
(function() {
  var menu = null;

  function hideMenu() {
    if (menu) { menu.remove(); menu = null; }
  }

  function showMenu(x, y, sectionId) {
    hideMenu();

    menu = document.createElement('div');
    menu.className = 'si-ctx-menu';
    menu.style.left = x + 'px';
    menu.style.top  = y + 'px';

    // sectionId is captured here in the closure 茅藛?safe from hideMenu clearing it
    function item(icon, label, cls, action) {
      var el = document.createElement('div');
      el.className = 'si-ctx-item' + (cls ? ' ' + cls : '');
      el.innerHTML = icon + '<span>' + label + '</span>';
      el.addEventListener('mousedown', function(e) { e.stopPropagation(); });
      el.addEventListener('click', function() {
        hideMenu();
        action(sectionId);   // sectionId from outer closure, already captured
      });
      return el;
    }

    menu.appendChild(item(
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>',
      'Duplicate', '', function(id) {
        window.parent.postMessage({ type: 'section-duplicate', id: id }, '*');
      }
    ));

    menu.appendChild(item(
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>',
      'Delete', 'danger', function(id) {
        window.parent.postMessage({ type: 'section-delete', id: id }, '*');
      }
    ));

    document.body.appendChild(menu);

    // Flip if menu overflows viewport
    var rect = menu.getBoundingClientRect();
    if (rect.right  > window.innerWidth)  menu.style.left = (x - rect.width)  + 'px';
    if (rect.bottom > window.innerHeight) menu.style.top  = (y - rect.height) + 'px';
  }

  document.querySelectorAll('[data-section-id]').forEach(function(el) {
    el.addEventListener('contextmenu', function(e) {
      e.preventDefault();
      e.stopPropagation();
      showMenu(e.clientX, e.clientY, el.dataset.sectionId);
    });
  });

  document.addEventListener('mousedown', function(e) {
    if (menu && !menu.contains(e.target)) hideMenu();
  });
  document.addEventListener('scroll', hideMenu, true);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') hideMenu();
  });
})();
</script>

<script>
/* 茅藛鹿芒鈥毬┧喡姑⑩€毬?Section drag-and-drop (pure mouse events, tracks drop target during mousemove) 茅藛鹿芒鈥毬┧喡姑⑩€毬?*/
(function() {
  var dragging = false;
  var draggingId = null;
  var draggingEl = null;
  var currentDrop = null; // updated every mousemove
  var dropLayer = null;

  function allSections() {
    return Array.from(document.querySelectorAll('[data-section-id]'));
  }

  function sectionRegion(el) {
    var pos = el.dataset.position || 'main';
    return ['header', 'hero', 'main', 'sidebar', 'footer'].indexOf(pos) >= 0 ? pos : 'main';
  }

  function regionBounds(region) {
    var secs = allSections().filter(function(el) { return sectionRegion(el) === region; });
    if (!secs.length) return null;
    var tops = secs.map(function(el) { return el.getBoundingClientRect().top; });
    var bots = secs.map(function(el) { return el.getBoundingClientRect().bottom; });
    return { top: Math.min.apply(null, tops), bottom: Math.max.apply(null, bots) };
  }

  function showDropZones() {
    if (dropLayer) return;
    dropLayer = document.createElement('div');
    dropLayer.className = 'si-drop-layer';
    [
      ['header', '', 'Header'],
      ['hero', '', 'Hero'],
      ['sidebar', 'left', 'Left Sidebar'],
      ['main', '', 'Main'],
      ['sidebar', 'right', 'Right Sidebar'],
      ['footer', '', 'Footer']
    ].forEach(function(spec) {
      var region = spec[0], side = spec[1], label = spec[2];
      var zone = document.createElement('div');
      zone.className = 'si-drop-zone si-drop-zone-' + (side ? side + '-' : '') + region;
      zone.dataset.dropRegion = region;
      if (side) zone.dataset.dropSidebarSide = side;
      zone.textContent = 'Drop in ' + label;
      dropLayer.appendChild(zone);
    });
    document.body.appendChild(dropLayer);
  }

  function hideDropZones() {
    if (dropLayer) { dropLayer.remove(); dropLayer = null; }
  }

  function setActiveDropZone(drop) {
    if (!dropLayer) return;
    dropLayer.querySelectorAll('.si-drop-zone').forEach(function(zone) {
      var sameRegion = zone.dataset.dropRegion === (drop && drop.position);
      var sameSide = (zone.dataset.dropSidebarSide || '') === (drop && drop.sidebarSide || '');
      zone.classList.toggle('active', sameRegion && sameSide);
    });
  }

  function pointContext(x, y) {
    var stack = document.elementsFromPoint ? document.elementsFromPoint(x, y) : [];
    var hitSec = null, hitZone = null;
    for (var i = 0; i < stack.length; i++) {
      if (!hitSec && stack[i].closest) {
        var sec = stack[i].closest('[data-section-id]');
        if (sec && sec.dataset.sectionId !== draggingId) hitSec = sec;
      }
      if (!hitZone && stack[i].closest) {
        hitZone = stack[i].closest('[data-drop-region]');
      }
    }
    if (hitSec) return { region: sectionRegion(hitSec), sidebarSide: hitSec.dataset.sidebarSide || '', hitSection: hitSec };
    if (hitZone) return { region: hitZone.dataset.dropRegion || 'main', sidebarSide: hitZone.dataset.dropSidebarSide || '', hitSection: null };

    var hb = regionBounds('header');
    var heroB = regionBounds('hero');
    var mb = regionBounds('main');
    var sb = regionBounds('sidebar');
    var fb = regionBounds('footer');

    if (hb && y <= hb.bottom + 48) return { region: 'header', sidebarSide: '' };
    if (fb && y >= fb.top - 48) return { region: 'footer', sidebarSide: '' };
    if (!fb && y >= window.innerHeight * 0.82) return { region: 'footer', sidebarSide: '' };

    if (sb && y >= sb.top - 24 && y <= sb.bottom + 24) {
      var sidebarSecs = siblingsIn('sidebar');
      if (sidebarSecs.length) {
        var left = Math.min.apply(null, sidebarSecs.map(function(el) { return el.getBoundingClientRect().left; }));
        var right = Math.max.apply(null, sidebarSecs.map(function(el) { return el.getBoundingClientRect().right; }));
        if (x >= left - 48 && x <= right + 48) return { region: 'sidebar', sidebarSide: '' };
      }
    }

    if (hb && mb) {
      var headerMainSplit = hb.bottom + (mb.top - hb.bottom) / 2;
      if (y < headerMainSplit) return { region: 'header', sidebarSide: '' };
    } else if (!hb && mb && y < mb.top - 24) {
      return { region: 'header', sidebarSide: '' };
    }

    if (heroB && y >= heroB.top - 24 && y <= heroB.bottom + 24) return { region: 'hero', sidebarSide: '' };

    if (mb && fb) {
      var mainFooterSplit = mb.bottom + (fb.top - mb.bottom) / 2;
      if (y > mainFooterSplit) return { region: 'footer', sidebarSide: '' };
    } else if (!fb && mb && y > mb.bottom + 24) {
      return { region: 'footer', sidebarSide: '' };
    }

    return { region: 'main', sidebarSide: '' };
  }

  // Sections in a given region, excluding the section being dragged
  function siblingsIn(region) {
    return allSections().filter(function(el) {
      if (el.dataset.sectionId === draggingId) return false;
      return sectionRegion(el) === region;
    });
  }

  // Group flat list of sections into visual rows (sections with similar .top within 20px)
  function toRows(secs) {
    var rows = [];
    secs.forEach(function(sec) {
      var r = sec.getBoundingClientRect();
      for (var i = 0; i < rows.length; i++) {
        if (Math.abs(r.top - rows[i].top) < 20) {
          rows[i].secs.push(sec);
          rows[i].bottom = Math.max(rows[i].bottom, r.bottom);
          return;
        }
      }
      rows.push({ top: r.top, bottom: r.bottom, secs: [sec] });
    });
    rows.sort(function(a, b) { return a.top - b.top; });
    return rows;
  }

  function findDrop(mx, my) {
    var ctx = pointContext(mx, my);
    var region = ctx.region || 'main';
    var sidebarSide = ctx.sidebarSide || '';
    var secs = siblingsIn(region);
    if (region === 'sidebar' && sidebarSide) {
      secs = secs.filter(function(el) { return (el.dataset.sidebarSide || '') === sidebarSide; });
    }

    if (secs.length === 0) {
      return { beforeId: '__end__', position: region, sidebarSide: sidebarSide, indicEl: null, indicSide: null };
    }

    var rows = toRows(secs);

    // Above all rows
    if (my < rows[0].top) {
      var s0 = rows[0].secs[0];
      return { beforeId: s0.dataset.sectionId, position: region, sidebarSide: sidebarSide, indicEl: s0, indicSide: 'row-before' };
    }
    // Below all rows
    var last = rows[rows.length - 1];
    if (my > last.bottom) {
      var sLast = last.secs[last.secs.length - 1];
      return { beforeId: '__end__', position: region, sidebarSide: sidebarSide, indicEl: sLast, indicSide: 'row-after' };
    }

    // Find the row containing cursor Y (or the nearest one)
    var ri = 0;
    for (var r = 0; r < rows.length; r++) {
      if (my <= rows[r].bottom) { ri = r; break; }
    }
    var row = rows[ri];

    // Sort row sections left茅藛芦忙艩庐ight
    var rowSecs = row.secs.slice().sort(function(a, b) {
      return a.getBoundingClientRect().left - b.getBoundingClientRect().left;
    });

    if (my < row.top + (row.bottom - row.top) * 0.25) {
      return { beforeId: rowSecs[0].dataset.sectionId, position: region, sidebarSide: sidebarSide, indicEl: rowSecs[0], indicSide: 'row-before' };
    }
    if (my > row.top + (row.bottom - row.top) * 0.75) {
      var belowId = (ri + 1 < rows.length) ? rows[ri + 1].secs[0].dataset.sectionId : '__end__';
      return { beforeId: belowId, position: region, sidebarSide: sidebarSide, indicEl: rowSecs[rowSecs.length - 1], indicSide: 'row-after' };
    }

    // Scan left茅藛芦忙艩庐ight to find insert position within the row
    for (var s = 0; s < rowSecs.length; s++) {
      var sr = rowSecs[s].getBoundingClientRect();
      var midX = sr.left + sr.width / 2;
      if (mx <= midX) {
        return { beforeId: rowSecs[s].dataset.sectionId, position: region, sidebarSide: sidebarSide, indicEl: rowSecs[s], indicSide: 'before' };
      }
    }

    // Mouse is past the last section in the row 茅藛?insert at start of next row (or end)
    var lastInRow = rowSecs[rowSecs.length - 1];
    var nextId = (ri + 1 < rows.length) ? rows[ri + 1].secs[0].dataset.sectionId : '__end__';
    return { beforeId: nextId, position: region, sidebarSide: sidebarSide, indicEl: lastInRow, indicSide: 'after' };
  }

  function clearIndicators() {
    allSections().forEach(function(el) {
      el.classList.remove('si-drag-before', 'si-drag-after', 'si-drag-row-before', 'si-drag-row-after');
    });
  }

  // Attach move bars to ALL sections including header/footer
  allSections().forEach(function(el) {
    var bar = document.createElement('div');
    bar.className = 'si-move-bar';
    bar.title = 'Drag to move';
    el.appendChild(bar);

    bar.addEventListener('mousedown', function(e) {
      if (e.button !== 0) return;
      e.preventDefault();
      e.stopPropagation();
      dragging = true;
      draggingId = el.dataset.sectionId;
      draggingEl = el;
      el.classList.add('si-dragging');
      el.style.pointerEvents = 'none';
      document.body.style.cursor = 'grabbing';
      showDropZones();
    });
  });

  document.addEventListener('mousemove', function(e) {
    if (!dragging) return;
    clearIndicators();
    currentDrop = findDrop(e.clientX, e.clientY);
    setActiveDropZone(currentDrop);
    if (currentDrop.indicEl) {
      var cls = currentDrop.indicSide === 'before'     ? 'si-drag-before'
              : currentDrop.indicSide === 'after'      ? 'si-drag-after'
              : currentDrop.indicSide === 'row-before' ? 'si-drag-row-before'
              :                                          'si-drag-row-after';
      currentDrop.indicEl.classList.add(cls);
    }
  }, { passive: true });

  document.addEventListener('mouseup', function(e) {
    if (!dragging) return;
    var fromId = draggingId;
    var drop = currentDrop;

    if (draggingEl) {
      draggingEl.classList.remove('si-dragging');
      draggingEl.style.pointerEvents = '';
    }
    dragging = false; draggingId = null; draggingEl = null; currentDrop = null;
    document.body.style.cursor = '';
    clearIndicators();
    hideDropZones();

    if (fromId && drop && drop.beforeId) {
      window.parent.postMessage({
        type: 'section-move',
        fromId: fromId,
        beforeId: drop.beforeId,
        newPosition: drop.position,
        sidebarSide: drop.sidebarSide || ''
      }, '*');
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && dragging) {
      if (draggingEl) {
        draggingEl.classList.remove('si-dragging');
        draggingEl.style.pointerEvents = '';
      }
      dragging = false; draggingId = null; draggingEl = null; currentDrop = null;
      document.body.style.cursor = '';
      clearIndicators();
      hideDropZones();
    }
  });
})();
</script>

<script>
/* 茅藛鹿芒鈥毬┧喡姑⑩€毬?Section column-span resize (left + right handles) 茅藛鹿芒鈥毬┧喡姑⑩€毬?*/
(function() {
  var resizing = false;
  var resizingEl = null;
  var resizingId = null;
  var startColSpan = 1;
  var startLeft = 0;   // element's left edge at drag start (fixed anchor for right handle)
  var startRight = 0;  // element's right edge at drag start (fixed anchor for left handle)
  var snapLine = null;
  var tooltip = null;
  var currentColSpan = 1;
  var resizeDir = 'right';
  var resizeMode = 'section';

  function getColSpan(el) {
    // Prefer the largest-breakpoint class: lg > sm > bare (handles "_spanm" responsive strings)
    var classes = Array.from(el.classList);
    var lg = classes.find(function(c) { return /^lg:col-span-\d+$/.test(c); });
    if (lg) return parseInt(lg.replace('lg:col-span-', ''), 10);
    var sm = classes.find(function(c) { return /^sm:col-span-\d+$/.test(c); });
    if (sm) return parseInt(sm.replace('sm:col-span-', ''), 10);
    var bare = classes.find(function(c) { return /^col-span-\d+$/.test(c); });
    return bare ? parseInt(bare.replace('col-span-', ''), 10) : 12;
  }

  function setColSpan(el, n) {
    // Remove all responsive col-span variants before adding the new one
    Array.from(el.classList)
      .filter(function(c) { return /^(?:(?:sm|md|lg|xl|2xl):)?col-span-\d+$/.test(c); })
      .forEach(function(c) { el.classList.remove(c); });
    el.classList.add('col-span-' + n);
  }

  document.querySelectorAll('[data-section-id]').forEach(function(el) {
    var rHandle = document.createElement('div');
    rHandle.className = 'si-resize-handle';
    rHandle.title = 'Drag to resize width';
    el.appendChild(rHandle);

    var lHandle = document.createElement('div');
    lHandle.className = 'si-lresize-handle';
    lHandle.title = 'Drag to resize width';
    el.appendChild(lHandle);

    function startResize(e, dir) {
      e.preventDefault();
      e.stopPropagation();
      var rect = el.getBoundingClientRect();
      resizing = true;
      resizingEl = el;
      resizingId = el.dataset.sectionId;
      resizeMode = (el.dataset.position || '') === 'sidebar' ? 'sidebar' : 'section';
      startColSpan = resizeMode === 'sidebar'
        ? parseInt(el.dataset.sidebarWidth || (el.closest('aside') && el.closest('aside').dataset.sidebarSpan) || '3', 10)
        : getColSpan(el);
      currentColSpan = startColSpan;
      startLeft = rect.left;
      startRight = rect.right;
      resizeDir = dir;
      el.classList.add('si-resizing');

      snapLine = document.createElement('div');
      snapLine.className = 'si-resize-snap-line';
      document.body.appendChild(snapLine);

      tooltip = document.createElement('div');
      tooltip.className = 'si-resize-tooltip';
      tooltip.textContent = startColSpan + '/12';
      document.body.appendChild(tooltip);
    }

    rHandle.addEventListener('mousedown', function(e) { startResize(e, 'right'); });
    lHandle.addEventListener('mousedown', function(e) { startResize(e, 'left'); });
  });

  document.addEventListener('mousemove', function(e) {
    if (!resizing || !resizingEl) return;
    var grid = resizeMode === 'sidebar'
      ? (resizingEl.closest('[data-region-row]') || resizingEl.closest('main') || resizingEl.parentElement)
      : (resizingEl.closest('.grid-cols-12') || document.getElementById('page-sections-grid') || resizingEl.parentElement);
    if (!grid) return;
    var colW = grid.getBoundingClientRect().width / 12;
    // Right: distance from element's fixed left edge to cursor
    // Left:  distance from cursor to element's initial right edge
    var newW = resizeDir === 'right'
      ? e.clientX - startLeft
      : startRight - e.clientX;
    var n = resizeMode === 'sidebar'
      ? Math.max(2, Math.min(6, Math.round(newW / colW)))
      : Math.max(1, Math.min(12, Math.round(newW / colW)));
    if (n !== currentColSpan) {
      currentColSpan = n;
      if (resizeMode === 'sidebar') {
        var aside = resizingEl.closest('aside');
        if (aside) {
          aside.dataset.sidebarSpan = String(n);
          aside.style.flexBasis = 'calc((100% - 1.5rem) * ' + n + ' / 12)';
          aside.style.maxWidth = aside.style.flexBasis;
        }
        resizingEl.dataset.sidebarWidth = String(n);
      } else {
        setColSpan(resizingEl, n);
      }
    }
    if (resizeDir === 'left') {
      // Shift element right so its right edge stays fixed 茅藛?left edge appears to move
      var tx = (startColSpan - n) * colW;
      resizingEl.style.transform = 'translateX(' + tx + 'px)';
      // Snap line and tooltip at the apparent left edge
      var snapX = startRight - n * colW;
      if (snapLine) { snapLine.style.left = snapX + 'px'; }
      if (tooltip) {
        tooltip.textContent = n + '/12';
        tooltip.style.left = snapX + 'px';
        tooltip.style.top = (resizingEl.getBoundingClientRect().top - 24) + 'px';
      }
    } else {
      resizingEl.style.transform = '';
      var snapX = startLeft + n * colW;
      if (snapLine) { snapLine.style.left = snapX + 'px'; }
      if (tooltip) {
        tooltip.textContent = n + '/12';
        tooltip.style.left = snapX + 'px';
        tooltip.style.top = (resizingEl.getBoundingClientRect().top - 24) + 'px';
      }
    }
  }, { passive: true });

  document.addEventListener('mouseup', function() {
    if (!resizing) return;
    if (snapLine) { snapLine.remove(); snapLine = null; }
    if (tooltip)  { tooltip.remove();  tooltip = null; }
    if (resizingEl) {
      resizingEl.classList.remove('si-resizing');
      resizingEl.style.transform = '';
    }
    if (resizingId && currentColSpan !== startColSpan && resizeMode === 'sidebar') {
      window.parent.postMessage({ type: 'section-sidebar-width', id: resizingId, sidebar_width: currentColSpan }, '*');
    } else if (resizingId && currentColSpan !== startColSpan) {
      window.parent.postMessage({ type: 'section-resize', id: resizingId, col_span: currentColSpan }, '*');
    }
    resizing = false;
    resizingEl = null;
    resizingId = null;
    resizeMode = 'section';
  });
})();
</script>

<script>
/* 茅藛鹿芒鈥毬┧喡姑⑩€毬?Section vertical height resize (top + bottom handles) 茅藛鹿芒鈥毬┧喡姑⑩€毬?*/
(function() {
  var vresizing = false;
  var vresizingEl = null;
  var vresizingId = null;
  var startY = 0;
  var startH = 0;
  var hline = null;
  var vtip = null;
  var currentH = 0;
  var vresizeDir = 'bottom';

  document.querySelectorAll('[data-section-id]').forEach(function(el) {
    var bHandle = document.createElement('div');
    bHandle.className = 'si-vresize-handle';
    bHandle.title = 'Drag to resize height';
    el.appendChild(bHandle);

    var tHandle = document.createElement('div');
    tHandle.className = 'si-tresize-handle';
    tHandle.title = 'Drag to resize height';
    el.appendChild(tHandle);

    function startVResize(e, dir) {
      e.preventDefault();
      e.stopPropagation();
      vresizing = true;
      vresizingEl = el;
      vresizingId = el.dataset.sectionId;
      startY = e.clientY;
      startH = el.getBoundingClientRect().height;
      currentH = startH;
      vresizeDir = dir;
      el.classList.add('si-vresizing');

      hline = document.createElement('div');
      hline.className = 'si-vresize-hline';
      hline.style.top = e.clientY + 'px';
      document.body.appendChild(hline);

      vtip = document.createElement('div');
      vtip.className = 'si-vresize-tip';
      vtip.textContent = Math.round(startH) + 'px';
      vtip.style.top = (e.clientY + 6) + 'px';
      vtip.style.left = (e.clientX + 12) + 'px';
      document.body.appendChild(vtip);
    }

    bHandle.addEventListener('mousedown', function(e) { startVResize(e, 'bottom'); });
    tHandle.addEventListener('mousedown', function(e) { startVResize(e, 'top'); });
  });

  document.addEventListener('mousemove', function(e) {
    if (!vresizing || !vresizingEl) return;
    var delta = vresizeDir === 'bottom'
      ? e.clientY - startY        // bottom: drag down = taller
      : startY - e.clientY;       // top:    drag up   = taller
    var newH = Math.max(40, startH + delta);
    currentH = newH;
    vresizingEl.style.height = newH + 'px';
    vresizingEl.style.minHeight = newH + 'px';
    vresizingEl.style.overflow = 'hidden';
    if (vresizeDir === 'top') {
      // Shift element down so its bottom edge stays fixed 茅藛?top edge appears to move
      var ty = startH - newH;
      vresizingEl.style.transform = 'translateY(' + ty + 'px)';
      // Guide line follows the apparent top edge (getBoundingClientRect accounts for transform)
      if (hline) hline.style.top = vresizingEl.getBoundingClientRect().top + 'px';
    } else {
      vresizingEl.style.transform = '';
      if (hline) hline.style.top = e.clientY + 'px';
    }
    if (vtip) {
      vtip.textContent = Math.round(newH) + 'px';
      vtip.style.top = (e.clientY + 6) + 'px';
      vtip.style.left = (e.clientX + 12) + 'px';
    }
  }, { passive: true });

  document.addEventListener('mouseup', function() {
    if (!vresizing) return;
    if (hline) { hline.remove(); hline = null; }
    if (vtip)  { vtip.remove();  vtip = null; }
    if (vresizingEl) {
      vresizingEl.classList.remove('si-vresizing');
      vresizingEl.style.height = '';
      vresizingEl.style.minHeight = Math.round(currentH) + 'px';
      vresizingEl.style.overflow = '';
      vresizingEl.style.transform = '';
    }
    if (vresizingId && Math.abs(currentH - startH) > 4) {
      window.parent.postMessage({ type: 'section-height', id: vresizingId, min_height: Math.round(currentH) }, '*');
    }
    vresizing = false;
    vresizingEl = null;
    vresizingId = null;
  });
})();
</script>

