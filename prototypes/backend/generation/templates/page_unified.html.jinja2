    footerEl.className = 'mt-8';
    footerEl.style.cssText = 'background:var(--region-footer-bg);color:var(--region-footer-text);';
    if ('{{ _footer_width }}' !== 'contained') {
      footerEl.style.cssText += 'width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);';
    }
    var footerInner = document.createElement('div');
    footerInner.className = ('{{ _footer_width }}' === 'contained' ? '{{ _container_class }} mx-auto ' : 'w-full ') + 'grid grid-cols-12 gap-4 px-8 py-6 border-t-4';
    footerInner.style.borderColor = getComputedStyle(document.documentElement).getPropertyValue('--accent') || '#2563eb';
    byPos.footer.forEach(function(el) { footerInner.appendChild(el); });
    footerEl.appendChild(footerInner);
    wrap.appendChild(footerEl);
  }
  parent.replaceChild(wrap, grid);
})();
</script>

<script>
(function() {
  var kw = {
    success: /\b(active|approved|success|paid|completed|confirmed|verified|enabled|done|shipped)\b/i,
    error:   /\b(rejected|failed|error|cancelled|canceled|declined|inactive|disabled|expired|denied)\b/i,
    warning: /\b(pending|processing|draft|review|waiting|hold|queued)\b/i,
  };
  document.querySelectorAll('.si-badge').forEach(function(el) {
    var t = el.textContent.trim();
    if (kw.success.test(t))      { el.className = 'si-badge si-badge-success'; }
    else if (kw.error.test(t))   { el.className = 'si-badge si-badge-error'; }
    else if (kw.warning.test(t)) { el.className = 'si-badge si-badge-warning'; }
    else                         { el.className = 'si-badge si-badge-neutral'; }
  });
})();
</script>

