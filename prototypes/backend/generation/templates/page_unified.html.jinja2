{%- set _glay   = 'card'   if eff_lay in ('card','product-carousel','category-grid','hero-banner') else
                  ('list'   if eff_lay in ('list','product-list','item-list') else
                  ('form'   if eff_lay in ('form','auth-form','form-step','summary-panel') else
