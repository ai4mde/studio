      <div class="si-field" data-field-name="{{ attribute }}">
        <label class="si-field-label block text-sm font-medium text-gray-700 mb-1">{{ attribute }}</label>
        {%- if attribute.type == AttributeType.BOOLEAN %}
        <input type="checkbox" class="h-4 w-4 rounded" />
        {%- elif attribute.type == AttributeType.INTEGER %}
        <input type="number" placeholder="{{ attribute }}" class="w-full border border-gray-300 {{ r }} px-3 py-2 text-sm {{ c.ring }} focus:outline-none focus:ring-2" />
        {%- elif attribute.type == AttributeType.ENUM %}
        <select class="w-full border border-gray-300 {{ r }} px-3 py-2 text-sm {{ c.ring }} focus:outline-none focus:ring-2">
          {%- for lit in attribute.enum_literals %}<option>{{ lit }}</option>{%- endfor %}
        </select>
        {%- elif attribute.type == AttributeType.IMAGE %}
        <input type="file" accept="image/*" class="w-full border border-gray-300 {{ r }} px-3 py-2 text-sm" />
        {%- elif attribute.type == AttributeType.VIDEO %}
        <input type="file" accept="video/*" class="w-full border border-gray-300 {{ r }} px-3 py-2 text-sm" />
        {%- else %}
        <input type="text" placeholder="{{ attribute }}" class="w-full border border-gray-300 {{ r }} px-3 py-2 text-sm {{ c.ring }} focus:outline-none focus:ring-2" />
        {%- endif %}
      </div>
