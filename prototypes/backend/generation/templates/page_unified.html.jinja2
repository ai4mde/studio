{% if preview_mode -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  {%- set _font_cdn = tokens.get('page.font.cdn', '') %}
  {%- if _font_cdn %}<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="{{ _font_cdn }}">{% endif %}
  <style>
    {% include "helpers/unified_page_styles.css.jinja2" %}
  </style>
  {%- set _page_title = page.display_name if page.display_name is defined and page.display_name else (page.name if page.name is defined and page.name else application_name) %}
  <title>{{ _page_title }}</title>
</head>
<body class="min-h-screen">
{%- set _accent_hex = tokens.get('accent.hex', '#0000a4') %}
{%- set _brand_name = tokens.get('brand.name', 'App') %}
{%- set _container_class = tokens.get('page.container.class', 'max-w-6xl') %}
{%- set _raw_page_layout = page.layout if page.layout is defined and page.layout else {} %}
{%- set _main_width = _raw_page_layout.main_width if _raw_page_layout.main_width is defined and _raw_page_layout.main_width else tokens.get('page.main_width', 'contained') %}
{%- set _header_width = _raw_page_layout.header_width if _raw_page_layout.header_width is defined and _raw_page_layout.header_width else tokens.get('page.header_width', 'contained') %}
{%- set _hero_width = _raw_page_layout.hero_width if _raw_page_layout.hero_width is defined and _raw_page_layout.hero_width else tokens.get('page.hero_width', 'contained') %}
{%- set _footer_width = _raw_page_layout.footer_width if _raw_page_layout.footer_width is defined and _raw_page_layout.footer_width else tokens.get('page.footer_width', 'contained') %}
{%- set _sidebar_bg = _raw_page_layout.sidebar_bg if _raw_page_layout.sidebar_bg is defined else '' %}
{%- set _sidebar_shadow = _raw_page_layout.sidebar_shadow if _raw_page_layout.sidebar_shadow is defined else '' %}
{%- set _layout_has_sidebar = [] %}
{%- set _layout_has_header = [] %}
{%- for _layout_sc in page.section_components %}
  {%- if _layout_sc.position == 'sidebar' %}{% set _ = _layout_has_sidebar.append(1) %}{%- endif %}
  {%- if _layout_sc.position == 'header' %}{% set _ = _layout_has_header.append(1) %}{%- endif %}
{%- endfor %}
{%- if not _main_width or _main_width not in ['contained', 'wide', 'full'] %}{% set _main_width = 'contained' %}{%- endif %}
{%- if not _header_width or _header_width not in ['contained', 'full'] %}{% set _header_width = 'contained' %}{%- endif %}
{%- if not _footer_width or _footer_width not in ['contained', 'full'] %}{% set _footer_width = 'contained' %}{%- endif %}
{%- set _main_container_class = 'max-w-none w-full' if _main_width == 'full' else ('max-w-7xl' if _main_width == 'wide' else _container_class) %}
{%- set _header_shell_class = 'w-full px-6' if _header_width == 'full' else _container_class ~ ' mx-auto px-6' %}
{%- set _btn_style = tokens.get('theme.button.style', 'solid') %}
{%- set _btn_solid  = 'text-white font-semibold px-4 py-2 si-btn shadow-sm transition-opacity hover:opacity-90' %}
{%- set _btn_outline = 'font-semibold px-4 py-2 si-btn border-2 bg-transparent transition-colors hover:bg-opacity-10' %}
{%- set _btn_ghost  = 'font-semibold px-4 py-2 si-btn bg-transparent hover:bg-gray-100 transition-colors' %}
{%- set _btn_gradient = 'text-white font-semibold px-4 py-2 si-btn shadow-sm transition-opacity hover:opacity-90' %}
{%- set _all_page_names = [] %}
{%- set _activity_page_names = [] %}
{%- for _known_page in (all_pages or []) %}
  {%- set _known_name = (_known_page.name if _known_page.name is defined else _known_page)|string %}
  {%- if _known_name and _known_name not in _all_page_names %}{% set _ = _all_page_names.append(_known_name) %}{%- endif %}
  {%- if _known_name and ((_known_page.type is defined and _known_page.type == 'activity') or (_known_page.is_task_page is defined and _known_page.is_task_page)) and _known_name not in _activity_page_names %}{% set _ = _activity_page_names.append(_known_name) %}{%- endif %}
{%- endfor %}
{%- macro nav_href_attrs(target_page) -%}
{%- if target_page == '__task_home__' and preview_mode -%}
href="#" data-nav-page="Task" onclick="window.parent.postMessage({type:'navigate-page',page:'Task'},'*');return false;"
{%- elif preview_mode -%}
href="#" data-nav-page="{{ target_page }}" onclick="window.parent.postMessage({type:'navigate-page',page:'{{ target_page }}'},'*');return false;"
{%- elif target_page == '__task_home__' -%}
href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}"
{%- elif target_page and target_page|string in _activity_page_names -%}
href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}"
{%- elif not target_page or target_page|string not in _all_page_names -%}
href="#"
{%- else -%}
href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ target_page }}' {% raw %}%}{% endraw %}"
{%- endif -%}
{%- endmacro %}
{%- set _header_chrome = ['promo-bar','promo-strip','logo','search-bar','icon-actions','nav','nav-links','nav-bar','main-header','minimal-header','commerce-header','dashboard-header','split-header','app-header','compact-header','mega-header','hero-header','tabbed-header','glass-header','command-header','site-nav'] %}
{%- set _footer_chrome = ['service-bar','service-strip','link-grid','footer-links','brand-strip','footer-brand','site-footer','compact-footer','legal-footer','newsletter-footer','social-footer','mega-footer','split-footer','app-footer','cta-footer','minimal-footer'] %}
{%- set _header_secs = [] %}
{%- set _footer_secs = [] %}
{%- set _has_header_chrome = [] %}
{%- set _nav_pages = [] %}
{%- set _nav_page_keys = [] %}
{%- set _task_nav_available = [] %}
{%- if page.is_task_page is defined and page.is_task_page %}
  {%- set _ = _task_nav_available.append(true) %}
{%- endif %}
{%- for _p in (all_pages or []) %}
  {%- if _p.type == 'activity' or (_p.is_task_page is defined and _p.is_task_page) %}
    {%- set _ = _task_nav_available.append(true) %}
  {%- endif %}
  {%- if _p.type != 'activity' and not (_p.is_task_page is defined and _p.is_task_page) %}
    {%- set _p_key = (_p.name if _p.name is defined else _p)|string %}
    {%- if _p_key not in _nav_page_keys %}
      {%- set _ = _nav_page_keys.append(_p_key) %}
      {%- set _ = _nav_pages.append(_p) %}
    {%- endif %}
  {%- endif %}
{%- endfor %}
{%- for _sc in page.section_components %}
  {%- if _sc.layout in ['activity_start', 'activity_tasks'] or _sc.component_type in ['activity_start', 'activity_tasks'] %}
    {%- set _ = _task_nav_available.append(true) %}
  {%- endif %}
{%- endfor %}
{%- if _task_nav_available and '__task_home__' not in _nav_page_keys %}
  {%- set _ = _nav_page_keys.append('__task_home__') %}
  {%- set _ = _nav_pages.append({'name': '__task_home__', 'display_name': 'Tasks', 'type': 'normal'}) %}
{%- endif %}
{%- for sc in page.section_components %}
  {%- if sc.layout in _header_chrome or sc.position == 'header' %}
    {%- set _ = _has_header_chrome.append(sc) %}
    {%- set _ = _header_secs.append(sc) %}
  {%- elif sc.layout in _footer_chrome or sc.position == 'footer' %}
    {%- set _ = _footer_secs.append(sc) %}
  {%- endif %}
{%- endfor %}
{%- if _has_header_chrome %}
  {%- set _header_secs = [] %}
{%- endif %}
{%- if _footer_secs %}
  {%- set _footer_secs = [] %}
{%- endif %}

{# 鈹€鈹€ HEADER CHROME ROWS 鈹€鈹€ #}
{%- set _main_row_open = [] %}
{%- for sc in _header_secs %}
{%- set _inline_lay = sc.layout in ('logo', 'search-bar', 'icon-actions') %}
{%- if _inline_lay and not _main_row_open %}
  {%- set _ = _main_row_open.append(1) %}
  {%- set _row_style = sc.style if sc.style is defined and sc.style else {} %}
  {%- set _row_variant = _row_style.get('header_variant', '') %}
<header class="{% if _row_variant == 'split-dark' %}px-6 py-3 flex items-center gap-4 shadow-sm{% elif _row_variant == 'showcase' %}bg-white px-8 py-5 flex items-center gap-5 border-b border-gray-100 shadow-sm{% else %}bg-white px-6 py-3 flex items-center gap-4{% endif %}" style="{% if _row_variant == 'split-dark' %}background-color:#111827;color:#ffffff;{% endif %}" data-position="header" data-layout="main-header-row" data-header-variant="{{ _row_variant }}">
{%- elif not _inline_lay and _main_row_open %}
  {%- set _ = _main_row_open.clear() %}
</header>
{%- endif %}

{# 鈹€鈹€ ACTIVITY ACTION 鈹€鈹€ #}
{%- if sc.component_type == 'activity_action' %}
{%- set _aa_action = sc.workflow_action or 'complete' %}
{%- set _aa_target_page = sc.workflow_target_page %}
{%- set _aa_target_is_activity = namespace(value=false) %}
{%- for _target_page in all_pages %}
  {%- if _aa_target_page and _target_page.name == _aa_target_page and _target_page.type == 'activity' %}
    {%- set _aa_target_is_activity.value = true %}
  {%- endif %}
{%- endfor %}
{%- if _aa_target_page and _aa_target_is_activity.value %}
  {%- set _aa_target_url = '/' ~ application_name ~ '/render_' ~ application_name ~ '_' ~ _aa_target_page %}
{%- elif _aa_target_page %}
  {%- set _aa_target_url %}{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ _aa_target_page }}' {% raw %}%}{% endraw %}{%- endset %}
{%- else %}
  {%- set _aa_target_url = '' %}
{%- endif %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="activity_action" class="px-6 py-3 bg-white border-b border-gray-100">
  <div class="flex justify-end">
    {%- if page.type == 'activity' and not preview_mode %}
    {%- if _aa_action == 'navigate' and _aa_target_url and _aa_target_is_activity.value %}
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:redirect_to_process_page' active_process_node_id {% raw %}%}{% endraw %}" method="get">
      <input type="hidden" name="target_url" value="{{ _aa_target_url }}">
      <button type="submit" class="si-btn si-btn-primary bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-xl shadow transition-colors">{{ sc.label }}</button>
    </form>
    {%- elif _aa_action == 'navigate' and _aa_target_url %}
    <a href="{{ _aa_target_url }}" class="si-btn si-btn-primary bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-xl shadow transition-colors">{{ sc.label }}</a>
    {%- else %}
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
      {%- if _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url and _aa_target_is_activity.value %}<input type="hidden" name="next_url" value="{{ _aa_target_url }}">{%- elif _aa_action in ('complete_then_page', 'complete_then_target') and _aa_target_url %}<input type="hidden" name="next" value="{{ _aa_target_url }}">{%- endif %}
      <button type="submit" class="si-btn si-btn-primary bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-xl shadow transition-colors">{{ sc.label }}</button>
    </form>
    {%- endif %}
    {%- else %}
    <button type="button" class="si-btn si-btn-primary bg-green-600 text-white font-semibold py-2 px-4 rounded-xl shadow opacity-75 cursor-default">{{ sc.label }}</button>
    {%- endif %}
  </div>
</div>

{# 鈹€鈹€ PROMO BAR 鈹€鈹€ #}
{%- elif sc.layout in ('promo-bar', 'promo-strip') %}
{%- set _sc_style = sc.style if sc.style is defined and sc.style else {} %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="{{ sc.layout }}" data-nav-height="{{ _sc_style.get('nav_height', _sc_style.get('density', 'normal')) }}">
<div style="background-color:var(--region-header-bg);color:var(--region-header-text);" class="px-6 py-1.5 flex items-center justify-between text-xs select-none">
  <div class="flex items-center gap-6">
    {%- for m in sc.custom_methods[:3] %}
    <span>{{ m }}</span>
    {%- endfor %}
  </div>
  {%- if sc.text %}<span>{{ sc.text }}</span>{%- endif %}
</div>
</div>

{# 鈹€鈹€ LOGO 鈹€鈹€ #}
{%- elif sc.layout == 'logo' %}
{%- set _sc_style = sc.style if sc.style is defined and sc.style else {} %}
{%- set _logo_url = _sc_style.get('logo_url') or _sc_style.get('image_url') or tokens.get('brand.logo_url', '') %}
{%- set _logo_size_px = {'sm':'28','md':'36','lg':'48','xl':'60'}.get(_sc_style.get('logo_size', 'md'), '36') %}
{%- set _logo_shape = _sc_style.get('logo_shape', 'rounded') %}
{%- set _logo_variant = _sc_style.get('logo_variant', 'lockup') %}
{%- set _tagline = _sc_style.get('tagline') or _sc_style.get('subtitle') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="logo">
  <a href="#" class="inline-flex items-center gap-3 leading-none min-w-0">
    {%- if _logo_url %}
    <img src="{{ _logo_url }}" alt="{{ sc.text or _brand_name }}" class="shrink-0 object-cover {% if _logo_shape == 'circle' %}rounded-full{% elif _logo_shape == 'square' %}rounded-md{% else %}rounded-xl{% endif %}" style="width:{{ _logo_size_px }}px;height:{{ _logo_size_px }}px;">
    {%- endif %}
    {%- if _logo_variant != 'image-only' %}
    <span class="flex flex-col min-w-0">
      <span class="text-3xl font-black truncate" style="color:{% if _sc_style.get('header_variant') == 'split-dark' or _sc_style.get('bg') == 'dark' %}#ffffff{% else %}{{ _accent_hex }}{% endif %};font-family:'Georgia',serif;letter-spacing:-1px;">{{ sc.text or _sc_style.get('logo_text') or _brand_name }}{% if _sc_style.get('dot', false) not in [false, 'false', '0', 'no'] %}.{% endif %}</span>
      {%- if _tagline %}<span class="text-xs font-medium {% if _sc_style.get('header_variant') == 'split-dark' or _sc_style.get('bg') == 'dark' %}text-gray-300{% else %}text-gray-500{% endif %} mt-1 truncate">{{ _tagline }}</span>{%- endif %}
    </span>
    {%- endif %}
  </a>
</div>

{# 鈹€鈹€ SEARCH BAR 鈹€鈹€ #}
{%- elif sc.layout == 'search-bar' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="search-bar" class="flex-1">
  {%- set _sc_style = sc.style if sc.style is defined and sc.style else {} %}
  <form action="#" method="get" class="flex items-center rounded-full border-2 overflow-hidden {% if _sc_style.get('header_variant') == 'split-dark' %}bg-white/95{% endif %}" style="border-color:var(--input-border-focus);background-color:var(--input-bg);">
    <input name="q" class="flex-1 px-4 py-2.5 text-sm outline-none si-input" style="border:none;border-radius:0;" placeholder="{{ sc.text or sc.display_name }}" type="search" value="" />
    <button type="submit" class="px-4 py-3" style="background-color:var(--input-border-focus);">
      <svg class="w-4 h-4" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </button>
  </form>
</div>

{# 鈹€鈹€ ICON ACTIONS 鈹€鈹€ #}
{%- elif sc.layout == 'icon-actions' %}
{%- set _sc_style = sc.style if sc.style is defined and sc.style else {} %}
{%- set _action_variant = _sc_style.get('action_variant', 'link') %}
{%- set _show_logout = _sc_style.get('show_logout', true) not in [false, 'false', '0', 'no', 'hidden'] %}
{%- set _logout_label = _sc_style.get('logout_label', 'Logout') %}
{%- set _action_cls = 'si-btn si-btn-primary px-3 py-2 text-sm font-semibold' if _action_variant == 'button' else ('si-btn si-btn-ghost px-3 py-2 text-sm font-semibold' if _action_variant == 'ghost' else 'cursor-pointer hover:opacity-75 whitespace-nowrap') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="icon-actions">
  <div class="flex items-center justify-end gap-3 text-sm {% if _sc_style.get('header_variant') == 'split-dark' or _sc_style.get('bg') == 'dark' %}text-white{% else %}text-gray-700{% endif %} shrink-0">
    {%- if sc.custom_methods %}
    {%- for m in sc.custom_methods %}
    <span class="{{ _action_cls }}">{{ m }}</span>
    {%- endfor %}
    {%- else %}
    {%- if _show_logout %}<a href="#" class="{{ _action_cls }}">{{ _logout_label }}</a>{%- endif %}
    <span class="cursor-pointer hover:opacity-75"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span>
    <span class="relative cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
    </span>
    {%- endif %}
  </div>
</div>

{# 鈹€鈹€ MAIN HEADER 鈹€鈹€ #}
{%- elif sc.layout == 'main-header' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="main-header">
<div style="background-color:var(--region-header-bg);color:var(--region-header-text);" class="px-6 py-1 flex items-center justify-between text-xs select-none">
  <span style="font-weight:600;letter-spacing:.05em;">{{ _brand_name | upper }}</span>
</div>
<header class="bg-white px-6 py-3 flex items-center gap-4">
  <a href="#" class="text-3xl font-black shrink-0 leading-none" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-1px;">{{ _brand_name }}</a>
  <form action="#" method="get" class="flex-1 flex items-center rounded-full border-2 overflow-hidden" style="border-color:var(--input-border-focus);background-color:var(--input-bg);">
    <input name="q" class="flex-1 px-4 py-2.5 text-sm outline-none si-input" style="border:none;border-radius:0;" placeholder="{{ sc.text or 'Search' }}" type="search" value="" />
    <button type="submit" class="px-4 py-3" style="background-color:var(--input-border-focus);"><svg class="w-4 h-4" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>
  </form>
  <div class="flex items-center gap-5 text-sm text-gray-700 shrink-0">
    <a href="#" class="cursor-pointer hover:opacity-75 whitespace-nowrap">Logout</a>
    <span class="cursor-pointer hover:opacity-75"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span>
    <span class="relative cursor-pointer"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></span>
  </div>
</header>
</div>

{# 鈹€鈹€ COMMERCE HEADER 鈹€鈹€ #}
{%- elif sc.layout == 'commerce-header' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="commerce-header">
<div class="text-center text-xs py-1.5 font-medium text-white select-none" style="background-color:{{ _accent_hex }};">{{ sc.text or 'Free shipping on orders over $50' }}</div>
<header class="bg-white px-6 py-3 flex items-center gap-4 border-b border-gray-100">
  <a href="#" class="text-2xl font-black shrink-0" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-1px;">{{ _brand_name }}</a>
  <form action="#" method="get" class="flex-1 flex items-center bg-gray-100 rounded-lg overflow-hidden">
    <input name="q" class="flex-1 px-4 py-2 text-sm outline-none bg-transparent si-input" placeholder="{{ sc.text or 'Search products' }}" type="search" value="" />
    <button type="submit" class="px-3 py-2 text-gray-500 hover:text-gray-800"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>
  </form>
  <div class="flex items-center gap-4 shrink-0 text-gray-600">
    <span class="cursor-pointer hover:opacity-75 text-sm">Account</span>
    <span class="cursor-pointer hover:opacity-75 text-sm">Wishlist</span>
    <span class="relative cursor-pointer"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg><span class="absolute -top-1.5 -right-1.5 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center font-bold" style="background-color:{{ _accent_hex }};">0</span></span>
  </div>
</header>
<nav class="bg-white border-b border-gray-200 px-6 py-0 overflow-x-auto">
  <div class="flex items-center gap-0 whitespace-nowrap text-sm">
