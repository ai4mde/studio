  {%- set _mock_ratings = ['4.9','4.6','4.5','4.7','4.8','4.8'] -%}
  {%- set _mock_weights = ['1.51','1.86','0.21','0.23','0.19','0.25'] -%}
  {%- set _mock_stock = ['15','8','33','42','28','67'] -%}
  {%- set _row = mock_row % 6 -%}
  {%- if 'product_id' in _aname or _aname == 'productid' -%}
