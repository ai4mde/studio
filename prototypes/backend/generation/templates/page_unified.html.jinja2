{# 鈹€鈹€ IMAGE ATTRIBUTES 鈹€鈹€ #}
{%- set _iattrs = [] %}
{%- set _vattrs = [] %}
{%- set _tattrs = [] %}
{%- set _intattrs = [] %}
{%- for _attr in section_component.attributes %}
  {%- set _al = (_attr|string)|lower %}
  {%- set _image_like = ('image' in _al or 'img' in _al or 'photo' in _al or 'avatar' in _al or 'thumbnail' in _al or 'thumb' in _al or 'poster' in _al or 'cover' in _al or 'logo' in _al) %}
  {%- set _video_like = ('video' in _al or 'trailer' in _al or 'media_url' in _al) %}
  {%- if _attr.type == AttributeType.IMAGE or _image_like %}
    {%- set _ = _iattrs.append(_attr) %}
  {%- elif _attr.type == AttributeType.VIDEO or _video_like %}
    {%- set _ = _vattrs.append(_attr) %}
  {%- elif _attr.type == AttributeType.INTEGER %}
    {%- set _ = _intattrs.append(_attr) %}
  {%- else %}
    {%- set _ = _tattrs.append(_attr) %}
  {%- endif %}
{%- endfor %}
{%- set _mattrs   = _iattrs + _vattrs %}
{%- set _fl = section_component.field_layout or {} %}
{%- set _fl_secondary_raw = _fl.get('secondary') or [] %}
{%- set _fl_columns_raw = _fl.get('columns') or _fl.get('fields') or [] %}
{%- set _fl_hero_raw = _fl.get('hero') or [] %}
{%- set _fl_hidden_raw = _fl.get('hidden') or [] %}
{%- set _fl_secondary_names = [_fl_secondary_raw] if _fl_secondary_raw is string else _fl_secondary_raw %}
{%- set _fl_columns_names = [_fl_columns_raw] if _fl_columns_raw is string else _fl_columns_raw %}
{%- set _fl_hero_names = [_fl_hero_raw] if _fl_hero_raw is string else _fl_hero_raw %}
{%- set _fl_hidden_names = [_fl_hidden_raw] if _fl_hidden_raw is string else _fl_hidden_raw %}
{%- set _slot = namespace(image=None, video=None, media=None, title=None, subtitle=None, primary=None, secondary=[], columns=[], hero=[]) %}
{%- for _attr in section_component.attributes %}
  {%- set _an = _attr|string %}
  {%- set _fcfg = (_fl.get('field_styles') or {}).get(_an) or {} %}
  {%- if _an not in _fl_hidden_names and _fcfg.get('visible') != 'hidden' %}
    {%- if _fl.get('image') and _an == _fl.get('image') %}{%- set _slot.image = _attr %}{%- endif %}
    {%- if _fl.get('video') and _an == _fl.get('video') %}{%- set _slot.video = _attr %}{%- endif %}
    {%- if _fl.get('media') and _an == _fl.get('media') %}{%- set _slot.media = _attr %}{%- endif %}
    {%- if _fl.get('title') and _an == _fl.get('title') %}{%- set _slot.title = _attr %}{%- endif %}
    {%- if _fl.get('subtitle') and _an == _fl.get('subtitle') %}{%- set _slot.subtitle = _attr %}{%- endif %}
    {%- if _fl.get('primary') and _an == _fl.get('primary') %}{%- set _slot.primary = _attr %}{%- endif %}
    {%- if _an in _fl_secondary_names %}{%- set _ = _slot.secondary.append(_attr) %}{%- endif %}
    {%- if _an in _fl_columns_names %}{%- set _ = _slot.columns.append(_attr) %}{%- endif %}
    {%- if _an in _fl_hero_names %}{%- set _ = _slot.hero.append(_attr) %}{%- endif %}
  {%- endif %}
{%- endfor %}
{%- set _visible_attrs = [] %}
{%- for _attr in section_component.attributes %}
  {%- set _an = _attr|string %}
  {%- set _fcfg = (_fl.get('field_styles') or {}).get(_an) or {} %}
  {%- if _an not in _fl_hidden_names and _fcfg.get('visible') != 'hidden' %}{%- set _ = _visible_attrs.append(_attr) %}{%- endif %}
{%- endfor %}
{%- set _visible_tattrs = [] %}
{%- for _attr in _tattrs %}
  {%- if _attr in _visible_attrs %}{%- set _ = _visible_tattrs.append(_attr) %}{%- endif %}
{%- endfor %}
{%- set _visible_mattrs = [] %}
{%- for _attr in _mattrs %}
  {%- if _attr in _visible_attrs %}{%- set _ = _visible_mattrs.append(_attr) %}{%- endif %}
{%- endfor %}
{%- set _title_attr = _slot.title or (_visible_tattrs[0] if _visible_tattrs else (_visible_attrs[0] if _visible_attrs else none)) %}
{%- set _image_attr = _slot.image or (_iattrs[0] if _iattrs else none) %}
{%- set _video_attr = _slot.video or (_vattrs[0] if _vattrs else none) %}
{%- set _media_attr = _slot.media or _video_attr or _image_attr %}
{%- set _static_image_url = _s.get('image_url') or _s.get('src') or _s.get('background_image') or _s.get('background_url') %}
{%- set _primary_attr = _slot.primary or (_visible_tattrs[1] if _visible_tattrs|length > 1 else none) %}
{%- set _secondary_attrs = _slot.secondary if _slot.secondary else (_visible_tattrs[2:5] if _visible_tattrs|length > 2 else []) %}
{%- set _column_attrs = _slot.columns if _slot.columns else _visible_attrs %}
{%- set _detail_attrs = (_slot.hero + _slot.columns) if (_slot.hero or _slot.columns) else _visible_attrs %}
{%- set _form_attrs = _slot.columns if _slot.columns else _visible_attrs %}
{%- set _card_ns = namespace(attrs=[]) %}
{%- for _attr in _visible_mattrs + [_title_attr, _slot.subtitle, _primary_attr] + _secondary_attrs %}
  {%- if _attr and _attr not in _card_ns.attrs %}{%- set _ = _card_ns.attrs.append(_attr) %}{%- endif %}
{%- endfor %}
{%- set _card_attrs = _card_ns.attrs if _card_ns.attrs else section_component.attributes %}
