    {%- set label = _mock_ratings[_row] -%}
  {%- elif 'weight' in _aname -%}
    {%- set label = _mock_weights[_row] -%}
  {%- elif 'price' in _aname or 'cost' in _aname or 'amount' in _aname or 'total' in _aname or 'fee' in _aname -%}
    {%- set label = _mock_prices[_row] -%}
  {%- elif 'name' in _aname or 'title' in _aname or 'label' in _aname or 'product' in _aname -%}
