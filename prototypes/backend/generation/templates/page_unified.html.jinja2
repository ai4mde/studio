{% if preview_mode -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>{{ page.display_name }} â€” Preview</title>
</head>
<body class="{{ tokens.get('page.body.bg', 'bg-gray-50') }} min-h-screen font-sans {{ tokens.get('page.body.text', 'text-gray-800') }}">
{%- set _accent_hex = tokens.get('accent.hex', '#0000a4') %}
{%- set _brand_name = tokens.get('brand.name', 'App') %}
{%- set _header_chrome = ['promo-bar','promo-strip','logo','search-bar','icon-actions','nav-links','nav-bar','main-header','minimal-header','site-nav'] %}
{%- set _footer_chrome = ['service-bar','service-strip','link-grid','footer-links','brand-strip','footer-brand','site-footer'] %}
{%- set _header_secs = [] %}
{%- set _footer_secs = [] %}
{%- for sc in page.section_components %}
  {%- if sc.position == 'header' and sc.layout in _header_chrome %}{% set _ = _header_secs.append(sc) %}{%- endif %}
  {%- if sc.position == 'footer' and sc.layout in _footer_chrome %}{% set _ = _footer_secs.append(sc) %}{%- endif %}
{%- endfor %}

{# â”€â”€ header chrome: render all header-position section components â”€â”€
   Granular row logic: logo + search-bar + icon-actions are opened/closed in
   a shared flex row; all other header layouts are full-width blocks.
#}
{%- set _main_row_open = [] %}
{%- for sc in _header_secs %}
{%- set _inline_lay = sc.layout in ('logo', 'search-bar', 'icon-actions') %}
{%- if _inline_lay and not _main_row_open %}
  {%- set _ = _main_row_open.append(1) %}
<header class="bg-white px-6 py-3 flex items-center gap-4" data-position="header" data-layout="main-header-row">
{%- elif not _inline_lay and _main_row_open %}
  {%- set _ = _main_row_open.clear() %}
</header>
{%- endif %}

{# â”€â”€ ACTIVITY ACTION (header-position workflow button) â”€â”€ #}
{%- if sc.component_type == 'activity_action' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="activity_action" class="px-6 py-3 bg-white border-b border-gray-100">
  <div class="flex justify-end">
    {%- if page.type == 'activity' and not preview_mode %}
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
      <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-xl shadow transition-colors">{{ sc.label }}</button>
    </form>
    {%- else %}
    <button type="button" class="bg-green-600 text-white font-semibold py-2 px-4 rounded-xl shadow opacity-75 cursor-default">{{ sc.label }}</button>
    {%- endif %}
  </div>
</div>

{# â”€â”€ PROMO BAR (promo-bar / promo-strip) â”€â”€ #}
{%- elif sc.layout in ('promo-bar', 'promo-strip') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="{{ sc.layout }}">
<div style="background-color:{{ _accent_hex }};" class="px-6 py-1.5 flex items-center justify-between text-xs text-white select-none">
  <div class="flex items-center gap-6">
    {%- for m in sc.custom_methods[:3] %}
    <span>{{ m }}</span>
    {%- endfor %}
  </div>
  {%- if sc.text %}<span>{{ sc.text }}</span>{%- endif %}
</div>
</div>

{# â”€â”€ LOGO (inline inside main-header-row) â”€â”€ #}
{%- elif sc.layout == 'logo' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="logo">
  <a href="#" class="text-3xl font-black shrink-0 leading-none" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-1px;">{{ sc.text or _brand_name }}.</a>
</div>

{# â”€â”€ SEARCH BAR (inline inside main-header-row) â”€â”€ #}
{%- elif sc.layout == 'search-bar' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="search-bar" class="flex-1">
  <form action="#" method="get" class="flex items-center rounded-full border-2 overflow-hidden" style="border-color:{{ _accent_hex }};">
    <input name="q" class="flex-1 px-4 py-2.5 text-sm outline-none text-gray-700 bg-white" placeholder="{{ sc.text or sc.display_name }}" type="search" value="" />
    <button type="submit" class="px-4 py-3" style="background-color:{{ _accent_hex }};">
      <svg class="w-4 h-4" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </button>
  </form>
</div>

{# â”€â”€ ICON ACTIONS: login / wishlist / cart (inline inside main-header-row) â”€â”€ #}
{%- elif sc.layout == 'icon-actions' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="icon-actions">
  <div class="flex items-center gap-5 text-sm text-gray-700 shrink-0">
    {%- if sc.custom_methods %}
    {%- for m in sc.custom_methods %}
    <span class="cursor-pointer hover:opacity-75 whitespace-nowrap">{{ m }}</span>
    {%- endfor %}
    {%- else %}
    <a href="#" class="cursor-pointer hover:opacity-75 whitespace-nowrap">Logout</a>
    <span class="cursor-pointer hover:opacity-75 text-xl leading-none">â™¡</span>
    <span class="relative cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>

    </span>
    {%- endif %}
  </div>
</div>

{# â”€â”€ COMBINED MAIN HEADER (main-header â€” legacy single-section variant) â”€â”€ #}
{%- elif sc.layout == 'main-header' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="main-header">
<header class="bg-white px-6 py-3 flex items-center gap-4">
  <a href="#" class="text-3xl font-black shrink-0 leading-none" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-1px;">{{ _brand_name }}.</a>
  <form action="#" method="get" class="flex-1 flex items-center rounded-full border-2 overflow-hidden" style="border-color:{{ _accent_hex }};">
    <input name="q" class="flex-1 px-4 py-2.5 text-sm outline-none text-gray-700 bg-white" placeholder="{{ sc.text or sc.display_name }}" type="search" value="" />
    <button type="submit" class="px-4 py-3" style="background-color:{{ _accent_hex }};">
      <svg class="w-4 h-4" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </button>
  </form>
  <div class="flex items-center gap-5 text-sm text-gray-700 shrink-0">
    <a href="#" class="cursor-pointer hover:opacity-75 whitespace-nowrap">Logout</a>
    <span class="cursor-pointer hover:opacity-75 text-xl leading-none">â™¡</span>
    <span class="relative cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>

    </span>
  </div>
</header>
</div>

{# â”€â”€ NAV BAR (nav-links / nav-bar) â”€â”€ #}
{%- elif sc.layout in ('nav-links', 'nav-bar') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="{{ sc.layout }}">
<nav class="bg-white border-b border-gray-200 sticky top-0 z-40">
  <div class="px-6 flex items-center justify-between text-sm whitespace-nowrap py-2 overflow-x-auto">
    <div class="flex items-center gap-0">
      <span class="flex items-center gap-1.5 px-3 py-1.5 font-medium text-gray-700 cursor-pointer hover:bg-gray-100 rounded mr-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        {{ sc.custom_methods[0] if sc.custom_methods else sc.display_name }} â–¾
      </span>
      {%- for p in (all_pages or []) %}
      <span class="px-3 py-1.5 cursor-pointer rounded font-medium transition-colors {% if p.display_name == page.display_name %}border-b-2 font-bold{% else %}text-gray-700 hover:bg-gray-100{% endif %}"
        style="{{ ('border-color:'+_accent_hex+';color:'+_accent_hex) if p.display_name == page.display_name else '' }}">{{ p.display_name }}</span>
      {%- endfor %}
      {%- for m in sc.custom_methods[1:4] %}
      <span class="px-3 py-1.5 cursor-pointer rounded text-gray-700 hover:bg-gray-100">{{ m }}</span>
      {%- endfor %}
    </div>
    <div class="flex items-center gap-4 text-gray-500 text-xs shrink-0">
      {%- for m in sc.custom_methods[4:] %}
      <span class="cursor-pointer hover:text-gray-800">{{ m }}</span>
      {%- endfor %}
    </div>
  </div>
</nav>
</div>

{# â”€â”€ MINIMAL HEADER (minimal-header â€” checkout/login) â”€â”€ #}
{%- elif sc.layout == 'minimal-header' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="minimal-header">
<header class="bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between">
  <div class="text-2xl font-black" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-1px;">{{ _brand_name }}.</div>
  <button class="flex items-center gap-2 border-2 rounded-xl px-4 py-2 text-sm font-semibold hover:bg-gray-50" style="border-color:{{ _accent_hex }};color:{{ _accent_hex }};">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
    {{ sc.text or '0,00' }}
  </button>
</header>
</div>

{# â”€â”€ SITE-NAV (legacy: full header in one section) â”€â”€ #}
{%- elif sc.layout == 'site-nav' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="site-nav">
<div style="background-color:{{ _accent_hex }};" class="px-6 py-1.5 flex items-center justify-between text-xs text-white select-none">
  <div class="flex items-center gap-6">
    {%- for m in sc.custom_methods[:3] %}<span>{{ m }}</span>{%- endfor %}
  </div>
  {%- if sc.text %}<span>{{ sc.text }}</span>{%- endif %}
</div>
<header class="bg-white px-6 py-3 flex items-center gap-4">
  <a href="#" class="text-3xl font-black shrink-0 leading-none" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-1px;">{{ _brand_name }}.</a>
  <form action="#" method="get" class="flex-1 flex items-center rounded-full border-2 overflow-hidden" style="border-color:{{ _accent_hex }};">
    <input name="q" class="flex-1 px-4 py-2.5 text-sm outline-none text-gray-700 bg-white" placeholder="{{ sc.text or sc.display_name }}" type="search" value="" />
    <button type="submit" class="px-4 py-3" style="background-color:{{ _accent_hex }};">
      <svg class="w-4 h-4" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </button>
  </form>
  <div class="flex items-center gap-5 text-sm text-gray-700 shrink-0">
    <a href="#" class="cursor-pointer hover:opacity-75">Logout</a>
    <span class="cursor-pointer hover:opacity-75 text-xl leading-none">â™¡</span>
    <span class="relative cursor-pointer"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></span>
  </div>
</header>
<nav class="bg-white border-b border-gray-200 sticky top-0 z-40">
  <div class="px-6 flex items-center justify-between text-sm whitespace-nowrap py-2 overflow-x-auto">
    <div class="flex items-center gap-0">
      <span class="flex items-center gap-1.5 px-3 py-1.5 font-medium text-gray-700 cursor-pointer hover:bg-gray-100 rounded mr-1"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>{{ sc.custom_methods[0] if sc.custom_methods else sc.display_name }} â–¾</span>
      {%- for p in (all_pages or []) %}<span class="px-3 py-1.5 cursor-pointer rounded font-medium transition-colors {% if p.display_name == page.display_name %}border-b-2 font-bold{% else %}text-gray-700 hover:bg-gray-100{% endif %}" style="{{ ('border-color:'+_accent_hex+';color:'+_accent_hex) if p.display_name == page.display_name else '' }}">{{ p.display_name }}</span>{%- endfor %}
    </div>
    <div class="flex items-center gap-4 text-gray-500 text-xs">{%- for m in sc.custom_methods[4:] %}<span class="cursor-pointer hover:text-gray-800">{{ m }}</span>{%- endfor %}</div>
  </div>
</nav>
</div>

{%- endif %}
{%- endfor %}
{%- if _main_row_open %}</header>{%- endif %}

{% if not _header_secs %}
<header class="px-6 py-3 flex items-center justify-between shadow-sm" style="background-color: {{ _accent_hex }};">
  <div class="flex items-center gap-3">
    <a href="#" class="text-lg font-bold text-white hover:opacity-90 transition-opacity">
      {{ _brand_name | capitalize }}
    </a>
  </div>
  <a href="#" class="text-sm text-white opacity-80 hover:opacity-100 transition-opacity">Logout</a>
</header>
<nav class="bg-white border-b border-gray-200 shadow-sm sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-6 flex items-center gap-6 text-sm font-medium text-gray-700 overflow-x-auto whitespace-nowrap py-2.5">
    <a href="#" class="hover:text-gray-900 transition-colors">Home</a>
    {%- for p in (all_pages or []) %}
    {%- if p.type != 'activity' %}
    <a href="#" class="hover:text-gray-900 transition-colors">{{ p.display_name }}</a>
    {%- endif %}
    {%- endfor %}
  </div>
</nav>
{% endif %}

<main class="px-6 py-6 max-w-7xl mx-auto">
{%- else -%}
{% raw %}{%{% endraw %} extends "{{ application_name }}_base.html" {% raw %}%}{% endraw %}
{% raw %}{% block content %}{% endraw %}
{%- endif %}

{# â”€â”€ Global lookup maps (defined once, used per section) â”€â”€ #}
{% set _cm = {
  "blue":   {"btn":"bg-blue-600 hover:bg-blue-700","light":"bg-blue-50","text":"text-blue-600","border":"border-blue-200","label":"text-blue-700","ring":"focus:ring-blue-500","th":"bg-blue-600 text-white"},
  "green":  {"btn":"bg-green-600 hover:bg-green-700","light":"bg-green-50","text":"text-green-600","border":"border-green-200","label":"text-green-700","ring":"focus:ring-green-500","th":"bg-green-600 text-white"},
  "purple": {"btn":"bg-purple-600 hover:bg-purple-700","light":"bg-purple-50","text":"text-purple-600","border":"border-purple-200","label":"text-purple-700","ring":"focus:ring-purple-500","th":"bg-purple-600 text-white"},
  "orange": {"btn":"bg-orange-500 hover:bg-orange-600","light":"bg-orange-50","text":"text-orange-500","border":"border-orange-200","label":"text-orange-700","ring":"focus:ring-orange-400","th":"bg-orange-500 text-white"},
  "rose":   {"btn":"bg-rose-600 hover:bg-rose-700","light":"bg-rose-50","text":"text-rose-600","border":"border-rose-200","label":"text-rose-700","ring":"focus:ring-rose-500","th":"bg-rose-600 text-white"},
  "slate":  {"btn":"bg-slate-700 hover:bg-slate-800","light":"bg-slate-50","text":"text-slate-600","border":"border-slate-200","label":"text-slate-700","ring":"focus:ring-slate-500","th":"bg-slate-700 text-white"},
} %}
{% set _rm = {"none":"rounded-none","sm":"rounded-sm","md":"rounded-md","lg":"rounded-lg","xl":"rounded-xl","2xl":"rounded-2xl"} %}
{% set _dm = {
  "compact":  {"gap":"gap-2","p":"p-3","p_sm":"p-2","text":"text-xs","sec":"mb-8"},
  "normal":   {"gap":"gap-4","p":"p-4","p_sm":"p-3","text":"text-sm","sec":"mb-12"},
  "spacious": {"gap":"gap-6","p":"p-6","p_sm":"p-4","text":"text-base","sec":"mb-16"},
} %}
{% set _csm  = {"flat":"border border-gray-100","elevated":"shadow-md","outlined":"border-2 border-gray-200"} %}
{% set _shm  = {"none":"","sm":"shadow-sm","md":"shadow-md","lg":"shadow-lg","xl":"shadow-xl"} %}
{% set _bom  = {"none":"","light":"border border-gray-200","strong":"border-2 border-gray-400"} %}
{% set _bgm  = {"white":"bg-white","gray":"bg-gray-50","dark":"bg-gray-800"} %}
{% set _hdsm = {"default":"text-xl font-semibold text-gray-800","large":"text-2xl font-bold text-gray-900","small":"text-xs font-medium text-gray-500 uppercase tracking-widest"} %}
{% set _colm = {"1":"grid-cols-1","2":"grid-cols-1 sm:grid-cols-2","3":"grid-cols-1 sm:grid-cols-2 lg:grid-cols-3","4":"grid-cols-2 lg:grid-cols-4"} %}
{% set _spanm = {3: "col-span-12 sm:col-span-6 lg:col-span-3", 4: "col-span-12 sm:col-span-6 lg:col-span-4", 6: "col-span-12 sm:col-span-6", 12: "col-span-12"} %}
{% set _im = {"sm":"w-1/3","md":"w-2/5","lg":"w-1/2"} %}
{% set _pm = {
  "vertical": "flex flex-col",
  "horizontal": "flex flex-row flex-wrap items-start",
  "vertical-reverse": "flex flex-col-reverse",
  "horizontal-reverse": "flex flex-row-reverse flex-wrap items-start",
} %}
{# â”€â”€ Safe fallbacks for generation mode (preview_mode sets these earlier via tokens) â”€â”€ #}
{%- set _accent_hex = _accent_hex if _accent_hex is defined else '#0000a4' %}
{%- set _brand_name = _brand_name if _brand_name is defined else 'App' %}
{%- set _mock_rows = 3 %}
{%- set _mock_opacities = ["1", "0.8", "0.6"] %}
{%- set _mock_imgs = [] %}

{# â”€â”€ Shared item-template macros (used by preview and generation mode) â”€â”€ #}
{%- macro _mini_card(img, name, price, accent, discount='', rating_count='', view_url='#', opacity_style='', favorite_url='') -%}
<div class="flex-shrink-0 w-44 bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden"{% if opacity_style %} style="{{ opacity_style }}"{% endif %}>
  <div class="relative">
    {%- if img %}
    <img src="{{ img }}" class="w-full h-36 object-contain p-2 bg-gray-50" />
    {%- else %}
    <div class="w-full h-36 bg-gray-50"></div>
    {%- endif %}
    {%- if favorite_url %}
    <a href="{{ favorite_url }}" class="absolute top-2 right-2 text-gray-400 hover:text-red-400 text-lg leading-none">â™¡</a>
    {%- else %}
    <span class="absolute top-2 right-2 text-gray-400 text-lg leading-none">â™¡</span>
    {%- endif %}
  </div>
  <div class="p-2.5">
    <p class="text-xs text-gray-800 font-medium leading-tight" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{{ name }}</p>
    <div class="flex items-center gap-0.5 mt-1">
      <span class="text-yellow-400 text-xs">â˜…â˜…â˜…â˜…</span><span class="text-gray-200 text-xs">â˜…</span>
      {%- if rating_count %}<span class="text-xs text-gray-400">({{ rating_count }})</span>{%- endif %}
    </div>
    <div class="mt-1 flex items-center gap-1">
      <span class="text-sm font-bold" style="color:#e53935;">{{ price }}</span>
      {%- if discount %}<span class="text-xs text-white font-bold px-1 rounded" style="background:#e53935;">{{ discount }}</span>{%- endif %}
    </div>
    <a href="{{ view_url }}" class="mt-2 block w-full py-1.5 rounded-lg text-xs font-bold text-gray-900 text-center" style="background:#ffd700;">+ ðŸ›’</a>
  </div>
</div>
{%- endmacro %}

{%- macro _product_row(img, name, price, accent, old_price='', discount='', view_url='#', opacity_style='') -%}
<div class="bg-white rounded-lg border border-gray-200 p-4 flex gap-4 items-start hover:shadow-sm transition-shadow"{% if opacity_style %} style="{{ opacity_style }}"{% endif %}>
  <div class="w-36 h-36 flex-shrink-0 flex items-center justify-center bg-gray-50 rounded-lg border border-gray-100">
    {%- if img %}
    <img src="{{ img }}" class="w-32 h-32 object-contain" />
    {%- endif %}
  </div>
  <div class="flex-1 min-w-0">
    <a href="{{ view_url }}" class="text-sm font-medium text-gray-900 hover:underline">{{ name }}</a>
    <div class="flex items-center gap-1 mt-1">
      <span class="text-yellow-400 text-xs">â˜…â˜…â˜…â˜…</span><span class="text-gray-200 text-xs">â˜…</span>
    </div>
    <div class="flex items-center gap-2 mt-2">
      {%- if discount %}<span class="text-xs text-white font-bold px-1.5 py-0.5 rounded" style="background:#e53935;">{{ discount }}</span>{%- endif %}
      {%- if old_price %}<span class="text-xs text-gray-400 line-through">{{ old_price }}</span>{%- endif %}
    </div>
  </div>
  <div class="text-right shrink-0 flex flex-col items-end gap-2 w-36">
    <div class="text-2xl font-bold" style="color:#e53935;">{{ price }}</div>
    <a href="{{ view_url }}" class="w-full text-center py-2 rounded-lg text-xs font-bold text-gray-900" style="background:#ffd700;">+ ðŸ›’</a>
  </div>
</div>
{%- endmacro %}

{%- macro _cart_row(img, name, price, old_price, accent, discount='', opacity_style='') -%}
<div class="bg-white border border-gray-200 rounded-lg p-4 flex gap-4 items-start"{% if opacity_style %} style="{{ opacity_style }}"{% endif %}>
  <div class="w-24 h-24 flex-shrink-0 bg-gray-50 rounded-lg border border-gray-100 flex items-center justify-center">
    {%- if img %}
    <img src="{{ img }}" class="w-20 h-20 object-contain" />
    {%- endif %}
  </div>
  <div class="flex-1">
    <a href="#" class="text-sm font-medium hover:underline" style="color:{{ accent }};">{{ name }}</a>
    <div class="flex items-center gap-1 mt-1">
      <span class="text-yellow-400 text-xs">â˜…â˜…â˜…â˜…</span><span class="text-gray-200 text-xs">â˜…</span>
    </div>
    <div class="flex items-baseline gap-2 mt-1">
      <span class="text-xl font-bold" style="color:#e53935;">{{ price }}</span>
      {%- if discount %}<span class="text-xs text-white px-1.5 py-0.5 rounded font-bold" style="background:#e53935;">{{ discount }}</span>{%- endif %}
      {%- if old_price %}<span class="text-xs text-gray-400 line-through">{{ old_price }}</span>{%- endif %}
    </div>
    <div class="flex items-center gap-3 mt-2">
      <select class="border border-gray-300 rounded px-2 py-1 text-sm"><option>1</option><option>2</option><option>3</option></select>
      <button class="text-gray-400 hover:text-red-400"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg></button>
      <button class="text-gray-400 hover:text-red-400 text-lg leading-none">â™¡</button>
    </div>
  </div>
</div>
{%- endmacro %}

{%- macro _category_tile(icon, name, view_url='#', opacity_style='') -%}
<a href="{{ view_url }}" class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 flex flex-col items-center gap-2 hover:shadow-md transition-shadow text-center"{% if opacity_style %} style="{{ opacity_style }}"{% endif %}>
  {%- if icon %}
  <span class="text-3xl">{{ icon }}</span>
  {%- endif %}
  <span class="text-xs font-medium text-gray-700 leading-tight">{{ name }}</span>
</a>
{%- endmacro %}

{% if page.type == 'activity' and not preview_mode %}
<h2 class="text-2xl font-bold mb-6 text-gray-800">{{ page.activity_name }}</h2>
{% endif %}

<div id="page-sections-grid" class="grid grid-cols-12 {{ _dm.get(page.gap, _dm['normal']).gap }}">
{%- for section_component in page.section_components if not (
    (section_component.position == 'header' and section_component.layout in _header_chrome) or
    (section_component.position == 'footer' and section_component.layout in _footer_chrome)
) %}
{%- if section_component.component_type == 'activity_action' %}
{%- set _aa_variant = section_component.style.get('variant', 'button') %}
{%- set _aa_align   = section_component.style.get('align', 'right') %}
{%- set _aa_size    = section_component.style.get('size', 'lg') %}
{%- set _aa_py      = 'py-4 px-8 text-base' if _aa_size == 'lg' else ('py-2 px-4 text-sm' if _aa_size == 'sm' else 'py-3 px-6 text-sm') %}
{%- set _aa_justify = 'justify-end' if _aa_align == 'right' else ('justify-center' if _aa_align == 'center' else ('justify-start' if _aa_align == 'left' else '')) %}
<div class="{{ _spanm.get(section_component.col_span, 'col-span-12') }}" data-section-id="{{ section_component.id }}" data-section-name="{{ section_component.display_name }}" data-position="{{ section_component.position or 'main' }}" data-layout="activity_action">
{%- if not preview_mode %}
  {%- if _aa_variant == 'fab' %}
  <div class="fixed bottom-6 right-6 z-50">
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
      <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-semibold {{ _aa_py }} rounded-full shadow-lg transition-colors">{{ section_component.label }}</button>
    </form>
  </div>
  {%- elif _aa_variant == 'link' %}
  <div class="flex {{ _aa_justify }} mt-4">
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
      <button type="submit" class="text-blue-600 hover:underline font-medium {{ _aa_py }}">{{ section_component.label }} →</button>
    </form>
  </div>
  {%- elif _aa_variant == 'wizard_next' %}
  <div class="flex items-center justify-between border-t border-gray-200 pt-4 mt-4">
    <a href="javascript:history.back()" class="text-sm text-gray-500 hover:text-gray-700">← Back</a>
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
      <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold {{ _aa_py }} rounded-xl transition-colors">{{ section_component.label }} →</button>
    </form>
  </div>
  {%- elif _aa_variant == 'auto' %}
  <div class="hidden">
    <form id="auto-complete-form" action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
    </form>
  </div>
  <script>setTimeout(function(){ document.getElementById('auto-complete-form').submit(); }, 1500);</script>
  {%- else %}{# default: button #}
  <div class="flex {{ _aa_justify }} mt-6">
    <form action="{% raw %}{%{% endraw %} url 'workflow_engine:complete_process_step' active_process_node_id {% raw %}%}{% endraw %}" method="post">
      {% raw %}{% csrf_token %}{% endraw %}
      <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-semibold {{ _aa_py }} rounded-xl shadow transition-colors">{{ section_component.label }}</button>
    </form>
  </div>
  {%- endif %}
{%- else %}{# preview_mode #}
  <div class="flex {{ _aa_justify }} mt-6">
    <button type="button" class="bg-green-600 text-white font-semibold {{ _aa_py }} rounded-xl shadow opacity-75 cursor-default">{{ section_component.label }}</button>
  </div>
{%- endif %}
</div>
{%- else %}
{# â”€â”€ Resolve per-section style â”€â”€ #}
{%- macro _field_value(attribute, mock_row, c, d, r, allow_link=False) -%}
  {%- set render_as = attribute.render_as if attribute.render_as is defined else ('link' if attribute.is_link else 'text') -%}
  {%- set action = attribute.action if attribute.action is defined else {} -%}
  {%- set action_type = action.get('type', 'none') -%}
  {%- set label = attribute ~ ' ' ~ (mock_row + 1) -%}
  {%- set tooltip = action.get('tooltip', '') if action_type == 'tooltip' else '' -%}
  {%- set nav_target = action.get('targetPageId') or action.get('targetPage') or '#' -%}
  {%- set operation_name = action.get('operation') or action.get('operationId') or attribute -%}
  {%- set field_name = action.get('field') or attribute -%}
  {%- set value_html -%}
  {%- if render_as == 'badge' -%}
    <span class="inline-flex w-fit items-center rounded-full px-2 py-0.5 {{ d.text }} font-semibold {{ c.light }} {{ c.text }} border {{ c.border }}" title="{{ tooltip }}">{{ label }}</span>
  {%- elif render_as == 'button' -%}
    <span class="inline-flex {{ d.text }} font-medium {{ c.text }} py-1 px-3 {{ r }} border {{ c.border }} hover:{{ c.light }} transition-colors" title="{{ tooltip }}">{{ label }}</span>
  {%- elif render_as == 'link' or attribute.is_link -%}
    <span class="{{ d.text }} font-medium {{ c.text }} hover:underline" title="{{ tooltip }}">{{ label }}</span>
  {%- else -%}
    <span class="{{ d.text }} font-medium text-gray-700" title="{{ tooltip }}">{{ label }}</span>
  {%- endif -%}
  {%- endset -%}
  {%- if action_type == 'navigate' or ((render_as == 'link' or attribute.is_link) and allow_link) -%}
    <a href="{{ nav_target if nav_target.startswith('/') or nav_target.startswith('#') else '#' }}" data-target-page="{{ nav_target }}" class="inline-flex">{{ value_html }}</a>
  {%- elif action_type == 'operation' -%}
    <button type="button" data-operation="{{ operation_name }}" class="inline-flex">{{ value_html }}</button>
  {%- elif action_type == 'copy' -%}
    <button type="button" onclick="navigator.clipboard && navigator.clipboard.writeText('{{ label }}')" class="inline-flex">{{ value_html }}</button>
  {%- elif action_type == 'filter' -%}
    <button type="button" data-filter-field="{{ field_name }}" data-filter-value="{{ label }}" class="inline-flex">{{ value_html }}</button>
  {%- elif action_type == 'expand' -%}
    <details class="inline-block"><summary class="cursor-pointer list-none">{{ value_html }}</summary><span class="{{ d.text }} text-gray-500">{{ label }}</span></details>
  {%- else -%}
    {{ value_html }}
  {%- endif -%}
{%- endmacro %}

{%- macro _field_value_bound(attribute, object_name, c, d, r, application_name, page, section_component, allow_link=False) -%}
  {%- set render_as = attribute.render_as if attribute.render_as is defined else ('link' if attribute.is_link else 'text') -%}
  {%- set action = attribute.action if attribute.action is defined else {} -%}
  {%- set action_type = action.get('type', 'none') -%}
  {%- set tooltip = action.get('tooltip', '') if action_type == 'tooltip' else '' -%}
  {%- set target_page = action.get('targetPage') or section_component.view_detail_page -%}
  {%- set operation_name = action.get('operation') or action.get('operationId') or attribute -%}
  {%- set operation_class = action.get('class') or section_component.primary_model -%}
  {%- set field_name = action.get('field') or attribute -%}
  {%- set row_value -%}{% raw %}{{{% endraw %} {{ object_name }}.{{ attribute }} {% raw %}}}{% endraw %}{%- endset -%}
  {%- set row_id -%}{% raw %}{{{% endraw %} {{ object_name }}.id {% raw %}}}{% endraw %}{%- endset -%}
  {%- set value_html -%}
  {%- if render_as == 'badge' -%}
    <span class="inline-flex w-fit items-center rounded-full px-2 py-0.5 {{ d.text }} font-semibold {{ c.light }} {{ c.text }} border {{ c.border }}" title="{{ tooltip }}">{{ row_value }}</span>
  {%- elif render_as == 'button' -%}
    <span class="inline-flex {{ d.text }} font-medium {{ c.text }} py-1 px-3 {{ r }} border {{ c.border }} hover:{{ c.light }} transition-colors" title="{{ tooltip }}">{{ row_value }}</span>
  {%- elif render_as == 'link' or attribute.is_link -%}
    <span class="{{ d.text }} font-medium {{ c.text }} hover:underline" title="{{ tooltip }}">{{ row_value }}</span>
  {%- else -%}
    <span class="{{ d.text }} font-medium text-gray-800" title="{{ tooltip }}">{{ row_value }}</span>
  {%- endif -%}
  {%- endset -%}
  {%- if action_type == 'navigate' or ((render_as == 'link' or attribute.is_link) and allow_link) -%}
    {%- if target_page %}
    <a href="{% raw %}{%{% endraw %} url '{{ application_name }}:render_{{ application_name }}_{{ target_page }}' {% raw %}%}{% endraw %}?instance_id_{{ section_component.primary_model }}={{ row_id }}" class="inline-flex">{{ value_html }}</a>
    {%- else -%}
    {{ value_html }}
    {%- endif -%}
  {%- elif action_type == 'operation' -%}
    <form action="{% raw %}{%{% endraw %} url '{{ application_name }}:render_{{ application_name }}_{{ page }}' {% if page.type == 'activity' %}active_process_node_id{% endif %}{% raw %}%}{% endraw %}" method="get" class="inline-flex">
      <input type="hidden" name="instance_id_{{ operation_class }}" value="{{ row_id }}">
      <input type="hidden" name="custom_{{ operation_class }}_{{ operation_name }}" value="{{ row_id }}">
      <button type="submit" class="inline-flex">{{ value_html }}</button>
    </form>
  {%- elif action_type == 'copy' -%}
    <button type="button" onclick="navigator.clipboard && navigator.clipboard.writeText(this.dataset.copyValue)" data-copy-value="{{ row_value }}" class="inline-flex">{{ value_html }}</button>
  {%- elif action_type == 'filter' -%}
    <a href="?{{ field_name }}={{ row_value|urlencode }}" data-filter-field="{{ field_name }}" class="inline-flex">{{ value_html }}</a>
  {%- elif action_type == 'expand' -%}
    <details class="inline-block"><summary class="cursor-pointer list-none">{{ value_html }}</summary><span class="{{ d.text }} text-gray-500">{{ row_value }}</span></details>
  {%- else -%}
    {{ value_html }}
  {%- endif -%}
{%- endmacro %}

{% set _s   = section_component.style %}
{% set c    = _cm.get(_s.get("color","blue"), _cm["blue"]) %}
{% set r    = _rm.get(_s.get("radius","xl"), "rounded-xl") %}
{% set d    = _dm.get(_s.get("density","normal"), _dm["normal"]) %}
{% set col  = _colm.get(_s.get("columns","3")|string, "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3") %}
{% set lay  = section_component.layout %}
{% set _bg_key  = _s.get("bg","white") %}
{% set _sec_bg  = c.light if _bg_key == "light" else _bgm.get(_bg_key,"bg-white") %}
{% set _sec_sh  = _shm.get(_s.get("shadow","none"),"") %}
{% set _bor_key = _s.get("border","none") %}
{% set _sec_bor = ("border-2 " ~ c.border) if _bor_key == "colored" else _bom.get(_bor_key,"") %}
{% set _hs_key  = _s.get("header_style","default") %}
{% set _hs_hide = _hs_key == "hidden" %}
{% set _hs      = _hdsm.get(_hs_key, ("text-xl font-bold " ~ c.text)) %}
{% set cs       = (_sec_bg ~ " " ~ _csm.get(_s.get("card_style","elevated"),"shadow-md") ~ " " ~ _sec_sh ~ " " ~ _sec_bor)|trim %}
{% set has_attrs = section_component.attributes|length > 0 %}
{% set has_methods = section_component.custom_methods|length > 0 %}
{% set eff_lay = "action_panel" if (not has_attrs and has_methods) else lay %}
{% set list_var_name = 'related_' + section_component.name + '_list' if section_component.related_to_section_id else ((section_component.primary_model + '_list') if section_component.primary_model else '') %}
{% set query_limit = section_component.query.get("limit") %}
{% set _base_mock = 3 %}
{% set section_mock_rows = query_limit if query_limit else _base_mock %}
{# â”€â”€ Attribute slot extraction â”€â”€ #}
{%- set _iattrs   = section_component.attributes | selectattr('type', 'equalto', AttributeType.IMAGE) | list %}
{%- set _tattrs   = section_component.attributes | rejectattr('type', 'equalto', AttributeType.IMAGE) | rejectattr('type', 'equalto', AttributeType.INTEGER) | list %}
{%- set _intattrs = section_component.attributes | selectattr('type', 'equalto', AttributeType.INTEGER) | list %}
{# â”€â”€ Generic layout normalisation (legacy aliases â†’ canonical names) â”€â”€ #}
{%- set _disp   = _s.get('display_mode', 'carousel' if eff_lay == 'product-carousel' else ('banner' if eff_lay == 'hero-banner' else 'grid')) %}
{%- set _cstyle = _s.get('card_style',  'product'  if eff_lay in ('product-carousel','hero-banner') else ('category' if eff_lay == 'category-grid' else 'default')) %}
{%- set _lstyle = _s.get('list_style',  'product'  if eff_lay == 'product-list' else ('cart-item' if eff_lay == 'item-list' else 'default')) %}
{%- set _fstyle = _s.get('form_style',  'auth'     if eff_lay == 'auth-form' else ('step' if eff_lay == 'form-step' else ('summary' if eff_lay == 'summary-panel' else 'default'))) %}
{%- set _glay   = 'card'   if eff_lay in ('card','product-carousel','category-grid','hero-banner') else
                  ('list'   if eff_lay in ('list','product-list','item-list') else
                  ('form'   if eff_lay in ('form','auth-form','form-step','summary-panel') else
                  ('filter' if eff_lay in ('filter','filter-panel') else eff_lay))) %}
{# â”€â”€ Shared mock data â”€â”€ #}
{%- set _mock_old_pl    = ["49,99","119,00","199,00","59,99","319,00"] %}
{%- set _mock_cats      = [] %}

<div class="{{ _spanm.get(section_component.col_span, 'col-span-12') }}" data-section-id="{{ section_component.id }}" data-section-name="{{ section_component.display_name }}" data-position="{{ section_component.position or 'main' }}" data-layout="{{ section_component.layout }}">

  {% if page.type != 'activity' and not _hs_hide and _glay not in ('form', 'filter') %}
  <div class="flex items-center justify-between mb-3">
    <h2 class="{{ _hs }}">{{ section_component.display_name }}</h2>
  </div>
  {% endif %}

  {% if section_component.text %}
  <p class="text-gray-500 {{ d.text }} mb-4">{{ section_component.text }}</p>
  {% endif %}

{# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• PREVIEW MODE â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• #}
{% if preview_mode %}

{# â•â•â•â• PREVIEW: ACTION PANEL â•â•â•â• #}
{% if eff_lay == "action_panel" %}
{% if section_component.custom_methods|length == 1 %}
  <form action="{% raw %}{%{% endraw %} url '{{ application_name }}:render_{{ application_name }}_{{ page }}' {% if page.type == 'activity' %}active_process_node_id{% endif %}{% raw %}%}{% endraw %}" method="get">
    {% if section_component.primary_model -%}
    <input type="hidden" name="instance_id_{{ section_component.primary_model }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
    <input type="hidden" name="custom_{{ section_component.primary_model }}_{{ section_component.custom_methods[0].call_name }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
    {% endif -%}
    {% for parameter in section_component.custom_methods[0].parameters %}
    <label class="block {{ d.text }} font-medium {{ c.label }} mb-1">{{ parameter.name }}</label>
    <input type="{% if parameter.type == 'int' %}number{% else %}text{% endif %}" name="{{ parameter.name }}" value="1" min="1" class="{{ c.border }} border bg-white {{ r }} px-3 py-2 text-sm {{ c.ring }} focus:outline-none focus:ring-2 mb-3">
    {% endfor %}
    <button type="submit" class="w-full {{ c.btn }} text-white {{ d.text }} font-semibold py-3 px-6 {{ r }} transition-opacity">
      {{ section_component.custom_methods[0] }}
    </button>
  </form>
{% else %}
  <div class="flex flex-wrap gap-2">
    {% for method in section_component.custom_methods %}
    <form action="{% raw %}{%{% endraw %} url '{{ application_name }}:render_{{ application_name }}_{{ page }}' {% if page.type == 'activity' %}active_process_node_id{% endif %}{% raw %}%}{% endraw %}" method="get">
      {% if section_component.primary_model -%}
      <input type="hidden" name="instance_id_{{ section_component.primary_model }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
      <input type="hidden" name="custom_{{ section_component.primary_model }}_{{ method.call_name }}" value="{% raw %}{{{% endraw %} request.GET.instance_id_{{ section_component.primary_model }} {% raw %}}}{% endraw %}">
      {% endif -%}
      {% for parameter in method.parameters %}
      <label class="block {{ d.text }} font-medium {{ c.label }} mb-1">{{ parameter.name }}</label>
      <input type="{% if parameter.type == 'int' %}number{% else %}text{% endif %}" name="{{ parameter.name }}" value="1" min="1" class="{{ c.border }} border bg-white {{ r }} px-3 py-2 text-sm {{ c.ring }} focus:outline-none focus:ring-2 mb-3">
      {% endfor %}
      <button type="submit" class="{{ c.btn }} text-white {{ d.text }} font-medium py-2 px-4 {{ r }}">
        {{ method }}
      </button>
    </form>
    {% endfor %}
  </div>
{% endif %}

{# â•â•â•â• PREVIEW: DETAIL â•â•â•â• #}
{%- elif eff_lay == "detail" %}
{%- set img_pos = _s.get("image_position", "top") %}
{%- set img_w = _im.get(_s.get("image_size", "md"), "w-2/5") %}
  <div class="flex flex-col {{ d.gap }}">
    {%- for _mock_row in range(1) %}
    {%- if img_pos in ["left", "right"] %}
    <div class="{{ cs }} {{ r }} {{ d.p }} border border-gray-100 flex {{ 'flex-row' if img_pos == 'left' else 'flex-row-reverse' }} gap-6 items-start">
      {%- if section_component.attributes | selectattr('type', 'equalto', AttributeType.IMAGE) | list %}
      <div class="{{ img_w }} flex-shrink-0">
        <div class="w-full h-56 {{ r }} bg-gray-50"></div>
      </div>
      {%- endif %}
      <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 {{ d.gap }}">
        {%- for attribute in section_component.attributes %}
        {%- if attribute.type != AttributeType.IMAGE %}
        <div class="flex flex-col gap-1">
          <span class="text-xs font-medium text-gray-400 uppercase tracking-wide">{{ attribute }}</span>
          {%- if attribute.type == AttributeType.BOOLEAN %}<input type="checkbox" {% if _mock_row == 0 %}checked{% endif %} disabled class="h-4 w-4 rounded">
          {%- elif attribute.type == AttributeType.ENUM %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute.enum_literals[0] if attribute.enum_literals else attribute }}</span>
          {%- elif attribute.type == AttributeType.INTEGER %}<span class="{{ d.text }} font-medium text-gray-700">{{ _mock_row * 7 + 12 }}</span>
          {%- else -%}
            {{ _field_value(attribute, _mock_row, c, d, r, section_component.view_detail_page) }}
          {%- endif %}
        </div>
        {%- endif %}
        {%- endfor %}
        <div class="sm:col-span-2 flex gap-2 pt-3 border-t border-gray-100">
          {%- if section_component.has_update_operation %}<button class="{{ d.text }} {{ c.text }} py-1 px-3 {{ r }} hover:{{ c.light }} border {{ c.border }} transition-colors">Edit</button>{%- endif %}
          {%- if section_component.has_delete_operation %}<button class="{{ d.text }} text-red-500 py-1 px-3 {{ r }} hover:bg-red-50 border border-red-200 transition-colors">Delete</button>{%- endif %}
        </div>
      </div>
    </div>
    {%- else %}
    <div class="{{ cs }} {{ r }} {{ d.p }} border border-gray-100">
      <div class="grid grid-cols-1 sm:grid-cols-2 {{ d.gap }}">
        {%- for attribute in section_component.attributes %}
        <div class="flex flex-col gap-1{% if attribute.type == AttributeType.IMAGE %} sm:col-span-2{% endif %}">
          <span class="text-xs font-medium text-gray-400 uppercase tracking-wide">{{ attribute }}</span>
          {%- if attribute.type == AttributeType.BOOLEAN %}<input type="checkbox" {% if _mock_row == 0 %}checked{% endif %} disabled class="h-4 w-4 rounded">
          {%- elif attribute.type == AttributeType.ENUM %}<span class="{{ d.text }} font-medium text-gray-700">{{ attribute.enum_literals[0] if attribute.enum_literals else attribute }}</span>
          {%- elif attribute.type == AttributeType.INTEGER %}<span class="{{ d.text }} font-medium text-gray-700">{{ _mock_row * 7 + 12 }}</span>
          {%- elif attribute.type == AttributeType.IMAGE %}<div class="w-full h-48 rounded mt-1 bg-gray-50"></div>
          {%- else -%}
            {{ _field_value(attribute, _mock_row, c, d, r, section_component.view_detail_page) }}
          {%- endif %}
        </div>
        {%- endfor %}
