  <div class="flex items-center gap-3 text-xs text-gray-400 mt-1">
    {%- for m in sc.custom_methods %}
    <span class="cursor-pointer hover:underline">{{ m }}</span><span>|</span>
    {%- endfor %}
  </div>
</div>
</div>

{%- elif sc.layout == 'site-footer' %}
{# Legacy: full footer in one section (backward compat) #}
<footer class="mt-0" data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="footer">
  <!-- Service & contact strip -->
  <div class="px-8 py-5 flex items-center gap-8" style="background-color:{{ _accent_hex }};">
    <span class="text-white font-bold text-lg">{{ sc.display_name }}</span>
    <div class="flex items-center gap-6 text-sm text-white opacity-80">
      {%- for m in sc.custom_methods %}
      <span class="cursor-pointer hover:opacity-100">{{ m }}</span>
      {%- endfor %}
    </div>
  </div>
  <!-- Footer link columns from attributes -->
  <div class="bg-white px-8 py-8 text-sm border-t border-gray-100">
    {%- if sc.text %}
    {{ sc.text }}
    {%- endif %}
  </div>
  <!-- Bottom brand strip -->
  <div class="bg-white border-t border-gray-200 py-8 flex flex-col items-center gap-2">
    <div class="text-4xl font-black" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-2px;">{{ _brand_name }}</div>
  </div>
</footer>

{%- endif %}
{%- endfor %}
{%- if _link_row_open %}</div>{%- endif %}

</body>
</html>
{% else %}
<script>
(function() {
  var grid = document.getElementById('page-sections-grid');
  if (!grid) return;
  var secs = Array.from(grid.children);
  var byPos = {};
  secs.forEach(function(el) {
    var pos = el.getAttribute('data-position') || 'main';
    if (!byPos[pos]) byPos[pos] = [];
    byPos[pos].push(el);
  });
  var hasHero = byPos.hero && byPos.hero.length;
  var hasSidebar = byPos.sidebar && byPos.sidebar.length;
  if (!hasHero && !hasSidebar) return;
  var parent = grid.parentNode;
  var wrap = document.createElement('div');
  wrap.className = 'flex flex-col gap-6';
  if (hasHero) {
    var heroEl = document.createElement('div');
    heroEl.className = 'rounded-2xl overflow-hidden grid grid-cols-12 gap-4';
    byPos.hero.forEach(function(el) { heroEl.appendChild(el); });
    wrap.appendChild(heroEl);
  }
  var mainSecs = byPos.main || [];
  var sidebarSecs = byPos.sidebar || [];
  if (mainSecs.length || sidebarSecs.length) {
    var hasSidebarEl = sidebarSecs.length > 0;
    var contentRow = document.createElement('div');
    contentRow.className = hasSidebarEl ? 'flex gap-6 items-start' : '';
    var mainGrid = document.createElement('div');
    mainGrid.className = (hasSidebarEl ? 'flex-1 min-w-0 ' : '') + 'grid grid-cols-12 gap-4';
    mainSecs.forEach(function(el) { mainGrid.appendChild(el); });
    contentRow.appendChild(mainGrid);
    if (hasSidebarEl) {
      var sideEl = document.createElement('aside');
      sideEl.className = 'w-72 flex-shrink-0 flex flex-col gap-4';
      sidebarSecs.forEach(function(el) { el.className = 'w-full'; sideEl.appendChild(el); });
      contentRow.appendChild(sideEl);
    }
    wrap.appendChild(contentRow);
  }
  parent.replaceChild(wrap, grid);
})();
</script>

{% raw %}{% endblock %}{% endraw %}
{% endif %}
