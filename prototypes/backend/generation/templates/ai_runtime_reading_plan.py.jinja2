"""BL-1.0 borrowed-and-returned history -> taste -> recommendation -> sequence."""
from collections import Counter
from typing import Annotated

from django.utils import timezone
from pydantic import BaseModel, Field, StringConstraints, field_validator

from .chains import ChainRunner, ChainStep
from .configuration import validate_ai_config
from .context import retrieve_customer_history
from .execution import perform_call, safe_error
from .outcomes import RunOutcome

NonEmpty = Annotated[str, StringConstraints(strict=True, strip_whitespace=True, min_length=1)]


class TasteProfile(BaseModel):
    genres: list[NonEmpty] = Field(min_length=1)
    notes: str = ""


class Recommendation(BaseModel):
    books: list[NonEmpty] = Field(min_length=3, max_length=3)

    @field_validator("books")
    @classmethod
    def distinct_books(cls, books):
        if len({book.casefold() for book in books}) != 3:
            raise ValueError("Three distinct recommended books are required")
        return books


class ReadingPlan(BaseModel):
    ordered: list[NonEmpty] = Field(min_length=3, max_length=3)
    summary: Annotated[str, StringConstraints(strict=True, strip_whitespace=True, min_length=1, max_length=255)]


def validate_sequence(plan, context):
    if Counter(plan.ordered) != Counter(context["recommendation"]["books"]):
        raise ValueError("The sequence must be a permutation of the recommended books")


STEP_REGISTRY = {
    "reading_plan_analyze_taste_v1": ChainStep("reading_plan_analyze_taste_v1", TasteProfile, "taste", "analyze_taste"),
    "reading_plan_recommend_v1": ChainStep("reading_plan_recommend_v1", Recommendation, "recommendation", "recommend"),
    "reading_plan_sequence_v1": ChainStep("reading_plan_sequence_v1", ReadingPlan, "plan", "sequence", validate_context=validate_sequence),
}


def _skip(outcome, config, instance, reason):
    outcome.status, outcome.skip_reason = "skipped", reason
    old = (getattr(instance, "reading_plan", None) or "").strip()
    if not old or old == config["output"]["on_skip"]:
        outcome.value, outcome.should_write = config["output"]["on_skip"], True
    return outcome


def run_reading_plan(ai_config, instance):
    outcome = RunOutcome()
    try:
        config = validate_ai_config(ai_config, instance.__class__.__name__, "reading_plan")
        history = retrieve_customer_history(instance, config["context"]["history"], as_of=timezone.localdate())
        outcome.diagnostics = history.diagnostics
        if history.skip_reason:
            return _skip(outcome, config, instance, history.skip_reason)
        outcome.context = {"borrowed_books": [
            {key: row[key] for key in ("title", "category", "author")} for row in history.rows]}

        def caller(prompt, step):
            return perform_call(outcome, config, prompt, step.prompt_name)

        steps = [STEP_REGISTRY[name] for name in config["template"]["chain"]]
        result = ChainRunner(steps, caller).run(outcome.context)
        outcome.step_details = result.step_details
        outcome.prompts = [{key: d[key] for key in ("template", "template_sha256", "prompt", "prompt_sha256")}
                           for d in result.step_details if "prompt" in d]
        outcome.failed_step = result.failed_step
        outcome.parsed_output = {key: value.model_dump() for key, value in result.outputs.items()}
        if not result.success:
            outcome.error = {"code": result.error.code, "message": result.error.message}
            if result.error.code == "prompt_budget_exceeded":
                outcome.diagnostics["budget_kind"] = "prompt_chars"
                return _skip(outcome, config, instance, "prompt_budget_exceeded")
            outcome.status = "chain_error"
            return outcome
        outcome.value = result.outputs["plan"].summary
        outcome.should_write = True
    except Exception as exc:
        outcome.status, outcome.error = "action_error", safe_error(exc)
    return outcome
