<style>
/* Drag-and-drop sections */
[data-section-id] { position: relative; }
/* Full-width drag bar at top of section (starts below the top-resize handle) */
.si-move-bar {
  position: absolute; top: 6px; right: 6px;
  width: 24px; height: 24px;
  cursor: grab; z-index: 40;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity 0.15s, background 0.1s;
  user-select: none;
  background: rgba(255,255,255,0.92);
  border: 1px solid rgba(100,116,139,0.25);
  border-radius: 6px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.10);
}
.si-move-bar::after {
  content: '';
  display: block;
  width: 12px; height: 10px;
  background-image: radial-gradient(circle, rgba(100,116,139,0.7) 1.5px, transparent 1.5px);
  background-size: 4px 4px;
  background-repeat: repeat;
}
.si-move-bar:hover { background: rgba(241,245,249,0.98); }
.si-move-bar:active { cursor: grabbing; }
[data-section-id]:hover .si-move-bar { opacity: 1; pointer-events: auto; }
[data-section-id].si-dragging { opacity: 0.4; outline: 2px dashed #93c5fd; outline-offset: 4px; }
[data-section-id].si-drag-over { outline: 2px solid var(--accent, #3b82f6); outline-offset: 4px; background: color-mix(in srgb, var(--accent, #3b82f6) 5%, transparent); }
.si-drop-layer {
  position: fixed; inset: 0; z-index: 35;
  pointer-events: none;
}
.si-drop-zone {
  position: fixed; pointer-events: auto;
  display: flex; align-items: center; justify-content: center;
  color: var(--accent, #2563eb);
  background: color-mix(in srgb, var(--accent, #2563eb) 8%, transparent);
  border: 1px dashed color-mix(in srgb, var(--accent, #2563eb) 55%, transparent);
  border-radius: 10px;
  font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
  opacity: .25; transition: opacity .12s, background .12s, transform .12s;
}
.si-drop-zone.active {
  opacity: .95;
  background: color-mix(in srgb, var(--accent, #2563eb) 16%, white);
  transform: scale(1.01);
}
.si-drop-zone-header { top: 8px; left: 16px; right: 16px; height: 52px; }
.si-drop-zone-hero { top: 68px; left: 16px; right: 16px; height: 58px; }
.si-drop-zone-left-sidebar { top: 136px; left: 16px; bottom: 84px; width: 132px; }
.si-drop-zone-right-sidebar { top: 136px; right: 16px; bottom: 84px; width: 132px; }
.si-drop-zone-main { top: 136px; left: 160px; right: 160px; bottom: 84px; }
.si-drop-zone-footer { left: 16px; right: 16px; bottom: 16px; height: 56px; }

/* Section resize (left + right handles) */
.si-resize-handle, .si-lresize-handle {
  position: absolute; top: 0;
  width: 10px; height: 100%; min-height: 40px;
  cursor: col-resize; z-index: 30;
  opacity: 0; transition: opacity 0.15s;
}
.si-resize-handle  { right: 0; }
.si-lresize-handle { left: 0; }
[data-section-id]:hover .si-resize-handle,
[data-section-id]:hover .si-lresize-handle,
[data-section-id].si-resizing .si-resize-handle,
[data-section-id].si-resizing .si-lresize-handle { opacity: 1; }
.si-resize-handle::after {
  content: ''; position: absolute; right: 0; top: 50%; transform: translateY(-50%);
  width: 3px; height: 40px; background: var(--accent, #3b82f6);
  border-radius: 3px; box-shadow: 0 0 0 1px white;
}
.si-lresize-handle::after {
  content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 3px; height: 40px; background: var(--accent, #3b82f6);
  border-radius: 3px; box-shadow: 0 0 0 1px white;
}
.si-resize-snap-line {
  position: fixed; top: 0; bottom: 0; width: 2px;
  background: var(--accent, #3b82f6); opacity: 0.45;
  pointer-events: none; z-index: 9998;
}
.si-resize-tooltip {
  position: fixed; background: var(--accent, #3b82f6); color: white;
  font-size: 11px; font-weight: 600; padding: 2px 7px;
  border-radius: 4px; pointer-events: none; z-index: 9999;
  transform: translateX(-50%);
}

/* Section vertical resize (top + bottom handles) */
.si-vresize-handle, .si-tresize-handle {
  position: absolute; left: 0; right: 0;
  height: 10px; cursor: row-resize; z-index: 30;
  opacity: 0; transition: opacity 0.15s;
}
.si-vresize-handle { bottom: 0; }
.si-tresize-handle { top: 0; }
[data-section-id]:hover .si-vresize-handle,
[data-section-id]:hover .si-tresize-handle,
[data-section-id].si-vresizing .si-vresize-handle,
[data-section-id].si-vresizing .si-tresize-handle { opacity: 1; }
.si-vresize-handle::after {
  content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 40px; height: 3px; background: var(--accent, #3b82f6);
  border-radius: 3px; box-shadow: 0 0 0 1px white;
}
.si-tresize-handle::after {
  content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: 40px; height: 3px; background: var(--accent, #3b82f6);
  border-radius: 3px; box-shadow: 0 0 0 1px white;
}
.si-vresize-hline {
  position: fixed; left: 0; right: 0; height: 2px;
  background: var(--accent, #3b82f6); opacity: 0.4;
  pointer-events: none; z-index: 9998;
}
.si-vresize-tip {
  position: fixed; background: var(--accent, #3b82f6); color: white;
  font-size: 11px; font-weight: 600; padding: 2px 7px;
  border-radius: 4px; pointer-events: none; z-index: 9999;
}
/* Lift hovered/active section above adjacent content so handles are always on top */
[data-section-id]:hover { z-index: 5; }
[data-section-id].si-resizing, [data-section-id].si-vresizing { z-index: 10; }
/* Left/right insert indicators during drag-over */
[data-section-id].si-drag-before { box-shadow: inset 4px 0 0 0 var(--accent, #3b82f6); }
[data-section-id].si-drag-after  { box-shadow: inset -4px 0 0 0 var(--accent, #3b82f6); }
/* Drop row indicator: shown above/below a row during cross-row drag */
[data-section-id].si-drag-row-before { box-shadow: inset 0 4px 0 0 var(--accent, #3b82f6); }
[data-section-id].si-drag-row-after  { box-shadow: inset 0 -4px 0 0 var(--accent, #3b82f6); }
</style>
