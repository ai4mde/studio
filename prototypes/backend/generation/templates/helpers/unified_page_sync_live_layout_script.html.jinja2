<script>
(function() {
  var accentHex = '{{ tokens.get("accent.hex", "#0000a4") }}';
  var grid = document.getElementById('page-sections-grid');
  if (!grid) return;
  var secs = Array.from(grid.children);
  var byPos = { header: [], hero: [], main: [], sidebar: [], footer: [] };
  secs.forEach(function(el) {
    var pos = el.getAttribute('data-position') || 'main';
    if (byPos[pos]) byPos[pos].push(el); else byPos.main.push(el);
  });
  var hasNonMain = byPos.header.length || byPos.hero.length || byPos.sidebar.length || byPos.footer.length;
  if (!hasNonMain) return;
  var hasSidebarRegion = byPos.sidebar.length > 0;
  var _mainWidthMode = '{{ _main_width }}';

  var gap = 'gap-4';
  var wrap = document.createElement('div');
  wrap.className = 'flex flex-col gap-6';

  if (byPos.header.length) {
    var headerEl = document.createElement('div');
    headerEl.className = 'grid grid-cols-12 gap-4 pb-4 border-b border-gray-200';
    if ('{{ _header_width }}' === 'full') {
      headerEl.style.cssText = 'width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);padding-left:24px;padding-right:24px;';
    }
    byPos.header.forEach(function(el) { headerEl.appendChild(el); });
    wrap.appendChild(headerEl);
  }

  if (byPos.hero.length) {
    var heroEl = document.createElement('div');
    heroEl.className = 'rounded-2xl overflow-hidden grid grid-cols-12 gap-4';
    heroEl.style.cssText = 'background:linear-gradient(135deg,#fffbe6 0%,#fff9c4 50%,#fef3c7 100%);padding:40px 48px;';
    if ('{{ _hero_width }}' === 'full') {
      heroEl.style.cssText += 'width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);border-radius:0;';
    }
    byPos.hero.forEach(function(el) { heroEl.appendChild(el); });
    wrap.appendChild(heroEl);
  }

  var hasSidebar = hasSidebarRegion;
  var hasMain = byPos.main.length > 0;
  if (hasSidebar || hasMain) {
    var contentRow = document.createElement('div');
    contentRow.className = hasSidebar ? 'flex gap-6 items-start' : '';
    contentRow.dataset.regionRow = 'body';
    if (hasSidebar && _mainWidthMode === 'full') {
      contentRow.style.paddingLeft = '1.5rem';
      contentRow.style.paddingRight = '1.5rem';
    }
    var mainGrid = document.createElement('div');
    mainGrid.className = (hasSidebar ? 'flex-1 min-w-0 ' : '') + 'grid grid-cols-12 gap-4';
    byPos.main.forEach(function(el) { mainGrid.appendChild(el); });

    if (hasSidebar) {
    // Sidebar placement is explicit when style.sidebar_side is set.
    // Otherwise filters and navigation rails go left; summaries/actions stay right.
    var leftSidebarItems = [], rightSidebarItems = [];
    byPos.sidebar.forEach(function(el) {
      var lay = el.getAttribute('data-layout') || '';
      var side = (el.getAttribute('data-sidebar-side') || '').toLowerCase();
      if (side === 'right') rightSidebarItems.push(el);
      else if (side === 'left' || lay === 'filter-panel' || lay === 'filter' || lay === 'site-nav' || lay === 'nav-links' || lay === 'nav-bar' || lay === 'main-header' || lay === 'minimal-header' || lay === 'commerce-header' || lay === 'dashboard-header' || lay === 'split-header' || lay === 'app-header' || lay === 'compact-header' || lay === 'mega-header' || lay === 'hero-header' || lay === 'tabbed-header' || lay === 'glass-header' || lay === 'command-header' || lay === 'logo' || lay === 'search-bar' || lay === 'icon-actions') leftSidebarItems.push(el);
      else rightSidebarItems.push(el);
    });
    function sidebarSpan(items, fallback) {
      var vals = items.map(function(el) { return parseInt(el.dataset.sidebarWidth || '', 10); }).filter(function(n) { return Number.isFinite(n) && n > 0; });
      return Math.max(2, Math.min(6, vals.length ? Math.max.apply(null, vals) : fallback));
    }
    function sidebarBasis(span) {
      return 'calc((100% - 1.5rem) * ' + span + ' / 12)';
    }
    function applySidebarChrome(aside) {
      var bg = '{{ _sidebar_bg }}';
      var shadow = '{{ _sidebar_shadow }}';
      if (bg || (shadow && shadow !== 'none')) {
        aside.style.border = '1px solid var(--border-color)';
        aside.style.borderRadius = 'var(--radius-lg)';
        aside.style.padding = '1rem';
      }
      if (bg) {
        aside.style.background = bg === 'dark' ? '#111827' : bg === 'gray' ? '#f3f4f6' : bg === 'light' ? 'var(--region-main-bg-sunken)' : '#ffffff';
        if (bg === 'dark') {
          aside.style.color = '#ffffff';
        }
      }
      if (shadow && shadow !== 'none') {
        aside.style.boxShadow = shadow === 'xl' ? '0 20px 25px -5px rgb(0 0 0 / 0.12), 0 8px 10px -6px rgb(0 0 0 / 0.10)' : 'var(--shadow-' + shadow + ')';
      }
    }

    if (leftSidebarItems.length) {
      var leftEl = document.createElement('aside');
      var leftSpan = sidebarSpan(leftSidebarItems, 3);
      leftEl.className = 'flex-shrink-0 flex flex-col gap-4';
      leftEl.dataset.regionSide = 'left';
      leftEl.dataset.sidebarSpan = String(leftSpan);
      leftEl.style.flexBasis = sidebarBasis(leftSpan);
      leftEl.style.maxWidth = sidebarBasis(leftSpan);
      applySidebarChrome(leftEl);
      leftSidebarItems.forEach(function(el) { el.classList.add('w-full'); el.style.width = '100%'; leftEl.appendChild(el); });
      contentRow.appendChild(leftEl);
    }
    contentRow.appendChild(mainGrid);
    if (rightSidebarItems.length) {
      var rightEl = document.createElement('aside');
      var rightSpan = sidebarSpan(rightSidebarItems, 3);
      rightEl.className = 'flex-shrink-0 flex flex-col gap-4';
      rightEl.dataset.regionSide = 'right';
      rightEl.dataset.sidebarSpan = String(rightSpan);
      rightEl.style.flexBasis = sidebarBasis(rightSpan);
      rightEl.style.maxWidth = sidebarBasis(rightSpan);
      applySidebarChrome(rightEl);
      rightSidebarItems.forEach(function(el) { el.classList.add('w-full'); el.style.width = '100%'; rightEl.appendChild(el); });
      contentRow.appendChild(rightEl);
    }
    } else {
      contentRow.appendChild(mainGrid);
    }
    wrap.appendChild(contentRow);
  }

  if (byPos.footer.length) {
    var footerEl = document.createElement('div');
    footerEl.className = 'mt-8';
    footerEl.style.cssText = 'background:var(--region-footer-bg);color:var(--region-footer-text);';
    if ('{{ _footer_width }}' !== 'contained') {
      footerEl.style.cssText += 'width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);';
    }
    var footerInner = document.createElement('div');
    footerInner.className = ('{{ _footer_width }}' === 'contained' ? '{{ _container_class }} mx-auto ' : 'w-full ') + 'grid grid-cols-12 gap-4 px-8 py-6 border-t-4';
    footerInner.style.borderColor = accentHex;
    byPos.footer.forEach(function(el) { footerInner.appendChild(el); });
    footerEl.appendChild(footerInner);
    wrap.appendChild(footerEl);
  }

  grid.parentNode.replaceChild(wrap, grid);
})();
</script>
