      --text-subtle:          {{ tokens.get('text.subtle.hex', tokens.get('color.text.subtle_hex', '#9ca3af')) }};
      --region-header-bg:     {{ tokens.get('region.header.bg_hex', tokens.get('accent.hex', '#2563eb')) }};
