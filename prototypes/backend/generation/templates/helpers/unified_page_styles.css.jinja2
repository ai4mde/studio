      --text-body-lh:       {{ tokens.get('typography.body.line_height', tokens.get('typography.body-md.line_height', '1.6')) }};
      --text-caption-size:  {{ tokens.get('typography.caption.size', tokens.get('typography.caption-sm.size', '12px')) }};
      --text-label-size:    {{ tokens.get('typography.label.size', '14px') }};
