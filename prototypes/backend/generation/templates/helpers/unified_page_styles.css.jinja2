      --region-main-bg-sunken: {{ tokens.get('region.main.bg_sunken_hex', tokens.get('surface.3.hex', tokens.get('page.body.bg_hex', '#f9fafb'))) }};
      --region-sidebar-bg:    {{ tokens.get('region.sidebar.bg_hex', tokens.get('region.main.bg_hex', '#ffffff')) }};
