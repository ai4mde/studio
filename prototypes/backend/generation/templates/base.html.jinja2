{% raw %}{% load static %}{% endraw %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ application_name | capitalize }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href='{% raw %}{%{% endraw %} static '{{ application_name }}/{{ application_name }}_style.css' {% raw %}%}{% endraw %}'>
    <style>
        {% include "helpers/tailwind_fallback.css.jinja2" %}
    </style>
</head>
<body class="bg-gray-50 min-h-screen font-sans text-gray-800">
{% raw %}{% if request.GET.workflow_success %}{% endraw %}
<div class="mx-auto mt-4 max-w-6xl px-6">
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800 shadow-sm">
        <span>
            Success. The workflow has moved to the next task{% raw %}{% if request.GET.workflow_next_actor %}{% endraw %}
            for {% raw %}{{ request.GET.workflow_next_actor }}{% endraw %}{% raw %}{% endif %}{% endraw %}.
        </span>
        {% raw %}{% if request.GET.workflow_next_login %}{% endraw %}
        <a href="{% raw %}{{ request.GET.workflow_next_login }}{% endraw %}" class="rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">
            Open next task
        </a>
        {% raw %}{% elif request.GET.workflow_next %}{% endraw %}
        <a href="{% raw %}{{ request.GET.workflow_next }}{% endraw %}" class="rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">
            Open next task
        </a>
        {% raw %}{% endif %}{% endraw %}
    </div>
</div>
{% raw %}{% endif %}{% endraw %}

{%- set _accent_hex = _accent_hex if _accent_hex is defined else (styling.accent_color if styling and styling.accent_color else '#0000a4') %}
{%- set _brand_name = _brand_name if _brand_name is defined else application_name %}
{%- set _container_class = tokens.get('page.container.class', 'max-w-6xl') if tokens is defined else 'max-w-6xl' %}
{%- set _raw_page_layout = page.layout if page is defined and page.layout is defined and page.layout else {} %}
{%- set _main_width = _raw_page_layout.main_width if _raw_page_layout.main_width is defined and _raw_page_layout.main_width else 'contained' %}
{%- set _header_width = _raw_page_layout.header_width if _raw_page_layout.header_width is defined and _raw_page_layout.header_width else 'contained' %}
{%- set _footer_width = _raw_page_layout.footer_width if _raw_page_layout.footer_width is defined and _raw_page_layout.footer_width else 'contained' %}
{%- set _layout_has_sidebar = [] %}
{%- set _layout_has_header = [] %}
{%- for sc in (page.section_components if page is defined and page.section_components is defined else []) %}
  {%- if sc.position == 'sidebar' %}{% set _ = _layout_has_sidebar.append(1) %}{%- endif %}
  {%- if sc.position == 'header' %}{% set _ = _layout_has_header.append(1) %}{%- endif %}
{%- endfor %}
{%- if not _main_width or _main_width not in ['contained', 'wide', 'full'] %}{% set _main_width = 'contained' %}{%- endif %}
{%- if not _header_width or _header_width not in ['contained', 'full'] %}{% set _header_width = 'contained' %}{%- endif %}
{%- if not _footer_width or _footer_width not in ['contained', 'full'] %}{% set _footer_width = 'contained' %}{%- endif %}
{%- set _main_container_class = 'max-w-none w-full' if _main_width == 'full' else ('max-w-7xl' if _main_width == 'wide' else _container_class) %}
{%- set _header_shell_class = 'w-full px-6' if _header_width == 'full' else _container_class ~ ' mx-auto px-6' %}
{%- set _footer_shell_class = 'w-full px-8' if _footer_width == 'full' else _container_class ~ ' mx-auto px-8' %}
{%- set _header_chrome = ['promo-bar','promo-strip','logo','search-bar','icon-actions','nav','nav-links','nav-bar','main-header','minimal-header','commerce-header','dashboard-header','split-header','app-header','compact-header','mega-header','hero-header','tabbed-header','glass-header','command-header','site-nav'] %}
{%- set _footer_chrome = ['service-bar','service-strip','link-grid','footer-links','brand-strip','footer-brand','site-footer','compact-footer','legal-footer','newsletter-footer','social-footer','mega-footer','split-footer','app-footer','cta-footer','minimal-footer'] %}
{%- set _header_secs = [] %}
{%- set _footer_secs = [] %}
{%- set _has_header_chrome = [] %}
{%- set _has_footer_chrome = [] %}
{%- set _has_header_chrome_keys = [] %}
{%- set _has_footer_chrome_keys = [] %}
{%- for sc in header_sections or [] %}
  {%- if sc.layout in _header_chrome %}{% set _ = _header_secs.append(sc) %}{%- endif %}
{%- endfor %}
{%- for sc in footer_sections or [] %}
  {%- if sc.layout in _footer_chrome %}{% set _ = _footer_secs.append(sc) %}{%- endif %}
{%- endfor %}
{%- set _chrome_scan_pages = [page] if page is defined else (pages or []) %}
{%- for pg in _chrome_scan_pages %}
  {%- for sc in pg.section_components or [] %}
    {%- if sc.layout in _header_chrome or sc.position == 'header' %}
      {%- set _chrome_key = sc.id if sc.id is defined and sc.id else sc %}
      {%- if _chrome_key not in _has_header_chrome_keys %}
        {%- set _ = _has_header_chrome_keys.append(_chrome_key) %}
        {%- set _ = _has_header_chrome.append(sc) %}
      {%- endif %}
    {%- endif %}
    {%- if sc.layout in _footer_chrome or sc.position == 'footer' %}
      {%- set _chrome_key = sc.id if sc.id is defined and sc.id else sc %}
      {%- if _chrome_key not in _has_footer_chrome_keys %}
        {%- set _ = _has_footer_chrome_keys.append(_chrome_key) %}
        {%- set _ = _has_footer_chrome.append(sc) %}
      {%- endif %}
    {%- endif %}
  {%- endfor %}
{%- endfor %}
{%- set _search_pages = pages | selectattr('type', 'equalto', 'normal') | list %}
{%- set _search_page = _search_pages[0] if _search_pages else none %}

{% raw %}{% block chrome_header %}{% endraw %}
{%- set _main_row_open = [] %}
{%- for sc in (_has_header_chrome if _has_header_chrome else _header_secs) %}
{%- set _inline_lay = sc.layout in ('logo', 'search-bar', 'icon-actions') %}
{%- if _inline_lay and not _main_row_open %}
  {%- set _ = _main_row_open.append(1) %}
  {%- set _row_style = sc.style if sc.style is defined and sc.style else {} %}
  {%- set _row_variant = _row_style.get('header_variant', '') %}
<header class="{% if _row_variant == 'split-dark' %}{{ _header_shell_class }} py-3 flex items-center gap-4 shadow-sm{% elif _row_variant == 'showcase' %}bg-white {{ _header_shell_class }} py-5 flex items-center gap-5 border-b border-gray-100 shadow-sm{% else %}bg-white {{ _header_shell_class }} py-3 flex items-center gap-4{% endif %}" style="{% if _row_variant == 'split-dark' %}background-color:#111827;color:#ffffff;{% endif %}" data-position="header" data-layout="main-header-row" data-header-variant="{{ _row_variant }}">
{%- elif not _inline_lay and _main_row_open %}
  {%- set _ = _main_row_open.clear() %}
</header>
{%- endif %}

{%- if sc.layout in ('promo-bar', 'promo-strip') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="{{ sc.layout }}">
    <div style="background-color:{{ _accent_hex }};" class="{{ _header_shell_class }} py-1.5 flex items-center justify-between text-xs text-white select-none">
        <div class="flex items-center gap-6">
            {%- for m in sc.custom_methods[:3] %}
            <span>{{ m }}</span>
            {%- endfor %}
        </div>
        {%- if sc.text %}<span>{{ sc.text }}</span>{%- endif %}
    </div>
</div>

{%- elif sc.layout == 'logo' %}
{%- set _sc_style = sc.style if sc.style is defined and sc.style else {} %}
{%- set _logo_url = _sc_style.get('logo_url') or _sc_style.get('image_url') or (tokens.get('brand.logo_url', '') if tokens is defined else '') %}
{%- set _logo_size_px = {'sm':'28','md':'36','lg':'48','xl':'60'}.get(_sc_style.get('logo_size', 'md'), '36') %}
{%- set _logo_shape = _sc_style.get('logo_shape', 'rounded') %}
{%- set _logo_variant = _sc_style.get('logo_variant', 'lockup') %}
{%- set _tagline = _sc_style.get('tagline') or _sc_style.get('subtitle') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="logo">
    <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="inline-flex items-center gap-3 leading-none min-w-0">
        {%- if _logo_url %}
        <img src="{{ _logo_url }}" alt="{{ sc.text or _brand_name }}" class="shrink-0 object-cover {% if _logo_shape == 'circle' %}rounded-full{% elif _logo_shape == 'square' %}rounded-md{% else %}rounded-xl{% endif %}" style="width:{{ _logo_size_px }}px;height:{{ _logo_size_px }}px;">
        {%- endif %}
        {%- if _logo_variant != 'image-only' %}
        <span class="flex flex-col min-w-0">
            <span class="text-3xl font-black truncate" style="color:{% if _sc_style.get('header_variant') == 'split-dark' or _sc_style.get('bg') == 'dark' %}#ffffff{% else %}{{ _accent_hex }}{% endif %};font-family:'Georgia',serif;letter-spacing:-1px;">{{ sc.text or _sc_style.get('logo_text') or _brand_name }}{% if _sc_style.get('dot', true) not in [false, 'false', '0', 'no'] %}.{% endif %}</span>
            {%- if _tagline %}<span class="text-xs font-medium {% if _sc_style.get('header_variant') == 'split-dark' or _sc_style.get('bg') == 'dark' %}text-gray-300{% else %}text-gray-500{% endif %} mt-1 truncate">{{ _tagline }}</span>{%- endif %}
        </span>
        {%- endif %}
    </a>
</div>

{%- elif sc.layout == 'search-bar' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="search-bar" class="flex-1">
    {%- set _sc_style = sc.style if sc.style is defined and sc.style else {} %}
    <form action="{% if _search_page %}{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ _search_page }}' {% raw %}%}{% endraw %}{% else %}{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}{% endif %}" method="get" class="flex items-center rounded-full border-2 overflow-hidden {% if _sc_style.get('header_variant') == 'split-dark' %}bg-white/95{% endif %}" style="border-color:{{ _accent_hex }};">
        <input name="q" class="flex-1 px-4 py-2.5 text-sm outline-none text-gray-700 bg-white" placeholder="{{ sc.text or sc.display_name }}" type="search" value="{% raw %}{{ request.GET.q }}{% endraw %}" />
        <button type="submit" class="px-4 py-3" style="background-color:{{ _accent_hex }};">
            <svg class="w-4 h-4" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
    </form>
</div>

{%- elif sc.layout == 'icon-actions' %}
{%- set _sc_style = sc.style if sc.style is defined and sc.style else {} %}
{%- set _action_variant = _sc_style.get('action_variant', 'link') %}
{%- set _show_logout = _sc_style.get('show_logout', true) not in [false, 'false', '0', 'no', 'hidden'] %}
{%- set _logout_label = _sc_style.get('logout_label', 'Logout') %}
{%- set _action_cls = 'si-btn si-btn-primary px-3 py-2 text-sm font-semibold' if _action_variant == 'button' else ('si-btn si-btn-ghost px-3 py-2 text-sm font-semibold' if _action_variant == 'ghost' else 'cursor-pointer hover:opacity-75 whitespace-nowrap') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="icon-actions">
    <div class="flex items-center gap-3 text-sm {% if _sc_style.get('header_variant') == 'split-dark' or _sc_style.get('bg') == 'dark' %}text-white{% else %}text-gray-700{% endif %} shrink-0">
        {%- if sc.custom_methods %}
        {%- for m in sc.custom_methods %}
        <span class="{{ _action_cls }}">{{ m }}</span>
        {%- endfor %}
        {%- else %}
        {%- if _show_logout %}<a href="{% raw %}{% url 'logout' %}{% endraw %}" class="{{ _action_cls }}">{{ _logout_label }}</a>{%- endif %}
        <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="cursor-pointer hover:opacity-75 text-xl leading-none">♡</a>
        <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="relative cursor-pointer">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>

        </a>
        {%- endif %}
    </div>
</div>

{%- elif sc.layout in ('main-header','commerce-header','dashboard-header','split-header','app-header','mega-header','hero-header','tabbed-header','glass-header','command-header') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="main-header">
    <header class="bg-white {{ _header_shell_class }} py-3 flex items-center gap-4">
        <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="text-3xl font-black shrink-0 leading-none" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-1px;">{{ _brand_name }}.</a>
        <form action="{% if _search_page %}{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ _search_page }}' {% raw %}%}{% endraw %}{% else %}{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}{% endif %}" method="get" class="flex-1 flex items-center rounded-full border-2 overflow-hidden" style="border-color:{{ _accent_hex }};">
            <input name="q" class="flex-1 px-4 py-2.5 text-sm outline-none text-gray-700 bg-white" placeholder="{{ sc.text or sc.display_name }}" type="search" value="{% raw %}{{ request.GET.q }}{% endraw %}" />
            <button type="submit" class="px-4 py-3" style="background-color:{{ _accent_hex }};">
                <svg class="w-4 h-4" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
        </form>
        <div class="flex items-center gap-5 text-sm text-gray-700 shrink-0">
            <a href="{% raw %}{% url 'logout' %}{% endraw %}" class="cursor-pointer hover:opacity-75 whitespace-nowrap">Logout</a>
            <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="cursor-pointer hover:opacity-75 text-xl leading-none">♡</a>
            <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="relative cursor-pointer">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>

            </a>
        </div>
    </header>
</div>

{%- elif sc.layout in ('nav', 'nav-links', 'nav-bar') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="{{ sc.layout }}">
    {%- set _sc_style = sc.style if sc.style is defined and sc.style else {} %}
    <nav class="{% if _sc_style.get('nav_variant') == 'pills' %}bg-white border-b border-gray-100{% else %}bg-white border-b border-gray-200 sticky top-0 z-40{% endif %}">
        <div class="{{ _header_shell_class }} flex items-center justify-between text-sm whitespace-nowrap py-2 overflow-x-auto">
            <div class="flex items-center gap-0">
                <span class="flex items-center gap-1.5 px-3 py-1.5 font-medium text-gray-700 cursor-pointer hover:bg-gray-100 rounded mr-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    {{ sc.custom_methods[0] if sc.custom_methods else sc.display_name }} ▾
                </span>
                {%- for p in (pages or []) %}
                {%- if p.type == 'activity' %}
                <span class="px-3 py-1.5 cursor-default rounded font-medium transition-colors {% if page is defined and p.display_name == page.display_name %}border-b-2 font-bold{% else %}text-gray-700{% endif %}"
                   style="{{ ('border-color:'+_accent_hex+';color:'+_accent_hex) if page is defined and p.display_name == page.display_name else '' }}">{{ p.display_name }}</span>
                {%- else %}
                <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ p }}' {% raw %}%}{% endraw %}"
                   class="{% if _sc_style.get('nav_variant') == 'pills' %}px-3 py-2 cursor-pointer rounded-full font-semibold transition-colors {% if page is defined and p.display_name == page.display_name %}text-white{% else %}text-gray-700 hover:bg-gray-100{% endif %}{% else %}px-3 py-1.5 cursor-pointer rounded font-medium transition-colors {% if page is defined and p.display_name == page.display_name %}border-b-2 font-bold{% else %}text-gray-700 hover:bg-gray-100{% endif %}{% endif %}"
                   style="{% if _sc_style.get('nav_variant') == 'pills' and page is defined and p.display_name == page.display_name %}background-color:{{ _accent_hex }};{% elif page is defined and p.display_name == page.display_name %}border-color:{{ _accent_hex }};color:{{ _accent_hex }}{% endif %}">{{ p.display_name }}</a>
                {%- endif %}
                {%- endfor %}
                {%- for m in sc.custom_methods[1:4] %}
                <span class="px-3 py-1.5 cursor-pointer rounded text-gray-700 hover:bg-gray-100">{{ m }}</span>
                {%- endfor %}
            </div>
            <div class="flex items-center gap-4 text-gray-500 text-xs shrink-0">
                {%- for m in sc.custom_methods[4:] %}
                <span class="cursor-pointer hover:text-gray-800">{{ m }}</span>
                {%- endfor %}
            </div>
        </div>
    </nav>
</div>

{%- elif sc.layout == 'minimal-header' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="minimal-header">
    <header class="bg-white border-b border-gray-200 {{ _header_shell_class }} py-4 flex items-center justify-between">
        <div class="text-2xl font-black" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-1px;">{{ _brand_name }}.</div>
        <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="flex items-center gap-2 border-2 rounded-xl px-4 py-2 text-sm font-semibold hover:bg-gray-50" style="border-color:{{ _accent_hex }};color:{{ _accent_hex }};">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            {{ sc.text or '0,00' }}
        </a>
    </header>
</div>

{%- elif sc.layout == 'site-nav' %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="header" data-layout="site-nav">
    <div style="background-color:{{ _accent_hex }};" class="{{ _header_shell_class }} py-1.5 flex items-center justify-between text-xs text-white select-none">
        <div class="flex items-center gap-6">
            {%- for m in sc.custom_methods[:3] %}
            <span>{{ m }}</span>
            {%- endfor %}
        </div>
        {%- if sc.text %}<span>{{ sc.text }}</span>{%- endif %}
    </div>
    <header class="bg-white {{ _header_shell_class }} py-3 flex items-center gap-4">
        <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="text-3xl font-black shrink-0 leading-none" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-1px;">{{ _brand_name }}.</a>
        <form action="{% if _search_page %}{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ _search_page }}' {% raw %}%}{% endraw %}{% else %}{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}{% endif %}" method="get" class="flex-1 flex items-center rounded-full border-2 overflow-hidden" style="border-color:{{ _accent_hex }};">
            <input name="q" class="flex-1 px-4 py-2.5 text-sm outline-none text-gray-700 bg-white" placeholder="{{ sc.text or sc.display_name }}" type="search" value="{% raw %}{{ request.GET.q }}{% endraw %}" />
            <button type="submit" class="px-4 py-3" style="background-color:{{ _accent_hex }};">
                <svg class="w-4 h-4" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
        </form>
        <div class="flex items-center gap-5 text-sm text-gray-700 shrink-0">
            <a href="{% raw %}{% url 'logout' %}{% endraw %}" class="cursor-pointer hover:opacity-75">Logout</a>
            <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="cursor-pointer hover:opacity-75 text-xl leading-none">♡</a>
            <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="relative cursor-pointer"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></a>
        </div>
    </header>
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-40">
        <div class="{{ _header_shell_class }} flex items-center justify-between text-sm whitespace-nowrap py-2 overflow-x-auto">
            <div class="flex items-center gap-0">
                <span class="flex items-center gap-1.5 px-3 py-1.5 font-medium text-gray-700 cursor-pointer hover:bg-gray-100 rounded mr-1"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>{{ sc.custom_methods[0] if sc.custom_methods else sc.display_name }} ▾</span>
                {%- for p in (pages or []) %}
                {%- if p.type == 'activity' %}
                <span class="px-3 py-1.5 cursor-default rounded font-medium transition-colors {% if page is defined and p.display_name == page.display_name %}border-b-2 font-bold{% else %}text-gray-700{% endif %}"
                   style="{{ ('border-color:'+_accent_hex+';color:'+_accent_hex) if page is defined and p.display_name == page.display_name else '' }}">{{ p.display_name }}</span>
                {%- else %}
                <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ p }}' {% raw %}%}{% endraw %}"
                   class="px-3 py-1.5 cursor-pointer rounded font-medium transition-colors {% if page is defined and p.display_name == page.display_name %}border-b-2 font-bold{% else %}text-gray-700 hover:bg-gray-100{% endif %}"
                   style="{{ ('border-color:'+_accent_hex+';color:'+_accent_hex) if page is defined and p.display_name == page.display_name else '' }}">{{ p.display_name }}</a>
                {%- endif %}
                {%- endfor %}
            </div>
            <div class="flex items-center gap-4 text-gray-500 text-xs">{%- for m in sc.custom_methods[4:] %}<span class="cursor-pointer hover:text-gray-800">{{ m }}</span>{%- endfor %}</div>
        </div>
    </nav>
</div>

{%- endif %}
{%- endfor %}
{%- if _main_row_open %}</header>{%- endif %}

{% if not _header_secs and not _has_header_chrome %}
{# Fallback: section-style composed header when no header section components are defined #}
{%- set _fallback_logo = namespace(url='') %}
{%- if tokens is defined and tokens.get('brand.logo_url', '') %}
  {%- set _fallback_logo.url = tokens.get('brand.logo_url') %}
{%- elif logo is defined and logo %}
  {%- set _fallback_logo.url = logo %}
{%- endif %}
<header class="bg-white border-b border-gray-200 shadow-sm">
    <div class="{{ _header_shell_class }} py-3 flex items-center gap-4">
        <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="inline-flex items-center gap-3 shrink-0 min-w-0">
            {%- if _fallback_logo.url %}<img src="{{ _fallback_logo.url }}" class="h-9 w-9 rounded-xl object-cover" alt="{{ _brand_name }}">{%- endif %}
            <span class="text-2xl font-black truncate" style="color:{{ _accent_hex }};font-family:'Georgia',serif;">{{ application_name | capitalize }}.</span>
        </a>
        <form action="{% if _search_page %}{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ application_name }}_{{ _search_page }}' {% raw %}%}{% endraw %}{% else %}{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}{% endif %}" method="get" class="flex-1 flex items-center rounded-full border-2 overflow-hidden bg-white" style="border-color:{{ _accent_hex }};">
            <input name="q" class="flex-1 px-4 py-2.5 text-sm outline-none text-gray-700 bg-white" placeholder="Site Navigation" type="search" value="{% raw %}{{ request.GET.q }}{% endraw %}" />
            <button type="submit" class="px-4 py-3" style="background-color:{{ _accent_hex }};">
                <svg class="w-4 h-4" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
        </form>
    {% if authentication_present -%}
        <a href="{% raw %}{% url 'logout' %}{% endraw %}" class="text-sm text-gray-700 hover:opacity-75 whitespace-nowrap">Logout</a>
    {%- else -%}
        <a href="{% raw %}{% url 'noauth_home-homerender' %}{% endraw %}" class="text-sm text-gray-700 hover:opacity-75 whitespace-nowrap">Other Application</a>
    {%- endif %}
    </div>
</header>
<nav class="bg-white border-b border-gray-200 sticky top-0 z-40">
    <div class="{{ _header_shell_class }} flex items-center gap-6 text-sm font-medium text-gray-700 overflow-x-auto whitespace-nowrap py-2.5">
        <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}-homerender' {% raw %}%}{% endraw %}" class="hover:text-gray-900 transition-colors">Home</a>
        {% if settings and settings.manager_access %}
        <span class="text-gray-300">|</span>
        <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}_action_log' {% raw %}%}{% endraw %}" class="hover:text-gray-900 transition-colors">Activity log</a>
        <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:{{ application_name }}_change_user_assignment' {% raw %}%}{% endraw %}" class="hover:text-gray-900 transition-colors">User assignment</a>
        {% endif %}
        {% for category in categories %}
        <span class="text-gray-300">|</span>
        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">{{ category }}</span>
        {% for page in pages %}
        {% if page.type == 'normal' and page.category == category.name %}
        <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ page.application }}_{{ page }}' {% raw %}%}{% endraw %}" class="hover:text-gray-900 transition-colors">{{ page.display_name }}</a>
        {% endif %}
        {% endfor %}
        {% endfor %}
        {% for page in pages %}
        {% if page.category in ["", none] and page.type != 'activity' %}
        <a href="{% raw %}{%{% endraw %} url '{{ application_namespace }}:render_{{ page.application }}_{{ page }}' {% raw %}%}{% endraw %}" class="hover:text-gray-900 transition-colors">{{ page.display_name }}</a>
        {% endif %}
        {% endfor %}
    </div>
</nav>
{% endif %}
{% raw %}{% endblock %}{% endraw %}

<main class="py-6 {% raw %}{% block main_shell_class %}{% endraw %}{% if _main_width == 'full' %}w-full max-w-none px-0{% else %}px-6 {{ _main_container_class }} mx-auto{% endif %}{% raw %}{% endblock %}{% endraw %}" style="background-color:var(--page-bg);">
    {% raw %}{% block content %}{% endblock %}{% endraw %}
</main>

{% raw %}{% block chrome_footer %}{% endraw %}
{%- set _link_row_open = [] %}
{%- for sc in (_has_footer_chrome if _has_footer_chrome else _footer_secs) %}
{%- set _is_link_grid = sc.layout in ('footer-links', 'link-grid') %}
{%- if _is_link_grid and not _link_row_open %}
  {%- set _ = _link_row_open.append(1) %}
<div class="bg-white border-t border-gray-100 {{ _footer_shell_class }} py-8 flex gap-8 text-sm flex-wrap">
{%- elif not _is_link_grid and _link_row_open %}
  {%- set _ = _link_row_open.clear() %}
</div>
{%- endif %}

{%- if sc.layout in ('service-strip', 'service-bar') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="footer" data-layout="service-strip">
    <div class="{{ _footer_shell_class }} py-4 flex items-center gap-8" style="background-color:{{ _accent_hex }};">
        <span class="text-white font-bold text-base shrink-0">{{ sc.display_name }}</span>
        <div class="flex items-center gap-6 text-sm text-white flex-wrap">
            {%- for m in sc.custom_methods %}
            <span class="cursor-pointer hover:opacity-80 flex items-center gap-1.5">{{ m }}</span>
            {%- endfor %}
        </div>
    </div>
</div>

{%- elif sc.layout in ('footer-links', 'link-grid') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="footer" data-layout="link-grid" class="flex-1 min-w-36">
    <h4 class="font-bold text-gray-800 mb-3">{{ sc.display_name }}</h4>
    <ul class="space-y-2 text-gray-600">
        {%- for m in sc.custom_methods %}
        <li class="cursor-pointer hover:underline">{{ m }}</li>
        {%- endfor %}
    </ul>
</div>

{%- elif sc.layout in ('footer-brand', 'brand-strip') %}
<div data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="footer" data-layout="footer-brand">
    <div class="bg-white border-t border-gray-200 {{ _footer_shell_class }} py-6 flex flex-col items-center gap-2">
        <div class="text-3xl font-black" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-2px;">{{ _brand_name }}</div>
        <p class="text-xs text-gray-400">{{ sc.text }}</p>
        <div class="flex items-center gap-3 text-xs text-gray-400 mt-1">
            {%- for m in sc.custom_methods %}
            <span class="cursor-pointer hover:underline">{{ m }}</span><span>|</span>
            {%- endfor %}
        </div>
    </div>
</div>

{%- elif sc.layout in ('site-footer', 'mega-footer', 'legal-footer', 'newsletter-footer', 'compact-footer', 'split-footer', 'app-footer', 'cta-footer', 'minimal-footer') %}
<footer class="mt-0" data-section-id="{{ sc.id }}" data-section-name="{{ sc.display_name }}" data-position="footer">
    <div class="{{ _footer_shell_class }} py-5 flex items-center gap-8" style="background-color:{{ _accent_hex }};">
        <span class="text-white font-bold text-lg">{{ sc.display_name }}</span>
        <div class="flex items-center gap-6 text-sm text-white opacity-80">
            {%- for m in sc.custom_methods %}
            <span class="cursor-pointer hover:opacity-100">{{ m }}</span>
            {%- endfor %}
        </div>
    </div>
    <div class="bg-white {{ _footer_shell_class }} py-8 text-sm border-t border-gray-100">
        {%- if sc.text %}
        {{ sc.text }}
        {%- endif %}
    </div>
    <div class="bg-white border-t border-gray-200 {{ _footer_shell_class }} py-8 flex flex-col items-center gap-2">
        <div class="text-4xl font-black" style="color:{{ _accent_hex }};font-family:'Georgia',serif;letter-spacing:-2px;">{{ _brand_name }}</div>
    </div>
</footer>

{%- endif %}
{%- endfor %}
{%- if _link_row_open %}</div>{%- endif %}
{% raw %}{% endblock %}{% endraw %}

<style>
:root {
  --accent:        {{ tokens.get('accent.hex', _accent_hex) }};
  --page-bg:       {{ tokens.get('page.bg.hex', tokens.get('region.main.bg_hex', tokens.get('page.body.bg_hex', '#f9fafb'))) }};
  --page-text:     {{ tokens.get('page.text.hex', tokens.get('page.body.text_hex', '#111827')) }};
  --border-strong: {{ tokens.get('border.strong.hex', tokens.get('region.border_strong_hex', '#d1d5db')) }};
  --shadow-lg:     {{ tokens.get('shadow.lg', '0 10px 15px -3px rgb(0 0 0 / 0.10)') }};
}
body { background-color: var(--page-bg) !important; }
.si-sel-item { position: relative; cursor: pointer; }
.si-sel-item .si-sel-cb { position: absolute; top: 8px; left: 8px; z-index: 10; width: 18px; height: 18px; border-radius: 4px; border: 2px solid var(--border-strong); background: white; display: flex; align-items: center; justify-content: center; cursor: pointer; opacity: 0; transition: opacity 0.15s; }
.si-sel-item:hover .si-sel-cb, .si-sel-item.si-selected .si-sel-cb { opacity: 1; }
.si-sel-item.si-selected .si-sel-cb { background: var(--accent); border-color: var(--accent); }
.si-sel-item.si-selected .si-sel-cb::after { content: ''; display: block; width: 5px; height: 9px; border: 2px solid white; border-top: none; border-left: none; transform: rotate(45deg) translate(-1px, -1px); }
.si-sel-item.si-selected { outline: 2px solid var(--accent); outline-offset: 2px; }
.si-sel-bar { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(8px); background: var(--page-text); color: white; padding: 10px 20px; border-radius: 100px; display: flex; align-items: center; gap: 16px; font-size: 13px; font-weight: 500; box-shadow: var(--shadow-lg); z-index: 9999; opacity: 0; pointer-events: none; transition: opacity 0.2s, transform 0.2s; }
.si-sel-bar.active { opacity: 1; pointer-events: auto; transform: translateX(-50%) translateY(0); }
.si-sel-bar button { background: transparent; border: 1px solid rgba(255,255,255,.4); color: white; padding: 4px 14px; border-radius: 100px; cursor: pointer; font-size: 12px; }
.si-sel-bar button.danger { background: #ef4444; border-color: #ef4444; }
</style>
<script>
(function() {
  var bars = {};
  document.querySelectorAll('[data-selectable]').forEach(function(grid) {
    var sid = grid.dataset.selectable;
    var bar = document.createElement('div');
    bar.className = 'si-sel-bar';
    bar.id = 'sel-bar-' + sid;
    bar.innerHTML = '<span class="sel-count">0 selected</span>'
      + '<button onclick="siSelClear(\'' + sid + '\')">Clear</button>'
      + '<button class="danger" onclick="siSelDeleteLive(\'' + sid + '\')">Delete selected</button>';
    document.body.appendChild(bar);
    bars[sid] = bar;
  });
  window.siSelUpdate = function(sid) {
    var grid = document.querySelector('[data-selectable="' + sid + '"]');
    if (!grid) return;
    var n = grid.querySelectorAll('.si-selected').length;
    var bar = bars[sid]; if (!bar) return;
    bar.querySelector('.sel-count').textContent = n + ' selected';
    bar.classList.toggle('active', n > 0);
  };
  window.siSelClear = function(sid) {
    var g = document.querySelector('[data-selectable="' + sid + '"]');
    if (g) g.querySelectorAll('.si-selected').forEach(function(e){e.classList.remove('si-selected');});
    siSelUpdate(sid);
  };
  window.siSelDeleteLive = function(sid) {
    var g = document.querySelector('[data-selectable="' + sid + '"]');
    if (!g) return;
    var urls = [];
    g.querySelectorAll('.si-selected[data-delete-url]').forEach(function(el){ urls.push(el.dataset.deleteUrl); });
    if (!urls.length) return;
    var tok = document.cookie.match(/csrftoken=([^;]+)/);
    var csrf = tok ? tok[1] : '';
    var done = 0;
    urls.forEach(function(url) {
      fetch(url, { method: 'POST', headers: { 'X-CSRFToken': csrf } })
        .then(function(){ if (++done === urls.length) location.reload(); });
    });
  };
  document.addEventListener('click', function(e) {
    var item = e.target.closest('.si-sel-item[data-selectable-sid]');
    if (!item) return;
    if (e.target.closest('a,button,input,select,form')) return;
    var sid = item.dataset.selectableSid;
    var grid = item.closest('[data-selectable]');
    if (e.shiftKey && grid) {
      var items = Array.from(grid.querySelectorAll('.si-sel-item'));
      var last = grid.querySelector('.si-last-sel');
      var s = last ? items.indexOf(last) : 0, en = items.indexOf(item);
      if (s > en) { var t = s; s = en; en = t; }
      items.slice(s, en + 1).forEach(function(el){ el.classList.add('si-selected'); });
    } else {
      item.classList.toggle('si-selected');
      if (item.classList.contains('si-selected') && grid) {
        grid.querySelectorAll('.si-last-sel').forEach(function(el){el.classList.remove('si-last-sel');});
        item.classList.add('si-last-sel');
      }
    }
    siSelUpdate(sid);
  }, true);
})();
</script>

</body>
</html>
