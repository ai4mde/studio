class GenericListView(GenericViewMixin, ListView):
    allowed_actions = {}

    def get_queryset(self):
        return self.page_queryset(self.model)

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        self._add_create_context(context)
        self._add_update_context(context)
        return context

    def post(self, request, *args, **kwargs):
        self._execute_custom_method()
        return redirect(request.path)

    def _get_related_keys(self, partial_key):
        return [key for key in self.request.GET if key.startswith(partial_key) and key != partial_key]

    def _add_create_context(self, context):
        for key in self._get_related_keys("create_"):
            if self.request.GET[key] == "true":
                context[key] = True
                break

    def _add_update_context(self, context):
        models = {model.__name__: model for model in self.page_models}
        for key in self._get_related_keys("instance_id_"):
            model = models.get(key[len("instance_id_"):])
            if model is None:
                raise PermissionDenied("Model is not declared on this page")
            value = positive_pk(self.request.GET[key])
            if value is None:
                raise BadRequest("Invalid object id")
            context["update_instance"] = get_object_or_404(self.page_queryset(model), pk=value)
            break

    def _execute_custom_method(self):
        keys = [key for key in self.request.POST if key.startswith("custom_")]
        if len(keys) != 1 or len(self.request.POST.getlist(keys[0])) != 1:
            raise BadRequest("Exactly one action and one target are required")
        key = keys[0]
        if key not in self.allowed_actions:
            raise PermissionDenied("Action is not declared on this page")
        model, method = self.allowed_actions[key]
        value = positive_pk(self.request.POST[key])
        if value is None:
            raise BadRequest("Invalid object id")
        instance = get_object_or_404(self.page_queryset(model), pk=value)
        outcome = getattr(instance, method)()
        {% if library_ai_enabled %}
        if isinstance(outcome, RunOutcome):
            if outcome.status == "success":
                messages.success(self.request, "Your reading plan has been updated.")
            elif outcome.status == "skipped":
                reasons = {
                    "empty_history": "there are no completed borrowing records",
                    "no_valid_history": "there is no usable completed borrowing history",
                    "history_budget_exceeded": "the history exceeds this demonstrator's processing limit",
                    "prompt_budget_exceeded": "the input exceeds this demonstrator's processing limit",
                }
                reason = reasons.get(outcome.skip_reason, "the required history is unavailable")
                suffix = " Your previous plan has been kept." if not outcome.should_write else ""
                messages.info(self.request, "No new reading plan was generated because " + reason + "." + suffix)
            else:
                messages.error(self.request, "A new reading plan could not be generated. Any existing plan has been kept.")
        {% endif %}


class GenericCreateView(GenericViewMixin, CreateView):
    fields = None
    success_url = None


class GenericUpdateView(GenericViewMixin, UpdateView):
    fields = None
    success_url = None
    frozen_parents = ()

    def validate_frozen_parents(self, form):
        if not self.frozen_parents:
            return True
        fields = [name + "_id" for name in self.frozen_parents]
        original = self.model.objects.values(*fields).get(pk=self.object.pk)
        valid = True
        for parent in self.frozen_parents:
            values = self.request.POST.getlist(parent)
            if parent not in self.request.POST:
                continue
            if len(values) != 1 or positive_pk(values[0]) != original[parent + "_id"]:
                form.add_error(None, "This checkout assessment is fixed to its original " + parent + ". The association cannot be changed.")
                valid = False
        return valid

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        context["update_instance"] = self.object
        return context


class GenericDeleteView(GenericViewMixin, DeleteView):
    success_url = None
