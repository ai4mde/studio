class GenericViewMixin{% if authentication_present %}(LoginRequiredMixin, RoleRequiredMixin){% endif %}:
    model = None
    template_name = None
    context_object_name = None
    app_role = None
    page_models = ()
    parent_models = ()

    @property
    def active_process_node(self):
        node_id = self.kwargs.get("active_process_node_id")
        return get_object_or_404(ActiveProcessNode, pk=node_id) if node_id is not None else None

    def page_queryset(self, model):
        qs = scoped_queryset(self.request, self.app_role, model)
        if self.kwargs.get("active_process_node_id") is not None:
            associated = getattr(self.active_process_node.active_process, model.__name__.lower() + "s")
            qs = qs.filter(pk__in=associated.all().values("pk"))
        return qs

    def get_form_kwargs(self):
        kwargs = super().get_form_kwargs()
        if self.model.__name__ in LIFECYCLE and getattr(self, 'object', None) is not None and 'data' in kwargs:
            data = kwargs['data'].copy()
            for field in self.fields:
                if field not in data:
                    data[field] = getattr(self.object, field) or ''
            kwargs['data'] = data
        return kwargs

    def library_form_valid(self, form):
        # Fixed Library adapter, activated only by validated 1.2 bindings.
        from shared_models.models import Loan, BookLoan, Book, Customer
        from ai_runtime.context import clean, parse_date, valid_book
        from django.db import transaction, IntegrityError
        from django.utils import timezone
        from django.http import HttpResponseRedirect
        name = self.model.__name__
        updating = bool(getattr(self, 'object', None) and self.object.pk)
        today = timezone.localdate()
        def one(key, fallback=None):
            values = self.request.POST.getlist(key)
            if not values and fallback is not None:
                return fallback
            if len(values) != 1:
                raise ValueError(key + ': exactly one value is required')
            return values[0]
        def parent(model, key, fallback=None):
            value = positive_pk(str(one(key, fallback)))
            if value is None:
                raise ValueError(key + ': select a valid object')
            return get_object_or_404(scoped_queryset(self.request, self.app_role, model), pk=value)
        try:
            with transaction.atomic():
                original = self.model.objects.get(pk=self.object.pk) if updating else None
                instance = original if updating else self.model()
                if name == 'Loan':
                    if 'return_date' in self.request.POST:
                        raise ValueError('Return each book through its BookLoan; Loan no longer accepts return_date.')
                    customer = parent(Customer, 'Customer', original.Customer_id if updating else None)
                    start = parse_date(one('loan_date', original.loan_date if updating else None))
                    due = parse_date(one('due_date', original.due_date if updating else None))
                    if due < start:
                        raise ValueError('Due date must not precede the loan date.')
                    frozen = updating and BookLoan.objects.filter(Loan=original).exists()
                    if frozen:
                        if (customer.pk, start.isoformat(), due.isoformat()) != (original.Customer_id, original.loan_date, original.due_date):
                            raise ValueError('Reader and loan period are fixed after the first book is added.')
                    elif start != today:
                        raise ValueError('An empty borrowing group must use today as its loan date.')
                    instance.Customer, instance.loan_date, instance.due_date = customer, start.isoformat(), due.isoformat()
                else:
                    loan = parent(Loan, 'Loan', original.Loan_id if updating else None)
                    book = parent(Book, 'Book', original.Book_id if updating else None)
                    start, due = parse_date(loan.loan_date), parse_date(loan.due_date)
                    if due < start:
                        raise ValueError('Invalid loan period.')
                    values = self.request.POST.getlist('return_date')
                    if len(values) > 1:
                        raise ValueError('return_date: exactly one value is allowed')
                    returned = clean(values[0]) if values else clean(original.return_date) if updating else ''
                    if updating:
                        if (loan.pk, book.pk) != (original.Loan_id, original.Book_id):
                            raise ValueError('The original Loan and Book cannot be changed.')
                        if clean(original.return_date) and returned != clean(original.return_date):
                            raise ValueError('A recorded return cannot be changed or cleared.')
                        if returned and not start <= parse_date(returned) <= today:
                            raise ValueError('Return date must be between the loan date and today.')
                    else:
                        if start != today:
                            raise ValueError('Books can only be added on the loan date.')
                        if any(clean(value) for value in BookLoan.objects.filter(Loan=loan).values_list('return_date', flat=True)):
                            raise ValueError('No more books can be added after a book in this group has been returned.')
                        if not valid_book(book):
                            raise ValueError('Book title and a valid category are required.')
                        if returned:
                            raise ValueError('A newly borrowed book cannot already have a return date.')
                        if BookLoan.objects.filter(Loan=loan, Book=book).exists():
                            raise ValueError('This borrowing group already contains this book.')
                    instance.Loan, instance.Book, instance.return_date = loan, book, returned
                instance.save()
                self.object = instance
        except (ValueError, TypeError) as exc:
            form.add_error(None, str(exc))
            return self.form_invalid(form)
        except IntegrityError as exc:
            # Only the declared duplicate-pair conflict is converted; other DB errors propagate.
            message = str(exc)
            if name != 'BookLoan' or not ('bl_bookloan_loan_book_uniq' in message or
                    ('UNIQUE constraint failed' in message and 'Book_id' in message and 'Loan_id' in message)):
                raise
            form.add_error(None, 'This borrowing group already contains this book.')
            return self.form_invalid(form)
        outcome = getattr(self.object, '_ai_last_outcome', None)
        if not updating and name == 'BookLoan' and outcome is not None:
            if outcome.status == 'success':
                messages.success(self.request, 'Book borrowed. Checkout risk: ' + str(outcome.value) + '.')
            elif outcome.status == 'skipped':
                reasons = {'empty_history': 'no completed borrowing history',
                    'no_valid_history': 'no usable completed history',
                    'history_budget_exceeded': 'history processing limit exceeded',
                    'prompt_budget_exceeded': 'input processing limit exceeded'}
                messages.info(self.request, 'Book borrowed. Risk not assessed: ' + reasons.get(outcome.skip_reason, 'required information unavailable') + '.')
            else:
                messages.error(self.request, 'Book borrowed, but the risk assessment could not be completed.')
        return HttpResponseRedirect(self.get_success_url())

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        for model in self.page_models:
            qs = self.page_queryset(model)
            if model.__name__ in LIFECYCLE:
                from shared_models.models import BookLoan
                if model.__name__ == 'Loan':
                    rows = list(qs.select_related('Customer'))
                    occupied = set(BookLoan.objects.filter(Loan_id__in=[row.pk for row in rows]).values_list('Loan_id', flat=True))
                    for row in rows:
                        row.can_edit_group = row.pk not in occupied
                    qs = rows
                else:
                    qs = qs.select_related('Loan', 'Book', 'Loan__Customer')
            context[model.__name__ + "_list"] = qs
        for model in self.parent_models:
            qs = scoped_queryset(self.request, self.app_role, model)
            if model.__name__ == 'Loan' and 'Loan' in LIFECYCLE:
                from shared_models.models import BookLoan
                from django.utils import timezone
                from ai_runtime.context import clean
                returned = {pk for pk, value in BookLoan.objects.values_list('Loan_id', 'return_date') if clean(value)}
                qs = qs.filter(loan_date=timezone.localdate().isoformat()).exclude(pk__in=returned)
            context["parent_" + model.__name__ + "_list"] = qs
        if self.kwargs.get("active_process_node_id") is not None:
            context["active_process_node_id"] = self.kwargs["active_process_node_id"]
        return context


