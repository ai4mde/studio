def positive_pk(value):
    if not re.fullmatch(r"[0-9]+", value):
        return None
    try:
        number = int(value)
    except ValueError:  # Python also bounds conversion of excessively long integers.
        return None
    return number if number > 0 else None


def normalized_email(value):
    return (value or "").strip().lower()


def _unique_email_id(model, email):
    # Library demonstrator: stream only id/email and stop when ambiguity is established.
    matches = []
    for pk, value in model.objects.values_list("pk", "email").iterator():
        if normalized_email(value) == email:
            matches.append(pk)
            if len(matches) > 1:
                break
    return matches[0] if len(matches) == 1 else None


def scoped_queryset(request, app_role, model):
    qs = model.objects.all()
    if not (LIBRARY_AI_ENABLED and app_role == "member" and model.__name__ == "Customer"):
        return qs
    if OWNERSHIP.get(app_role, {}).get("Customer") != "email":
        return qs.none()  # Missing/tampered protected policy can never expose the full table.
    user = request.user
    email = normalized_email(getattr(user, "email", None))
    if not user.is_authenticated or not email:
        return qs.none()
    cache_key = (user.pk, email)
    cached = getattr(request, "_library_binding", None)
    if cached is None or cached[0] != cache_key:
        customer_id = (_unique_email_id(Customer, email)
                       if _unique_email_id(User, email) == user.pk else None)
        request._library_binding = (cache_key, customer_id)
    customer_id = request._library_binding[1]
    return qs.filter(pk=customer_id) if customer_id is not None else qs.none()


