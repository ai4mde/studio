{% raw %}{%{% endraw %} extends "authentication_base.html" {% raw %}%}{% endraw %}
{% raw %}{% block content %}{% endraw %}

<h1>{{ project_name }} prototype</h1>

<div>
    <h3>Login</h3>
    <p style="color:{% raw %}{{ log_out_mess_color }}{% endraw %};font-size:16px;">{% raw %}{{ log_out_mess }}{% endraw %}</p>
    <table>
        <form action="login" method="POST">
            {% raw %}{% csrf_token %}{% endraw %}
            <tr>
                <td>
                    <input type="text" name="username" placeholder="Username" required>
                </td>
            </tr>
            <tr>
                <td>
                    <input type="password" name="password" placeholder="Password" required>
                </td>
            </tr>
            <tr>
                <td>
                <p style="color:{% raw %}{{ auth_mess_color }}{% endraw %};font-size:16px;">{% raw %}{{ auth_mess }}{% endraw %}</p>
                <td>
            </tr>
            <tr>
                <td>
                    <input value="Login" type="submit">
                </td>
            </tr>
        </form>
    </table>
</div>

{#- Self-service registration is intentionally hidden from the study UI: participants
    use the pre-seeded demo_librarian / demo_member accounts so that role assignment is
    controlled. The register route and view still exist; restore this form block to
    re-expose them. #}

{% raw %}{% endblock %}{% endraw %}
