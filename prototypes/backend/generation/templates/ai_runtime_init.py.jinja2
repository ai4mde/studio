"""BL-1.0 single-call orchestration. The generated hook owns write-back."""
from typing import Annotated, Literal

from .configuration import validate_ai_config
from .execution import PromptBudgetExceeded, perform_call, prompt_record, safe_error
from .outcomes import RunOutcome


def _build_output_schema(write_back, allowed_values, reason_max_length=120):
    from pydantic import StringConstraints, create_model
    annotation = Literal[tuple(allowed_values)]
    reason = Annotated[str, StringConstraints(strict=True, strip_whitespace=True, min_length=1, max_length=reason_max_length)]
    return create_model("AiOutput", **{write_back: (annotation, ...), "reason": (reason, ...)})


def invoke(ai_config, instance, created=None):
    result = RunOutcome()
    try:
        from .context import build_context
        from .parsers import JsonOutputParser
        from .templates import render_prompt
        config = validate_ai_config(ai_config, instance.__class__.__name__, "late_risk")
        if created is not True:
            result.status, result.skip_reason = "skipped", "not_created"
            return result
        built = build_context(config, instance)
        result.context, result.diagnostics = built.context, built.diagnostics
        if built.skip_reason:
            result.status, result.skip_reason = "skipped", built.skip_reason
            result.value, result.should_write = config["output"]["on_skip"], True
            return result
        name = config["template"]["name"]
        prompt = render_prompt(name, built.context)
        result.prompts.append(prompt_record(name, prompt))
        raw = perform_call(result, config, prompt, name)
        result.raw_output = raw
        output = config["output"]
        schema = _build_output_schema(output["write_back"], output["allowed_values"], output["reason"]["max_length"])
        parsed = JsonOutputParser(schema).parse(raw)
        if not parsed.success:
            result.status = "parse_error"
            result.error = {"code": parsed.error.code, "message": parsed.error.message}
            return result
        result.parsed_output = parsed.data.model_dump()
        result.value = getattr(parsed.data, output["write_back"])
        result.reason = parsed.data.reason
        result.should_write = True
    except PromptBudgetExceeded:
        result.status, result.skip_reason = "skipped", "prompt_budget_exceeded"
        result.value, result.should_write = config["output"]["on_skip"], True
        result.diagnostics["budget_kind"] = "prompt_chars"
    except Exception as exc:
        result.status, result.error = "invoke_error", safe_error(exc)
    return result
