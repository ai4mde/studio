{% if section_component.has_create_operation %}
class {{ page }}_{{ section_component }}_CreateView(GenericCreateView):
    {% if authentication_present -%}
    required_roles = ['{{ application_name }}']
    {% endif -%}
    model = {{ section_component.primary_model }}
    {% set _simple_attrs = [] -%}
    {%- for attr in section_component.attributes -%}
        {%- if '.' not in attr.name -%}
            {%- set _dummy = _simple_attrs.append(attr.name) -%}
        {%- endif -%}
    {%- endfor %}
    fields = [{% for attr_name in _simple_attrs %}'{{ attr_name }}'{% if not loop.last %}, {% endif %}{% endfor %}]
    template_name = '{{ application_name }}_{{ page }}.html'
    {% if page.type == 'activity' -%}

    def get_success_url(self):
        return reverse('{{ application_name }}:render_{{ application_name }}_{{ page }}', kwargs={
            'active_process_node_id': self.kwargs.get('active_process_node_id'),
        })
    {% elif section_component.success_page -%}
    success_url = reverse_lazy('{{ application_name }}:render_{{ application_name }}_{{ section_component.success_page }}')
    {% else -%}

    def get_success_url(self):
        base = reverse('{{ application_name }}:render_{{ application_name }}_{{ page }}')
        params = {k: v for k, v in self.request.POST.items() if k.startswith('instance_id_') and v}
        if params:
            from urllib.parse import urlencode
            base += '?' + urlencode(params)
        return base
    {% endif %}

    def form_valid(self, form):
        instance = form.save(commit=False)
        {% for attribute in section_component.attributes -%}
        {% if not attribute.derived and '.' not in attribute.name -%}
        {% if attribute.type == AttributeType.BOOLEAN -%}
        if hasattr(instance, '{{ attribute }}'):
            setattr(instance, '{{ attribute }}', self.request.POST.get('{{ attribute }}') == 'on')
        {% elif attribute.type in [AttributeType.STRING, AttributeType.ENUM, AttributeType.VIDEO] -%}
        if hasattr(instance, '{{ attribute }}') and not getattr(instance, '{{ attribute }}'):
            setattr(instance, '{{ attribute }}', None)
        {% endif -%}
        {% endif -%}
        {% endfor -%}
        {% for parent_model in section_component.parent_models -%}
        _pk_{{ parent_model }} = self.request.POST.get('{{ parent_model }}')
        if not _pk_{{ parent_model }}:
            _pk_{{ parent_model }} = self.request.POST.get('instance_id_{{ parent_model }}')
        if _pk_{{ parent_model }}:
            instance.{{ parent_model }} = get_object_or_404({{ parent_model }}, pk=_pk_{{ parent_model }})
        elif not getattr(instance, '{{ parent_model }}_id', None):
            instance.{{ parent_model }} = {{ parent_model }}.objects.first()
        {% endfor -%}
        {% if page.type == 'activity' %}
        {% for parent_model in section_component.parent_models -%}
        if not getattr(instance, '{{ parent_model }}_id', None):
            _apn_{{ parent_model }} = get_object_or_404(ActiveProcessNode, pk=self.kwargs.get('active_process_node_id'))
            _ct_{{ parent_model }} = ContentType.objects.get_for_model({{ parent_model }})
            _ami_{{ parent_model }} = _apn_{{ parent_model }}.active_process.associated_model_instances.filter(content_type=_ct_{{ parent_model }}).first()
            if _ami_{{ parent_model }}:
                instance.{{ parent_model }}_id = _ami_{{ parent_model }}.instance_id
        {% endfor -%}
        instance.save()
        active_process_node = get_object_or_404(
            ActiveProcessNode,
            pk=self.kwargs.get('active_process_node_id'),
        )
        active_process_node.active_process.add_associated_instance(instance)
        {% endif -%}
        return super().form_valid(form)
{% endif %}

{% if section_component.has_update_operation %}
class {{ page }}_{{ section_component }}_UpdateView(GenericUpdateView):
    {% if authentication_present -%}
    required_roles = ['{{ application_name }}']
    {% endif -%}
    model = {{ section_component.primary_model }}
    fields = [{% for attribute in section_component.attributes %}{% if '.' not in attribute.name %}'{{ attribute }}'{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]
    template_name = '{{ application_name }}_{{ page }}.html'
    {% if page.type == 'activity' -%}

    def get_success_url(self):
        return reverse('{{ application_name }}:render_{{ application_name }}_{{ page }}', kwargs={
            'active_process_node_id': self.kwargs.get('active_process_node_id'),
        })
    {% else -%}
    success_url = reverse_lazy('{{ application_name }}:render_{{ application_name }}_{{ page }}')
    {% endif %}

    def post(self, request, *args, **kwargs):
        self.object = self.get_object()
        data = request.POST.copy()
        {% for attribute in section_component.attributes -%}
        {% if not attribute.derived and attribute.type != AttributeType.BOOLEAN and '.' not in attribute.name -%}
        if '{{ attribute }}' not in data and hasattr(self.object, '{{ attribute }}'):
            data['{{ attribute }}'] = getattr(self.object, '{{ attribute }}', '') or ''
        {% endif -%}
        {% endfor -%}
        request.POST = data
        return super().post(request, *args, **kwargs)

    def form_valid(self, form):
        instance = form.save(commit=False)
        {% for attribute in section_component.attributes -%}
        {% if not attribute.derived and '.' not in attribute.name -%}
        {% if attribute.type == AttributeType.BOOLEAN -%}
        if hasattr(instance, '{{ attribute }}'):
            setattr(instance, '{{ attribute }}', self.request.POST.get('{{ attribute }}') == 'on')
        {% elif attribute.type in [AttributeType.STRING, AttributeType.ENUM, AttributeType.VIDEO] -%}
        if hasattr(instance, '{{ attribute }}') and not getattr(instance, '{{ attribute }}'):
            setattr(instance, '{{ attribute }}', None)
        {% endif -%}
        {% endif -%}
        {% endfor -%}
        {% for parent_model in section_component.parent_models -%}
        _pk_{{ parent_model }} = self.request.POST.get('{{ parent_model }}')
        if _pk_{{ parent_model }}:
            instance.{{ parent_model }} = get_object_or_404({{ parent_model }}, pk=_pk_{{ parent_model }})
        {% endfor -%}
        return super().form_valid(form)
{% endif -%}

{% if section_component.has_delete_operation -%}
class {{ page }}_{{ section_component }}_DeleteView(GenericDeleteView):
    {% if authentication_present -%}
    required_roles = ['{{ application_name }}']
    {% endif -%}
    model = {{ section_component.primary_model }}
    template_name = '{{ application_name }}_{{ page }}.html'
    {% if page.type == 'activity' -%}

    def get_success_url(self):
        return reverse('{{ application_name }}:render_{{ application_name }}_{{ page }}', kwargs={
            'active_process_node_id': self.kwargs.get('active_process_node_id'),
        })
    {% else -%}
    success_url = reverse_lazy('{{ application_name }}:render_{{ application_name }}_{{ page }}')
    {% endif -%}

    {% if page.type == 'activity' %}
    def delete(self, request, *args, **kwargs):
        instance = self.get_object()
        active_process_node = get_object_or_404(
            ActiveProcessNode,
            pk=self.kwargs.get('active_process_node_id'),
        )
        active_process_node.active_process.remove_associated_instance(instance)
