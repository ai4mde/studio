                setattr(_img_obj, '{{ attr }}', getattr(_img_obj, 'thumb_url', None) or getattr(_img_obj, 'image_url', None) or '')
        {% endif %}{% endfor %}
        {% endif -%}
        {% if page.type == 'activity' -%}
        {% if models_on_pages[page]['primary_models'] | length > 1 -%}
        {% for primary_model in models_on_pages[page]['primary_models'][1:] -%}
        _associated_{{ primary_model }}_qs = self.active_process_node.active_process.{{ primary_model.lower() }}s
        {% set _sections_for_model = page.section_components | selectattr('primary_model', 'equalto', primary_model) | list -%}
        context['{{ primary_model }}_list'] = _apply_section_query(
            _associated_{{ primary_model }}_qs if _associated_{{ primary_model }}_qs.exists() else {{ primary_model }}.objects.all(),
            {{ _sections_for_model[0].query_literal if _sections_for_model else '{}' }},
        )
        {% endfor -%}
        {% endif -%}
        context['active_process_node_id'] = self.active_process_node.id if self.active_process_node else self.kwargs.get('active_process_node_id')
        {% endif -%}
        {% if page.type != 'activity' and models_on_pages[page]['primary_models'] | length > 1 -%}
        {% set _ns_p = namespace(model=models_on_pages[page]['primary_models'][0], section=page.section_components[0] if page.section_components else None) -%}
        _primary_id = self.request.GET.get('instance_id_{{ _ns_p.model }}')
        _primary_obj = {{ _ns_p.model }}.objects.filter(id=_primary_id).first() if _primary_id else None
        {% for section in page.section_components[1:] -%}
        {% if section.primary_model and not section.related_to_section_id -%}
        {% if _ns_p.model in section.parent_models -%}
        _qs_{{ section.name }} = {{ section.primary_model }}.objects.filter({{ _ns_p.model }}=_primary_obj) if _primary_obj else {{ section.primary_model }}.objects.all()
        context['{{ section.primary_model }}_list'] = _apply_section_query(_qs_{{ section.name }}, {{ section.query_literal }}, _primary_obj)
        {% for attr in section.attributes -%}{% if attr.type == AttributeType.IMAGE %}
        for _img_obj in context.get('{{ section.primary_model }}_list', []):
            if not getattr(_img_obj, '{{ attr }}', None):
                setattr(_img_obj, '{{ attr }}', getattr(_img_obj, 'thumb_url', None) or getattr(_img_obj, 'image_url', None) or '')
        {% endif %}{% endfor %}
        {% elif _ns_p.section and section.primary_model in _ns_p.section.parent_models -%}
        _direct_id_{{ section.name }} = self.request.GET.get('instance_id_{{ section.primary_model }}')
        _qs_{{ section.name }} = {{ section.primary_model }}.objects.filter(id=getattr(_primary_obj, '{{ section.primary_model }}_id', None)) if _primary_obj else {{ section.primary_model }}.objects.filter(id=_direct_id_{{ section.name }}) if _direct_id_{{ section.name }} else {{ section.primary_model }}.objects.all()
        context['{{ section.primary_model }}_list'] = _apply_section_query(_qs_{{ section.name }}, {{ section.query_literal }}, _primary_obj)
        {% for attr in section.attributes -%}{% if attr.type == AttributeType.IMAGE %}
        for _img_obj in context.get('{{ section.primary_model }}_list', []):
            if not getattr(_img_obj, '{{ attr }}', None):
                setattr(_img_obj, '{{ attr }}', getattr(_img_obj, 'thumb_url', None) or getattr(_img_obj, 'image_url', None) or '')
        {% endif %}{% endfor %}
        {% else -%}
        {% if section.primary_model != _ns_p.model -%}
        _id_{{ section.name }} = self.request.GET.get('instance_id_{{ section.primary_model }}')
        _qs_{{ section.name }} = {{ section.primary_model }}.objects.filter(id=_id_{{ section.name }}) if _id_{{ section.name }} else {{ section.primary_model }}.objects.all()
        context['{{ section.primary_model }}_list'] = _apply_section_query(_qs_{{ section.name }}, {{ section.query_literal }})
        {% for attr in section.attributes -%}{% if attr.type == AttributeType.IMAGE %}
        for _img_obj in context.get('{{ section.primary_model }}_list', []):
            if not getattr(_img_obj, '{{ attr }}', None):
                setattr(_img_obj, '{{ attr }}', getattr(_img_obj, 'thumb_url', None) or getattr(_img_obj, 'image_url', None) or '')
        {% endif %}{% endfor %}
        {% endif -%}
        {% endif -%}
        {% endif -%}
        {% endfor -%}
        {% endif %}
        {% for section in page.section_components -%}
        {% if section.related_to_section_id -%}
        {% set _src_sections = page.section_components | selectattr('id', 'equalto', section.related_to_section_id) | list -%}
        {% if _src_sections -%}
        {% set _src = _src_sections[0] -%}
        {% set _ns = namespace(fk_field=None, same_model=False) -%}
        {% if section.relation_field -%}
        {% set _ns.fk_field = section.relation_field -%}
        {% set _ns.same_model = (section.primary_model == _src.primary_model) -%}
        {% elif section.primary_model == _src.primary_model -%}
        {% for pm in section.parent_models -%}{% if pm in _src.parent_models and not _ns.fk_field -%}{% set _ns.fk_field = pm %}{% set _ns.same_model = true %}{% endif -%}{% endfor -%}
        {% elif _src.primary_model in section.parent_models -%}
        {% set _ns.fk_field = _src.primary_model -%}
        {% endif -%}
        {% if _ns.fk_field -%}
        _src_{{ _src.primary_model }} = {{ _src.primary_model }}.objects.filter(id=self.request.GET.get('instance_id_{{ _src.primary_model }}')).first()
        _related_lookup_{{ section.name }} = '{{ _ns.fk_field }}'
        {% if _ns.same_model -%}
        _related_value_{{ section.name }} = getattr(_src_{{ _src.primary_model }}, _related_lookup_{{ section.name }}, None) if _src_{{ _src.primary_model }} else None
        try:
            _qs_related_{{ section.name }} = {{ section.primary_model }}.objects.filter(**{_related_lookup_{{ section.name }}: _related_value_{{ section.name }}}).exclude(id=_src_{{ _src.primary_model }}.id) if _src_{{ _src.primary_model }} and _related_value_{{ section.name }} is not None else {{ section.primary_model }}.objects.none()
        except Exception:
            _qs_related_{{ section.name }} = {{ section.primary_model }}.objects.none()
        {% else -%}
        _related_value_{{ section.name }} = None
        if _src_{{ _src.primary_model }}:
            _related_value_{{ section.name }} = getattr(_src_{{ _src.primary_model }}, _related_lookup_{{ section.name }}, None)
            if _related_value_{{ section.name }} is None and _related_lookup_{{ section.name }}.endswith('_id'):
                _related_value_{{ section.name }} = getattr(_src_{{ _src.primary_model }}, _related_lookup_{{ section.name }}[:-3] + '_id', None)
                if _related_value_{{ section.name }} is None:
                    _related_value_{{ section.name }} = getattr(_src_{{ _src.primary_model }}, 'id', None)
            if _related_value_{{ section.name }} is None and not _related_lookup_{{ section.name }}.endswith('_id'):
                _related_value_{{ section.name }} = _src_{{ _src.primary_model }}
        try:
            _qs_related_{{ section.name }} = {{ section.primary_model }}.objects.filter(**{_related_lookup_{{ section.name }}: _related_value_{{ section.name }}}) if _src_{{ _src.primary_model }} and _related_value_{{ section.name }} is not None else {{ section.primary_model }}.objects.none()
        except Exception:
            _qs_related_{{ section.name }} = {{ section.primary_model }}.objects.none()
        {% endif -%}
        context['related_{{ section.name }}_list'] = _apply_section_query(_qs_related_{{ section.name }}, {{ section.query_literal }}, _src_{{ _src.primary_model }})
        {% for attr in section.attributes -%}{% if attr.type == AttributeType.IMAGE %}
        for _img_obj in list(context.get('related_{{ section.name }}_list', [])):
            if not getattr(_img_obj, '{{ attr }}', None):
                setattr(_img_obj, '{{ attr }}', getattr(_img_obj, 'thumb_url', None) or getattr(_img_obj, 'image_url', None) or '')
        {% endif %}{% endfor %}
        {% endif -%}
        {% endif -%}
        {% endif -%}
        {% endfor -%}
        {%- set _has_wf_sections = (page.section_components | selectattr('component_type', 'equalto', 'activity_start') | list) or (page.section_components | selectattr('component_type', 'equalto', 'activity_tasks') | list) %}
        {% if _has_wf_sections -%}
        context['available_processes'] = Process.get_available_processes(self.request.user)
        context['all_processes'] = Process.objects.all()
        context['active_process_nodes'] = ActiveProcessNode.objects.filter(
            user=self.request.user,
            active_process__completed=False,
        )
        {% endif -%}
        return context

{% endif -%}
{% endfor -%}


{# Home render view #}
class HomeRenderView(GenericTemplateView):
    {% if authentication_present -%}
    required_roles = ['{{ application_name }}']
    {% endif -%}
    template_name = '{{ application_name }}_home.html'

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        context['user'] = self.request.user
        context['active_process_nodes'] = ActiveProcessNode.objects.filter(
            user=self.request.user,
            active_process__completed=False,
        )
        context['available_processes'] = Process.get_available_processes(self.request.user)
        context['all_processes'] = Process.objects.all()
        return context
