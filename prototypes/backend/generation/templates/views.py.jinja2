        return []
    {% endif -%}

    {% if page.type == 'activity' and models_on_pages[page]['primary_models'] | length > 0 -%}
    def get_queryset(self):
        _associated_qs = self.active_process_node.active_process.{{ models_on_pages[page]['primary_models'][0].lower() }}s
        qs = _associated_qs if _associated_qs.exists() else {{ models_on_pages[page]['primary_models'][0] }}.objects.all()
        {%- set select_related_fields = [] %}
        {%- if page.section_components %}
            {%- for attr in page.section_components[0].attributes %}
                {%- if '.' in attr.name %}
                    {%- set _parts = attr.name.split('.') %}
                    {%- set _dummy = select_related_fields.append(_parts[0]) %}
                {%- endif %}
            {%- endfor %}
        {%- endif %}
        {%- if select_related_fields %}
        qs = _safe_select_related(qs, {% for f in select_related_fields %}'{{ f }}'{% if not loop.last %}, {% endif %}{% endfor %})
        {%- endif %}
        return _apply_search_query(_apply_section_query(qs, {{ page.section_components[0].query_literal if page.section_components else '{}' }}), self.request)
    {% elif models_on_pages[page]['primary_models'] | length > 0 -%}
    {% set _pm0 = models_on_pages[page]['primary_models'][0] -%}
    {% set _pm0_parents = page.section_components[0].parent_models if page.section_components else [] -%}
    def get_queryset(self):
        _id = self.request.GET.get('instance_id_{{ _pm0 }}')
        if _id:
            qs = {{ _pm0 }}.objects.filter(id=_id)
        else:
            qs = None
            {% for parent_model in _pm0_parents -%}
            if qs is None:
                _pid_{{ parent_model }} = self.request.GET.get('instance_id_{{ parent_model }}')
                if _pid_{{ parent_model }}:
                    qs = {{ _pm0 }}.objects.filter({{ parent_model }}_id=_pid_{{ parent_model }})
            {% endfor -%}
            if qs is None:
                qs = {{ _pm0 }}.objects.all()
        
        {%- set select_related_fields = [] %}
        {%- if page.section_components %}
            {%- for attr in page.section_components[0].attributes %}
                {%- if '.' in attr.name %}
                    {%- set _parts = attr.name.split('.') %}
                    {%- set _dummy = select_related_fields.append(_parts[0]) %}
                {%- endif %}
            {%- endfor %}
        {%- endif %}
        {%- if select_related_fields %}
        qs = _safe_select_related(qs, {% for f in select_related_fields %}'{{ f }}'{% if not loop.last %}, {% endif %}{% endfor %})
        {%- endif %}
        return _apply_search_query(_apply_section_query(qs, {{ page.section_components[0].query_literal if page.section_components else '{}' }}), self.request)
    {% endif -%}

    {% if models_on_pages[page]['parent_models'] or page.type == 'activity' or page.section_components | selectattr('related_to_section_id') | list or models_on_pages[page]['primary_models'] | length > 1 or (page.section_components | selectattr('component_type', 'equalto', 'activity_start') | list) or (page.section_components | selectattr('component_type', 'equalto', 'activity_tasks') | list) %}
    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        {% for model in models_on_pages[page]['parent_models'] -%}
        context['parent_{{model}}_list'] = {{model}}.objects.all()
        {% endfor -%}
        {% if page.section_components and models_on_pages[page]['primary_models'] -%}
        {% set _main_img_model = models_on_pages[page]['primary_models'][0] -%}
        {% for attr in page.section_components[0].attributes -%}{% if attr.type == AttributeType.IMAGE %}
        for _img_obj in context.get('{{ _main_img_model }}_list', []):
