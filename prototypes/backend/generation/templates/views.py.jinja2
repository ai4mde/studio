def _required_relation_field_options(model, exclude=(), request=None, instance=None, active_process=None):
    excluded = {str(item) for item in (exclude or ())}
    relation_fields = []
    for field in model._meta.fields:
        if field.name in excluded:
            continue
        if getattr(field, "primary_key", False) or not getattr(field, "editable", False):
            continue
        if not getattr(field, "is_relation", False):
            continue
        if not (getattr(field, "many_to_one", False) or getattr(field, "one_to_one", False)):
            continue
        related_model = getattr(getattr(field, "remote_field", None), "model", None)
        if related_model is None:
            continue
        options = list(related_model.objects.all())
        if getattr(field, "one_to_one", False):
            accessor = field.remote_field.get_accessor_name()
            options = [obj for obj in options if not accessor or not hasattr(obj, accessor)]
        selected_id = ""
        if instance is not None:
            selected_id = getattr(instance, f"{field.name}_id", "") or ""
        if not selected_id and request is not None:
            selected_id = request.GET.get(f"instance_id_{field.name}") or ""
        if not selected_id and active_process is not None:
            _ct_related = ContentType.objects.get_for_model(related_model)
            _ami_related = active_process.associated_model_instances.filter(content_type=_ct_related).order_by('-id').first()
            if _ami_related:
                selected_id = _ami_related.instance_id
        if selected_id and not any(str(getattr(obj, "pk", "")) == str(selected_id) for obj in options):
            selected_obj = related_model.objects.filter(pk=selected_id).first()
            if selected_obj is not None:
                options.insert(0, selected_obj)
        relation_fields.append({
            "name": field.name,
            "label": field.verbose_name or field.name,
            "options": options,
            "required": not getattr(field, "null", False) and not getattr(field, "blank", False),
            "selected_id": str(selected_id) if selected_id else "",
        })
    return relation_fields


def _normalize_form_instance_fields(instance, request, boolean_fields=(), empty_to_none_fields=()):
    for field in boolean_fields or ():
        if hasattr(instance, field):
            setattr(instance, field, request.POST.get(field) == 'on')
    for field in empty_to_none_fields or ():
        if hasattr(instance, field) and not getattr(instance, field):
            setattr(instance, field, None)


def _complete_activity_form_step(request, active_process_node):
    active_process = active_process_node.active_process
    active_process_node.complete_node(request.user)
    next_active_process_node = ActiveProcessNode.objects.filter(
        active_process=active_process,
        action_node__url__isnull=False,
    ).select_related("action_node", "user").filter(user=request.user).first()
    if not next_active_process_node:
        next_active_process_node = ActiveProcessNode.objects.filter(
            active_process=active_process,
            action_node__url__isnull=False,
        ).select_related("action_node", "user").first()
    if next_active_process_node:
        return _redirect_to_active_node_or_success(request, next_active_process_node)
    return _redirect_home_success(request)

