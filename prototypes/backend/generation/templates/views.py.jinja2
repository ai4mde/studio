{# List views #}
{% for page in pages %}
class {{ application_name }}_{{ page }}_ListView(GenericListView):
    {% if authentication_present -%}
    required_roles = ['{{ application_name }}']
    {% endif -%}
    template_name='{{ application_name }}_{{ page }}.html'
    {% if models_on_pages[page]['primary_models'][0] -%}
    model = {{ models_on_pages[page]['primary_models'][0] }}
    context_object_name = '{{ models_on_pages[page]['primary_models'][0] }}_list'
    {% else -%}
    def get_queryset(self):
        return []
    {% endif -%}

    {% if page.type == 'activity' -%}
    def get_queryset(self):
        _associated_qs = self.active_process_node.active_process.{{ models_on_pages[page]['primary_models'][0].lower() }}s
        qs = _associated_qs if _associated_qs.exists() else {{ models_on_pages[page]['primary_models'][0] }}.objects.all()
        return _apply_section_query(qs, {{ page.section_components[0].query_literal if page.section_components else '{}' }})
    {% elif page.single_record and models_on_pages[page]['primary_models'][0] -%}
    def get_queryset(self):
        _id = self.request.GET.get('instance_id_{{ models_on_pages[page]['primary_models'][0] }}')
        if _id:
            qs = {{ models_on_pages[page]['primary_models'][0] }}.objects.filter(id=_id)
            return _apply_section_query(qs, {{ page.section_components[0].query_literal if page.section_components else '{}' }})
        return {{ models_on_pages[page]['primary_models'][0] }}.objects.none()
    {% elif models_on_pages[page]['primary_models'][0] and page.section_components and page.section_components[0].query -%}
    def get_queryset(self):
        qs = {{ models_on_pages[page]['primary_models'][0] }}.objects.all()
        return _apply_section_query(qs, {{ page.section_components[0].query_literal }})
    {% endif -%}

    {% if models_on_pages[page]['parent_models'] or page.type == 'activity' or page.section_components | selectattr('related_to_section_id') | list or page.single_record %}
    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        {% for model in models_on_pages[page]['parent_models'] -%}
        context['parent_{{model}}_list'] = {{model}}.objects.all()
        {% endfor -%}
        {% if page.type == 'activity' -%}
        {% if models_on_pages[page]['primary_models'] | length > 1 -%}
        {% for primary_model in models_on_pages[page]['primary_models'][1:] -%}
        _associated_{{ primary_model }}_qs = self.active_process_node.active_process.{{ primary_model.lower() }}s
        {% set _sections_for_model = page.section_components | selectattr('primary_model', 'equalto', primary_model) | list -%}
        context['{{ primary_model }}_list'] = _apply_section_query(
            _associated_{{ primary_model }}_qs if _associated_{{ primary_model }}_qs.exists() else {{ primary_model }}.objects.all(),
            {{ _sections_for_model[0].query_literal if _sections_for_model else '{}' }},
        )
        {% endfor -%}
        {% endif -%}
        context['active_process_node_id'] = self.kwargs.get('active_process_node_id')
        {% endif -%}
        {% if page.type != 'activity' -%}
        {% if page.single_record and models_on_pages[page]['primary_models'][0] -%}
        {% set _ns_p = namespace(model=models_on_pages[page]['primary_models'][0], section=page.section_components[0]) -%}
        _primary_id = self.request.GET.get('instance_id_{{ _ns_p.model }}')
        _primary_obj = {{ _ns_p.model }}.objects.filter(id=_primary_id).first() if _primary_id else None
        {% for section in page.section_components[1:] -%}
        {% if section.primary_model -%}
        {% if _ns_p.model in section.parent_models -%}
        _qs_{{ section.name }} = {{ section.primary_model }}.objects.filter({{ _ns_p.model }}=_primary_obj) if _primary_obj else {{ section.primary_model }}.objects.none()
        context['{{ section.primary_model }}_list'] = _apply_section_query(_qs_{{ section.name }}, {{ section.query_literal }}, _primary_obj)
        {% elif section.primary_model in _ns_p.section.parent_models -%}
        _qs_{{ section.name }} = {{ section.primary_model }}.objects.filter(id=getattr(_primary_obj, '{{ section.primary_model }}_id', None)) if _primary_obj else {{ section.primary_model }}.objects.none()
        context['{{ section.primary_model }}_list'] = _apply_section_query(_qs_{{ section.name }}, {{ section.query_literal }}, _primary_obj)
        {% else -%}
        {% if section.primary_model != _ns_p.model -%}
        _qs_{{ section.name }} = {{ section.primary_model }}.objects.all()
        context['{{ section.primary_model }}_list'] = _apply_section_query(_qs_{{ section.name }}, {{ section.query_literal }}, _primary_obj)
        {% endif -%}
        {% endif -%}
        {% endif -%}
        {% endfor -%}
        {% else -%}
        {% for primary_model in models_on_pages[page]['primary_models'][1:] -%}
        context['{{ primary_model }}_list'] = {{ primary_model }}.objects.all()
        {% endfor -%}
        {% endif -%}
        {% endif %}
        {% for section in page.section_components -%}
        {% if section.related_to_section_id -%}
        {% set _src_sections = page.section_components | selectattr('id', 'equalto', section.related_to_section_id) | list -%}
        {% if _src_sections -%}
        {% set _src = _src_sections[0] -%}
        {% set _ns = namespace(fk_field=None, same_model=False) -%}
        {% if section.relation_field -%}
        {% set _ns.fk_field = section.relation_field -%}
        {% set _ns.same_model = (section.primary_model == _src.primary_model) -%}
        {% elif section.primary_model == _src.primary_model -%}
        {% for pm in section.parent_models -%}{% if pm in _src.parent_models and not _ns.fk_field -%}{% set _ns.fk_field = pm %}{% set _ns.same_model = true %}{% endif -%}{% endfor -%}
        {% elif _src.primary_model in section.parent_models -%}
        {% set _ns.fk_field = _src.primary_model -%}
        {% endif -%}
        {% if _ns.fk_field -%}
        _src_{{ _src.primary_model }} = {{ _src.primary_model }}.objects.filter(id=self.request.GET.get('instance_id_{{ _src.primary_model }}')).first()
        {% if _ns.same_model -%}
        _qs_related_{{ section.name }} = {{ section.primary_model }}.objects.filter({{ _ns.fk_field }}=_src_{{ _src.primary_model }}.{{ _ns.fk_field }}).exclude(id=_src_{{ _src.primary_model }}.id) if _src_{{ _src.primary_model }} and getattr(_src_{{ _src.primary_model }}, '{{ _ns.fk_field }}_id', None) else {{ section.primary_model }}.objects.none()
        {% else -%}
        _qs_related_{{ section.name }} = {{ section.primary_model }}.objects.filter({{ _ns.fk_field }}=_src_{{ _src.primary_model }}) if _src_{{ _src.primary_model }} else {{ section.primary_model }}.objects.none()
        {% endif -%}
        context['related_{{ section.name }}_list'] = _apply_section_query(_qs_related_{{ section.name }}, {{ section.query_literal }}, _src_{{ _src.primary_model }})
        {% endif -%}
        {% endif -%}
        {% endif -%}
        {% endfor -%}
        return context

{% endif -%}
{% endfor -%}


{# Home render view #}
class HomeRenderView(GenericTemplateView):
    {% if authentication_present -%}
    required_roles = ['{{ application_name }}']
    {% endif -%}
    template_name = '{{ application_name }}_home.html'

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        context['user'] = self.request.user
        context['active_process_nodes'] = ActiveProcessNode.objects.filter(
            user=self.request.user,
            active_process__completed=False,
        )
        context['available_processes'] = Process.get_available_processes(self.request.user)
        return context
