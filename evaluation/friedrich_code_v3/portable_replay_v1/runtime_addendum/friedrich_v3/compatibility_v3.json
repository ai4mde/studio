    "review": "inspection", "check": "inspection", "inspect": "inspection", "examine": "inspection", "verify": "inspection",
    "repeat": "repetition", "retry": "repetition",
    "update": "modification", "edit": "modification", "modify": "modification", "revise": "modification",
    "inform": "notification", "notify": "notification",
    "determine": "determination", "decide": "determination", "select": "determination", "choose": "determination",
    "connect": "connection", "connects": "connection", "link": "connection", "links": "connection",
    "conduct": "execution", "conducts": "execution", "perform": "execution",
