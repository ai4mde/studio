                "derived": true,
                "body": "def return_result(self):\n    import re\n    from datetime import date\n    from django.core.exceptions import ObjectDoesNotExist\n    from django.utils import timezone\n    def parsed(value):\n        value = str(value or '').strip()\n        if not re.fullmatch(r'[0-9]{4}-[0-9]{2}-[0-9]{2}', value):\n            raise ValueError('Invalid date')\n        return date.fromisoformat(value)\n    try:\n        start, due = parsed(self.Loan.loan_date), parsed(self.Loan.due_date)\n        if due < start or start > timezone.localdate():\n            return 'Data error'\n        if not str(self.return_date or '').strip():\n            return 'Not returned'\n        returned = parsed(self.return_date)\n        if returned < start or returned > timezone.localdate():\n            return 'Data error'\n        days = (returned - due).days\n        return 'Returned on time' if days <= 0 else f\"Returned {days} {'day' if days == 1 else 'days'} late\"\n    except (ValueError, TypeError, ObjectDoesNotExist):\n        return 'Data error' ",
